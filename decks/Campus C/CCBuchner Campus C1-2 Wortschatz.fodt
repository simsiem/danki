    <text:p text:style-name="P37" loext:marker-style-name="T222"><text:span text:style-name="T222">-ne <text:s text:c="3"/></text:span><text:span text:style-name="T223">Partikel im dir. Fragesatz (unübersetzt)</text:span><text:span text:style-name="T224">13</text:span></text:p>
