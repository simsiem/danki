    <text:p text:style-name="P25" loext:marker-style-name="T37"><text:span text:style-name="T46">narr</text:span><text:span text:style-name="T47">ā</text:span><text:span text:style-name="T46">re, narr</text:span><text:span text:style-name="T47">ō</text:span><text:span text:style-name="T40"> <text:s text:c="3"/>erzählen</text:span><text:span text:style-name="T37">14</text:span></text:p>
    <text:p text:style-name="P25" loext:marker-style-name="T37"><text:span text:style-name="T32">neque ... neque</text:span><text:span text:style-name="T33"> <text:s text:c="3"/></text:span><text:span text:style-name="T40">weder ... noch</text:span><text:span text:style-name="T37">3</text:span></text:p>
    <text:p text:style-name="P25" loext:marker-style-name="T37"><text:span text:style-name="T32">nihil</text:span><text:span text:style-name="T33"> <text:s/></text:span><text:span text:style-name="T40"><text:s text:c="2"/>nichts</text:span><text:span text:style-name="T37">10</text:span></text:p>
    <text:p text:style-name="P25" loext:marker-style-name="T37"><text:span text:style-name="T46">n</text:span><text:span text:style-name="T47">ō</text:span><text:span text:style-name="T46">b</text:span><text:span text:style-name="T47">ī</text:span><text:span text:style-name="T46">s</text:span><text:span text:style-name="T40"> </text:span><text:span text:style-name="T39">Dat. <text:s text:c="3"/></text:span><text:span text:style-name="T40">uns</text:span><text:span text:style-name="T37">13</text:span></text:p>
    <text:p text:style-name="P25" loext:marker-style-name="T40"><text:span text:style-name="T32">n</text:span><text:span text:style-name="T38">ō</text:span><text:span text:style-name="T32">n</text:span><text:span text:style-name="T40"> <text:s text:c="3"/>nicht</text:span><text:span text:style-name="T37">2</text:span><text:span text:style-name="T40"> </text:span></text:p>
    <text:p text:style-name="P25" loext:marker-style-name="T40"><text:span text:style-name="T46">n</text:span><text:span text:style-name="T47">ō</text:span><text:span text:style-name="T46">nne?</text:span><text:span text:style-name="T40"> <text:s text:c="3"/>(etwa) nicht?</text:span><text:span text:style-name="T37">17</text:span><text:span text:style-name="T40"> </text:span></text:p>
    <text:p text:style-name="P25" loext:marker-style-name="T37"><text:span text:style-name="T46">nunc</text:span><text:span text:style-name="T40"> </text:span><text:span text:style-name="T39">Adv. <text:s text:c="3"/></text:span><text:span text:style-name="T40">nun, jetzt</text:span><text:span text:style-name="T37">2</text:span></text:p>
    <text:p text:style-name="P25" loext:marker-style-name="T37"><text:span text:style-name="T32">noster, nostra, nostrum</text:span><text:span text:style-name="T33"> <text:s text:c="3"/></text:span><text:span text:style-name="T40">unser</text:span><text:span text:style-name="T37">15</text:span></text:p>
    <text:p text:style-name="P25" loext:marker-style-name="T37"><text:span text:style-name="T46">occidere, occid</text:span><text:span text:style-name="T47">ō</text:span><text:span text:style-name="T46">, occid</text:span><text:span text:style-name="T47">ī</text:span><text:span text:style-name="T40"> <text:s text:c="3"/>(zu Boden) fallen, umkommen, untergehen</text:span><text:span text:style-name="T37">28</text:span></text:p>
    <text:p text:style-name="P25" loext:marker-style-name="T40"><text:span text:style-name="T32">omnis, e</text:span><text:span text:style-name="T40"> <text:s text:c="3"/>jeder, ganz; </text:span><text:span text:style-name="T39">Pl. </text:span><text:span text:style-name="T40">alle</text:span><text:span text:style-name="T37">33</text:span><text:span text:style-name="T40"> </text:span></text:p>
    <text:p text:style-name="P25" loext:marker-style-name="T37"><text:span text:style-name="T32">oportet</text:span><text:span text:style-name="T33"> <text:s text:c="2"/></text:span><text:span text:style-name="T40"><text:s/>es gehört sich, es ist nötig</text:span><text:span text:style-name="T37">30</text:span></text:p>
    <text:p text:style-name="P25" loext:marker-style-name="T40"><text:span text:style-name="T32">pater, patris</text:span><text:span text:style-name="T33"> </text:span><text:span text:style-name="T39">m <text:s text:c="3"/></text:span><text:span text:style-name="T40">der Vater</text:span><text:span text:style-name="T37">20</text:span><text:span text:style-name="T40"> </text:span></text:p>
    <text:p text:style-name="P25" loext:marker-style-name="T37"><text:span text:style-name="T46">paul</text:span><text:span text:style-name="T47">ā</text:span><text:span text:style-name="T46">tim</text:span><text:span text:style-name="T40"> </text:span><text:span text:style-name="T39">Adv. <text:s text:c="3"/></text:span><text:span text:style-name="T40">allmählich</text:span><text:span text:style-name="T37">29</text:span></text:p>
    <text:p text:style-name="P25" loext:marker-style-name="T37"><text:span text:style-name="T32">petere, pet</text:span><text:span text:style-name="T38">ō</text:span><text:span text:style-name="T32">, pet</text:span><text:span text:style-name="T38">ī</text:span><text:span text:style-name="T32">v</text:span><text:span text:style-name="T38">ī</text:span><text:span text:style-name="T33"> <text:s text:c="3"/></text:span><text:span text:style-name="T40">aufsuchen, (er)streben, bitten, verlangen; angreifen</text:span><text:span text:style-name="T37">18.29</text:span></text:p>
    <text:p text:style-name="P26" loext:marker-style-name="T137"><text:span text:style-name="T56">Philippus</text:span><text:span text:style-name="T43"> <text:s text:c="3"/>Philipp II. (um 382-336 v.Chr.; Vater Alexanders des Großen)</text:span><text:span text:style-name="T44">38</text:span><text:span text:style-name="T46"> </text:span></text:p>
    <text:p text:style-name="P25" loext:marker-style-name="T40"><text:span text:style-name="T46">piet</text:span><text:span text:style-name="T47">ā</text:span><text:span text:style-name="T46">s, piet</text:span><text:span text:style-name="T47">ā</text:span><text:span text:style-name="T46">tis</text:span><text:span text:style-name="T40"> </text:span><text:span text:style-name="T39">f <text:s text:c="3"/></text:span><text:span text:style-name="T40">das Pflichtgefühl, die Frömmigkeit</text:span><text:span text:style-name="T37">20</text:span><text:span text:style-name="T40"> </text:span></text:p>
    <text:p text:style-name="P25" loext:marker-style-name="T37"><text:span text:style-name="T32">posse, possum, potu</text:span><text:span text:style-name="T38">ī</text:span><text:span text:style-name="T33"> <text:s text:c="3"/></text:span><text:span text:style-name="T40">können</text:span><text:span text:style-name="T37">17.25</text:span></text:p>
    <text:p text:style-name="P25" loext:marker-style-name="T40"><text:span text:style-name="T32">postquam</text:span><text:span text:style-name="T40"> </text:span><text:span text:style-name="T39">Subj. m. Perf. <text:s text:c="4"/></text:span><text:span text:style-name="T40">nachdem, als</text:span><text:span text:style-name="T37">33</text:span><text:span text:style-name="T40"> </text:span></text:p>
    <text:p text:style-name="P25" loext:marker-style-name="T37"><text:span text:style-name="T46">profect</text:span><text:span text:style-name="T47">ō</text:span><text:span text:style-name="T40"> </text:span><text:span text:style-name="T39">Adv. <text:s text:c="3"/></text:span><text:span text:style-name="T40">sicherlich, tatsächlich</text:span><text:span text:style-name="T37">6</text:span></text:p>
    <text:p text:style-name="P25" loext:marker-style-name="T37"><text:span text:style-name="T46">qu</text:span><text:span text:style-name="T47">ī</text:span><text:span text:style-name="T46">, quae, quod</text:span><text:span text:style-name="T40"> <text:s text:c="3"/>der, die, das</text:span><text:span text:style-name="T37">34</text:span></text:p>
    <text:p text:style-name="P25" loext:marker-style-name="T37"><text:span text:style-name="T32">quid?</text:span><text:span text:style-name="T33"> <text:s text:c="3"/></text:span><text:span text:style-name="T40">was?</text:span><text:span text:style-name="T37">2</text:span></text:p>
    <text:p text:style-name="P25" loext:marker-style-name="T37"><text:span text:style-name="T32">red</text:span><text:span text:style-name="T38">ī</text:span><text:span text:style-name="T32">re, rede</text:span><text:span text:style-name="T38">ō</text:span><text:span text:style-name="T32">, redi</text:span><text:span text:style-name="T38">ī</text:span><text:span text:style-name="T33"> <text:s text:c="3"/></text:span><text:span text:style-name="T40">zurückgehen, zurückkehren</text:span><text:span text:style-name="T37">37</text:span></text:p>
    <text:p text:style-name="P25" loext:marker-style-name="T46"><text:span text:style-name="T46">retinere <text:s text:c="3"/></text:span><text:span text:style-name="T40">vgl. V a</text:span><text:span text:style-name="T138">0</text:span></text:p>
    <text:p text:style-name="P25" loext:marker-style-name="T40"><text:span text:style-name="T32">r</text:span><text:span text:style-name="T38">ē</text:span><text:span text:style-name="T32">x, r</text:span><text:span text:style-name="T38">ē</text:span><text:span text:style-name="T32">gis</text:span><text:span text:style-name="T33"> </text:span><text:span text:style-name="T39">m <text:s text:c="3"/></text:span><text:span text:style-name="T40">der König</text:span><text:span text:style-name="T37">27</text:span><text:span text:style-name="T40"> </text:span></text:p>
    <text:p text:style-name="P25" loext:marker-style-name="T40"><text:span text:style-name="T32">saepe</text:span><text:span text:style-name="T33"> </text:span><text:span text:style-name="T39">Adv. <text:s text:c="3"/></text:span><text:span text:style-name="T40">oft</text:span><text:span text:style-name="T37">4</text:span><text:span text:style-name="T40"> </text:span></text:p>
    <text:p text:style-name="P25" loext:marker-style-name="T40"><text:span text:style-name="T46">saevus, a, um</text:span><text:span text:style-name="T40"> <text:s text:c="3"/>schrecklich, wild, wütend</text:span><text:span text:style-name="T37">38</text:span><text:span text:style-name="T40"> </text:span></text:p>
    <text:p text:style-name="P25" loext:marker-style-name="T139"><text:span text:style-name="T46">sānitās, ātis </text:span><text:span text:style-name="T39">f</text:span><text:span text:style-name="T66"> <text:s text:c="3"/></text:span><text:span text:style-name="T40">die Besinnung, die Vernunft</text:span><text:span text:style-name="T37">0</text:span></text:p>
    <text:p text:style-name="P25" loext:marker-style-name="T37"><text:span text:style-name="T140">sapi</text:span><text:span text:style-name="T141">ē</text:span><text:span text:style-name="T140">ns, sapientis</text:span><text:span text:style-name="T40"> <text:s text:c="3"/>klug, weise</text:span><text:span text:style-name="T37">38</text:span></text:p>
    <text:p text:style-name="P25" loext:marker-style-name="T40"><text:span text:style-name="T46">s</text:span><text:span text:style-name="T47">ē</text:span><text:span text:style-name="T46"> </text:span><text:span text:style-name="T39">Akk. / Abl. <text:s text:c="3"/></text:span><text:span text:style-name="T40">sich</text:span><text:span text:style-name="T37">19</text:span><text:span text:style-name="T40"> </text:span></text:p>
    <text:p text:style-name="P25" loext:marker-style-name="T40"><text:span text:style-name="T32">sed </text:span><text:span text:style-name="T33"><text:s/></text:span><text:span text:style-name="T40"><text:s text:c="2"/>aber, sondern</text:span><text:span text:style-name="T37">3</text:span><text:span text:style-name="T40"> </text:span></text:p>
    <text:p text:style-name="P25" loext:marker-style-name="T37"><text:span text:style-name="T32">semper</text:span><text:span text:style-name="T60"> </text:span><text:span text:style-name="T39">Adv. <text:s text:c="3"/></text:span><text:span text:style-name="T40">immer</text:span><text:span text:style-name="T37">4</text:span></text:p>
    <text:p text:style-name="P25" loext:marker-style-name="T40"><text:span text:style-name="T32">sine</text:span><text:span text:style-name="T40"> </text:span><text:span text:style-name="T39">Präp. m. Abl. <text:s text:c="3"/></text:span><text:span text:style-name="T40">ohne</text:span><text:span text:style-name="T37">12</text:span><text:span text:style-name="T40"> </text:span></text:p>
    <text:p text:style-name="P25" loext:marker-style-name="T40"><text:span text:style-name="T46">statim</text:span><text:span text:style-name="T40"> </text:span><text:span text:style-name="T39">Adv. <text:s text:c="3"/></text:span><text:span text:style-name="T40">sofort</text:span><text:span text:style-name="T37">5</text:span><text:span text:style-name="T40"> </text:span></text:p>
    <text:p text:style-name="P25" loext:marker-style-name="T37"><text:span text:style-name="T46">superbia</text:span><text:span text:style-name="T40"> <text:s text:c="3"/>der Stolz, der Hochmut</text:span><text:span text:style-name="T37">9</text:span></text:p>
    <text:p text:style-name="P25" loext:marker-style-name="T37"><text:span text:style-name="T46">surgere, surg</text:span><text:span text:style-name="T47">ō</text:span><text:span text:style-name="T46">, surr</text:span><text:span text:style-name="T47">ē</text:span><text:span text:style-name="T46">x</text:span><text:span text:style-name="T47">ī</text:span><text:span text:style-name="T40"> <text:s text:c="3"/>aufrichten; sich erheben, aufstehen</text:span><text:span text:style-name="T37">23.31</text:span></text:p>
    <text:p text:style-name="P25" loext:marker-style-name="T37"><text:span text:style-name="T46">terr</text:span><text:span text:style-name="T47">ē</text:span><text:span text:style-name="T46">re, terre</text:span><text:span text:style-name="T47">ō</text:span><text:span text:style-name="T46">, terru</text:span><text:span text:style-name="T47">ī</text:span><text:span text:style-name="T40"> <text:s text:c="3"/>erschrecken</text:span><text:span text:style-name="T37">5</text:span></text:p>
    <text:p text:style-name="P25" loext:marker-style-name="T40"><text:span text:style-name="T46">timor, tim</text:span><text:span text:style-name="T47">ō</text:span><text:span text:style-name="T46">ris</text:span><text:span text:style-name="T40"> </text:span><text:span text:style-name="T39">m <text:s text:c="3"/></text:span><text:span text:style-name="T40">die Angst, die Furcht</text:span><text:span text:style-name="T37">25</text:span><text:span text:style-name="T40"> </text:span></text:p>
    <text:p text:style-name="P25" loext:marker-style-name="T40"><text:span text:style-name="T32">tuus, a, um</text:span><text:span text:style-name="T33"> <text:s text:c="3"/></text:span><text:span text:style-name="T40">dein</text:span><text:span text:style-name="T37">14</text:span><text:span text:style-name="T40"> </text:span></text:p>
    <text:p text:style-name="P25" loext:marker-style-name="T37"><text:span text:style-name="T32">verbum</text:span><text:span text:style-name="T33"> </text:span><text:span text:style-name="T40"><text:s text:c="3"/>das Wort, die Äußerung</text:span><text:span text:style-name="T37">11</text:span></text:p>
    <text:p text:style-name="P25" loext:marker-style-name="T37"><text:span text:style-name="T32">vetus, veteris</text:span><text:span text:style-name="T33"> <text:s text:c="3"/></text:span><text:span text:style-name="T40">alt</text:span><text:span text:style-name="T37">38</text:span></text:p>
    <text:p text:style-name="P25" loext:marker-style-name="T37"><text:span text:style-name="T46">viol</text:span><text:span text:style-name="T47">ā</text:span><text:span text:style-name="T46">re, viol</text:span><text:span text:style-name="T47">ō</text:span><text:span text:style-name="T40"> <text:s text:c="3"/>verwunden, verletzen, entehren</text:span><text:span text:style-name="T37">31</text:span></text:p>
    <text:p text:style-name="P25" loext:marker-style-name="T40"><text:soft-page-break/><text:span text:style-name="T32">virt</text:span><text:span text:style-name="T38">ū</text:span><text:span text:style-name="T32">s, virt</text:span><text:span text:style-name="T38">ū</text:span><text:span text:style-name="T32">tis</text:span><text:span text:style-name="T33"> </text:span><text:span text:style-name="T39">f <text:s text:c="3"/></text:span><text:span text:style-name="T40">die Tapferkeit, die Tüchtigkeit, die Leistung; die Tugend</text:span><text:span text:style-name="T37">22</text:span><text:span text:style-name="T40"> </text:span></text:p>
