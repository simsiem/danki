   <text:section text:style-name="Sect3" text:name="Bereich94">
    <text:p text:style-name="P37" loext:marker-style-name="T18"><text:span text:style-name="T24">deus, deī</text:span><text:span text:style-name="T18"> </text:span><text:span text:style-name="T90">m</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>der Gott, die Gottheit</text:span><text:span text:style-name="T21">6</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T18">dolus, dolī</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">m <text:s text:c="3"/></text:span><text:span text:style-name="T26">die List, die Täuschung</text:span><text:span text:style-name="T21">9</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T18"><text:span text:style-name="T24">enim</text:span><text:span text:style-name="T18"> </text:span><text:span text:style-name="T90">(nachgestellt)</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>nämlich, denn</text:span><text:span text:style-name="T21">18</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T18">fallere, fallō, fefellī</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>täuschen, betrügen</text:span><text:span text:style-name="T21">40</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T23"><text:span text:style-name="T180">gravis, grave</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>schwer</text:span><text:span text:style-name="T21">54</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T18"><text:span text:style-name="T179">īra, īrae</text:span><text:span text:style-name="T18"> </text:span><text:span text:style-name="T90">f</text:span><text:span text:style-name="T18"> <text:s text:c="3"/></text:span><text:span text:style-name="T26">der Zorn, die Wut</text:span><text:span text:style-name="T21">46</text:span><text:span text:style-name="T18"> </text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T18">labōrāre, labōrō, labōrāvī, labōrātum</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>arbeiten, sich anstrengen</text:span><text:span text:style-name="T21">8</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">movēre, moveō, mōvī, mōtum</text:span><text:span text:style-name="T18"> <text:s text:c="3"/></text:span><text:span text:style-name="T26">bewegen, beeindrucken</text:span><text:span text:style-name="T21">7. 27</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T18">Plūtō, Plūtōnis <text:s/></text:span><text:span text:style-name="T90">m</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>Pluto (griech. Hades; Gott der Unterwelt.)</text:span><text:span text:style-name="T21">28.XIX</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T18"><text:span text:style-name="T180">poena, poenae</text:span><text:span text:style-name="T18"> </text:span><text:span text:style-name="T90">f </text:span><text:span text:style-name="T18"><text:s text:c="3"/></text:span><text:span text:style-name="T26">die Strafe</text:span><text:span text:style-name="T21">46</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T18"><text:span text:style-name="T24">semper</text:span><text:span text:style-name="T18"> </text:span><text:span text:style-name="T90">Adv</text:span><text:span text:style-name="T26">. <text:s text:c="3"/>immer</text:span><text:span text:style-name="T21">4</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T16">Sīsyphus, Sīsyphī</text:span><text:span text:style-name="T90"> m</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>Sisyphus (Gründer und König von Korinth. Wegen seiner Freveltaten muss er im Tartarus auf ewig büßen.)</text:span><text:span text:style-name="T21">58</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T180">solvere, solvō, solvī, solūtum</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>lösen, auflösen; bezahlen</text:span><text:span text:style-name="T21">55</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T179">vindicāre, vindicō, vindicāvī, vindicātum</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>beanspruchen, bestrafen; </text:span><text:span text:style-name="T18">in</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">m. Akk</text:span><text:span text:style-name="T26">. vorgehen gegen</text:span><text:span text:style-name="T21">56</text:span></text:p>
   </text:section>
   <text:section text:style-name="Sect2" text:name="Bereich95">
    <text:p text:style-name="P34"/>
