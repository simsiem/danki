    <text:p text:style-name="P26" loext:marker-style-name="T43"><text:span text:style-name="T56">anteā</text:span><text:span text:style-name="T43"> Adv. <text:s text:c="3"/>vorher, früher</text:span><text:span text:style-name="T44">24</text:span><text:span text:style-name="T43"> </text:span></text:p>
