    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T18">auctor, auctōris</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">m</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>der Anführer, der Gründer, der Schriftsteller, der Verfasser</text:span><text:span text:style-name="T21">39</text:span></text:p>
