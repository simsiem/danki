   </text:section>
   <text:section text:style-name="Sect3" text:name="Bereich68">
    <text:p text:style-name="P37" loext:marker-style-name="T18"><text:span text:style-name="T24">ad</text:span><text:span text:style-name="T18"> </text:span><text:span text:style-name="T90">Präp. m. Akk.</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>zu, bei, nach, an</text:span><text:span text:style-name="T21">12</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">adhūc</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">Adv</text:span><text:span text:style-name="T26">. <text:s text:c="3"/>bis jetzt, noch</text:span><text:span text:style-name="T21">3</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">agere, agō, ēgī, actum</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>handeln, treiben, verhandeln</text:span><text:span text:style-name="T21">27</text:span><text:span text:style-name="T26"> </text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">arma, armōrum</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">n Pl.</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>das Gerät, die Waffen</text:span><text:span text:style-name="T21">26</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T18"><text:span text:style-name="T24">autem</text:span><text:span text:style-name="T18"> </text:span><text:span text:style-name="T90">(nachgestellt)</text:span><text:span text:style-name="T18"> <text:s text:c="3"/></text:span><text:span text:style-name="T26">aber, andererseits</text:span><text:span text:style-name="T21">15</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T26">(C. Iūlius) </text:span><text:span text:style-name="T18">Caesar, Caesaris</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">m</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>Gajus Julius Cäsar (100–44 v. Chr., röm. Politiker, Feldherr und Schriftsteller</text:span><text:span text:style-name="T21">I. 27. 35. 51</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T18">concēdere, concēdō, concessī, concessum</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>erlauben, nachgeben, zugestehen</text:span><text:span text:style-name="T21">36</text:span><text:span text:style-name="T26"> </text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T24"><text:span text:style-name="T24">cōnsistere, cōnsistō, cōnstitī <text:s text:c="3"/></text:span><text:span text:style-name="T26">stehenbleiben, haltmachen, sich aufstellen</text:span><text:span text:style-name="T21">17. 29</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T21"><text:span text:style-name="T18">cōnsultum, cōnsultī </text:span><text:span text:style-name="T90">n <text:s text:c="3"/></text:span><text:span text:style-name="T26">der Beschluss</text:span><text:span text:style-name="T21">0</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T18">convocāre, convocō, convocāvī, convocātum</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>zusammenrufen, versammeln</text:span><text:span text:style-name="T21">38</text:span><text:span text:style-name="T26"> </text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">cum</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">Präp. m. Abl</text:span><text:span text:style-name="T26">. <text:s text:c="3"/>mit, zusammen mit</text:span><text:span text:style-name="T21">12</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">dare, dō, dedī, datum</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>geben</text:span><text:span text:style-name="T21">20. 28. 47</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">dēbēre, dēbeō, dēbuī</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>müssen, sollen, schulden</text:span><text:span text:style-name="T21">2</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">deus, deī</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">m</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>der Gott, die Gottheit</text:span><text:span text:style-name="T21">6</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">diū</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">Adv</text:span><text:span text:style-name="T26">. <text:s text:c="3"/>lange (Zeit)</text:span><text:span text:style-name="T21">7</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">dīcere, dīcō, dīxī, dictum <text:s text:c="2"/></text:span><text:span text:style-name="T26"><text:s/>sagen, sprechen</text:span><text:span text:style-name="T21">16. 27</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">dubitāre, dubitō, dubitāvī, dubitātum</text:span><text:span text:style-name="T18"> <text:s text:c="2"/></text:span><text:span text:style-name="T26"><text:s/>zweifeln; zögern </text:span><text:span text:style-name="T90">m. Inf.</text:span><text:span text:style-name="T21">9</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">ē / ex</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">Präp. m. Abl.</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>aus, von ... her</text:span><text:span text:style-name="T21">12</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T18"><text:span text:style-name="T24">esse, sum, fuī</text:span><text:span text:style-name="T18"> <text:s text:c="3"/></text:span><text:span text:style-name="T26">sein, sich befinden</text:span><text:span text:style-name="T21">2. 25</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T18"><text:span text:style-name="T24">et</text:span><text:span text:style-name="T18"> <text:s text:c="3"/></text:span><text:span text:style-name="T26">und, auch</text:span><text:span text:style-name="T21">1</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T173"><text:span text:style-name="T197">exercitus, exercitūs</text:span><text:span text:style-name="T173"> </text:span><text:span text:style-name="T176">m</text:span><text:span text:style-name="T173"> <text:s text:c="3"/>das Heer</text:span><text:span text:style-name="T181">52</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T173"><text:span text:style-name="T182">exspectāre, exspectō, exspectāvī, exspectātum</text:span><text:span text:style-name="T173"> <text:s text:c="3"/>warten (auf), erwarten</text:span><text:span text:style-name="T181">10</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">fīnis, fīnis</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">m</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">(Gen. Pl.</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T24">-ium</text:span><text:span text:style-name="T90">)</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>das Ende, die Grenze, das Ziel, der Zweck; Pl. das Gebiet</text:span><text:span text:style-name="T21">30</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T18">fluvius,</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T18">fluviī</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">m</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>der Fluss</text:span><text:span text:style-name="T21">6</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T18">frangere, frangō, frēgī, fractum</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>zerbrechen (trans.)</text:span><text:span text:style-name="T21">41</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T16">gemitus, gemitūs</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">m</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>das Seufzen, die Traurigkeit</text:span><text:span text:style-name="T21">52</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">hic, haec, hoc</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>dieser, diese, dieses (hier); folgender</text:span><text:span text:style-name="T21">40</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T21"><text:span text:style-name="T18">iacta alea est</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>der Würfel ist geworfen</text:span><text:span text:style-name="T21">0</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T18"><text:span text:style-name="T182">iam</text:span><text:span text:style-name="T174"> </text:span><text:span text:style-name="T176">Adv.</text:span><text:span text:style-name="T173"> <text:s text:c="3"/></text:span><text:span text:style-name="T26">schon, bereits; nun</text:span><text:span text:style-name="T21">4</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T173"><text:span text:style-name="T197">igitur</text:span><text:span text:style-name="T173"> </text:span><text:span text:style-name="T176">Adv</text:span><text:span text:style-name="T173">. <text:s text:c="3"/>also, folglich</text:span><text:span text:style-name="T181">52</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T18">īgnōtus, īgnōta, īgnōtum</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>unbekannt</text:span><text:span text:style-name="T21">45</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">ille, illa, illud</text:span><text:span text:style-name="T18"> <text:s text:c="3"/></text:span><text:span text:style-name="T26">jener, jene, jenes; der (dort); jener berühmte</text:span><text:span text:style-name="T21">40</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">in</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">Präp. m. Akk</text:span><text:span text:style-name="T26">. <text:s text:c="3"/>in (... hinein), nach (wohin?)</text:span><text:span text:style-name="T21">12</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">īre, eō, iī, itum</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>gehen</text:span><text:span text:style-name="T21">37</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T23"><text:span text:style-name="T18">Italia, Italiae</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">f</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>Italien</text:span><text:span text:style-name="T21">31. 43-45. 51</text:span><text:span text:style-name="T23"> </text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T16">laetus, laeta, laetum</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>froh; fruchtbar</text:span><text:span text:style-name="T21">52</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T167"><text:span text:style-name="T24">magnus, magna, magnum</text:span><text:span text:style-name="T18"> <text:s text:c="3"/></text:span><text:span text:style-name="T26">groß, bedeutend</text:span><text:span text:style-name="T21">14</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T30">manus, manūs</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">f</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>die Hand; die Schar (von Bewaffneten)</text:span><text:span text:style-name="T21">52</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T30">metus, metūs</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">m</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>die Angst</text:span><text:span text:style-name="T21">52</text:span><text:span text:style-name="T26"> </text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">mīles, mīlitis</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">m</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>der Soldat</text:span><text:span text:style-name="T21">32</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T21"><text:span text:style-name="T24">nē</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">Subj. m. Konj</text:span><text:span text:style-name="T26">. <text:s text:c="3"/>dass nicht</text:span><text:span text:style-name="T21">45</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T18">perīculum est, nē</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>es besteht die Gefahr, dass</text:span><text:span text:style-name="T21">45</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">nihil</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>nichts</text:span><text:span text:style-name="T21">10</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T18"><text:span text:style-name="T24">nōs</text:span><text:span text:style-name="T18"> </text:span><text:span text:style-name="T90">Nom. / Akk.</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>wir / uns</text:span><text:span text:style-name="T21">13</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T167"><text:span text:style-name="T24">novus, nova, novum</text:span><text:span text:style-name="T18"> <text:s text:c="3"/></text:span><text:span text:style-name="T26">neu, ungewöhnlich</text:span><text:span text:style-name="T21">14</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">nunc</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">Adv</text:span><text:span text:style-name="T26">. <text:s text:c="3"/>nun, jetzt</text:span><text:span text:style-name="T21">2</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T18"><text:span text:style-name="T24">omnis, omne</text:span><text:span text:style-name="T18"> <text:s text:c="3"/></text:span><text:span text:style-name="T26">jeder, ganz; </text:span><text:span text:style-name="T90">Pl</text:span><text:span text:style-name="T26">. alle</text:span><text:span text:style-name="T21">33</text:span><text:span text:style-name="T18"> </text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">parvus, parva, parvum</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>klein, gering</text:span><text:span text:style-name="T21">14</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">per</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">Präp. m. Akk</text:span><text:span text:style-name="T26">. <text:s text:c="3"/>durch, hindurch</text:span><text:span text:style-name="T21">16</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">perīculum, perīculī</text:span><text:span text:style-name="T18"> </text:span><text:span text:style-name="T90">n</text:span><text:span text:style-name="T18"> <text:s text:c="3"/></text:span><text:span text:style-name="T26">die Gefahr</text:span><text:span text:style-name="T21">24</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T175">pertinēre, pertineō</text:span><text:span text:style-name="T198"> </text:span><text:span text:style-name="T175">ad</text:span><text:span text:style-name="T173"> </text:span><text:span text:style-name="T176">m. Akk</text:span><text:span text:style-name="T173">. <text:s text:c="3"/></text:span><text:span text:style-name="T26">betreffen, gehören (zu), sich erstrecken (bis)</text:span><text:span text:style-name="T21">52</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T26">(Gnaeus) </text:span><text:span text:style-name="T18">Pompeius</text:span><text:span text:style-name="T26"> (Magnus) <text:s text:c="3"/>Pompejus (106-48 v. Chr., einflussreicher Politiker und Feldherr)</text:span><text:span text:style-name="T21">52</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T18">pōns, pontis</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">m (Gen. Pl.</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T18">-ium</text:span><text:span text:style-name="T90">)</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>die Brücke</text:span><text:span text:style-name="T21">40</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T16">portus, portūs</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">m</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>der Hafen</text:span><text:span text:style-name="T21">52</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T18"><text:span text:style-name="T24">posse, possum, potuī</text:span><text:span text:style-name="T18"> <text:s text:c="3"/></text:span><text:span text:style-name="T26">können</text:span><text:span text:style-name="T21">17. 25</text:span><text:span text:style-name="T18"> </text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T18">properāre, properō, properāvī, properātum</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>eilen, sich beeilen</text:span><text:span text:style-name="T21">8</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T173"><text:span text:style-name="T182">prōvincia, prōvinciae</text:span><text:span text:style-name="T173"> </text:span><text:span text:style-name="T176">f</text:span><text:span text:style-name="T173"> <text:s text:c="3"/>die Provinz</text:span><text:span text:style-name="T181">9</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">quī, quae, quod</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>der, die, das</text:span><text:span text:style-name="T21">34</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">quia</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">Subj.</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>weil</text:span><text:span text:style-name="T21">19</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:soft-page-break/><text:span text:style-name="T24">quō?</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>wo?, wohin?</text:span><text:span text:style-name="T21">37</text:span><text:span text:style-name="T26"> </text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T18">rapere, rapiō, rapuī, raptum</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>wegführen, rauben, wegreißen</text:span><text:span text:style-name="T21">49</text:span><text:span text:style-name="T26"> </text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">redīre, redeō, rediī, reditum</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>zurückgehen, zurückkehren</text:span><text:span text:style-name="T21">37</text:span><text:span text:style-name="T26"> </text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T173"><text:span text:style-name="T174">Rōma, Rōmae</text:span><text:span text:style-name="T173"> </text:span><text:span text:style-name="T176">f</text:span><text:span text:style-name="T173"> <text:s text:c="3"/>Rom</text:span><text:span text:style-name="T181">7</text:span><text:span text:style-name="T173"> </text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T18">Rubico, onis</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">m</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>Rubikon (Grenzfluss zwischen der Provinz Gallien und dem röm. Staatsgebiet; 49 v. Chr. überschritt Cäsar diese Grenze und löste damit den Bürgerkrieg aus.)</text:span><text:span text:style-name="T21">52</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T23"><text:span text:style-name="T18">sē</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">Akk. / Abl</text:span><text:span text:style-name="T26">. <text:s text:c="3"/>sich</text:span><text:span text:style-name="T21">19</text:span><text:span text:style-name="T23"> </text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T18"><text:span text:style-name="T24">sed</text:span><text:span text:style-name="T18"> <text:s text:c="3"/></text:span><text:span text:style-name="T26">aber, sondern</text:span><text:span text:style-name="T21">3</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T30">senātus, senātūs</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">m</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>der Senat, die Senatsversammlung</text:span><text:span text:style-name="T21">52</text:span><text:span text:style-name="T26"> </text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">sī</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">Subj</text:span><text:span text:style-name="T26">. <text:s text:c="3"/>wenn, falls</text:span><text:span text:style-name="T21">19</text:span><text:span text:style-name="T26"> </text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T18">sibi</text:span><text:span text:style-name="T26"> Dat. <text:s text:c="3"/>(für) sich</text:span><text:span text:style-name="T21">30</text:span><text:span text:style-name="T26"> </text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">sīgnum, sīgnī</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">n</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>das Merkmal, das Zeichen; die Statue</text:span><text:span text:style-name="T21">32</text:span><text:span text:style-name="T26"> </text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T18">statim</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">Adv</text:span><text:span text:style-name="T26">. <text:s text:c="3"/>sofort</text:span><text:span text:style-name="T21">5</text:span><text:span text:style-name="T26"> </text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T18">subitō</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">Adv</text:span><text:span text:style-name="T26">. <text:s text:c="3"/>plötzlich</text:span><text:span text:style-name="T21">5</text:span><text:span text:style-name="T26"> </text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">suus, sua, suum</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>sein, ihr</text:span><text:span text:style-name="T21">30</text:span><text:span text:style-name="T26"> </text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T30">tālis, tāle</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>derartig, ein solcher, so (beschaffen)</text:span><text:span text:style-name="T21">52</text:span><text:span text:style-name="T26"> </text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">tandem</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">Adv</text:span><text:span text:style-name="T26">. <text:s text:c="3"/>endlich</text:span><text:span text:style-name="T21">7</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T18">temptāre, temptō, temptāvī, temptātum</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>angreifen; prüfen, versuchen</text:span><text:span text:style-name="T21">26</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">tōtus, tōta, tōtum</text:span><text:span text:style-name="T18"> </text:span><text:span text:style-name="T90">(Gen.</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T24">tōtīus</text:span><text:span text:style-name="T26">, </text:span><text:span text:style-name="T90">Dat.</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T24">tōtī</text:span><text:span text:style-name="T90">)</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>ganz, gesamt</text:span><text:span text:style-name="T21">40</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">trānsīre, trānseō, trānsiī, transitum</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>durchqueren, hinübergehen, überschreiten</text:span><text:span text:style-name="T21">44</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T18">trīstis, trīste</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>traurig, unfreundlich</text:span><text:span text:style-name="T21">33</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">tum</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">Adv</text:span><text:span text:style-name="T26">. <text:s text:c="3"/>da, dann, darauf, damals</text:span><text:span text:style-name="T21">4</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">urbs, urbis</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">f</text:span><text:span text:style-name="T26"> (Gen. Pl. </text:span><text:span text:style-name="T24">-ium</text:span><text:span text:style-name="T90">)</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>die Stadt; die Stadt Rom</text:span><text:span text:style-name="T21">22</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T30">ūsus, ūsūs</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">m</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>der Nutzen, die Benutzung</text:span><text:span text:style-name="T21">52</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T18"><text:span text:style-name="T16">ūsuī esse</text:span><text:span text:style-name="T18"> <text:s text:c="3"/></text:span><text:span text:style-name="T26">von Nutzen sein, nützlich sein</text:span><text:span text:style-name="T21">52</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">verbum, verbī</text:span><text:span text:style-name="T18"> </text:span><text:span text:style-name="T90">n</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>das Wort, die Äußerung</text:span><text:span text:style-name="T21">11</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T18">vertere, vertō, vertī, versum</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>drehen, wenden</text:span><text:span text:style-name="T21">27</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T21"><text:span text:style-name="T24">vidēre, videō, vīdī, vīsum <text:s text:c="2"/></text:span><text:span text:style-name="T26"><text:s/>sehen</text:span><text:span text:style-name="T21">7. 27. 48</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">vir, virī</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">m</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>der Mann</text:span><text:span text:style-name="T21">15</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">vocāre, vocō, vocāvī, vocātum</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>rufen; nennen, benennen</text:span><text:span text:style-name="T21">8</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T30">vultus, vultūs</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">m</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>das Gesicht, der Gesichtsausdruck; Pl. die Gesichtszüge</text:span><text:span text:style-name="T21">52</text:span></text:p>
   </text:section>
   <text:section text:style-name="Sect2" text:name="Bereich69">
    <text:p text:style-name="P51" loext:marker-style-name="T89"/>
