   <text:section text:style-name="Sect3" text:name="Bereich140">
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">ā / ab</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">Präp. m. Abl</text:span><text:span text:style-name="T26">. <text:s text:c="3"/>von, von ... her</text:span><text:span text:style-name="T21">16</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T18"><text:span text:style-name="T18">Āfrica, Āfricae </text:span><text:span text:style-name="T90">f</text:span><text:span text:style-name="T18"> <text:s text:c="3"/></text:span><text:span text:style-name="T26">Afrika (Die Römer verstanden darunter in erster Linie das ihnen bekannte Nordafrika.)</text:span><text:span text:style-name="T21">XVII. 45. 66</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T18">alere, alo, aluī</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>ernähren, großziehen</text:span><text:span text:style-name="T21">42</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">alius, alia, aliud</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>ein anderer</text:span><text:span text:style-name="T21">29</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T18">argentum, argentī </text:span><text:span text:style-name="T90">n</text:span><text:span text:style-name="T18"> <text:s text:c="3"/></text:span><text:span text:style-name="T26">das Silber, das Geld</text:span><text:span text:style-name="T21">45</text:span><text:span text:style-name="T26"> </text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T180">atque / ac</text:span><text:span text:style-name="T24"> <text:s text:c="2"/></text:span><text:span text:style-name="T26"><text:s/>und, und auch</text:span><text:span text:style-name="T21">47</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T21"><text:span text:style-name="T16">aurum, aurī</text:span><text:span text:style-name="T18"> </text:span><text:span text:style-name="T90">n</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>das Gold</text:span><text:span text:style-name="T21">67</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T18"><text:span text:style-name="T24">barbarus, barabra, barbarum</text:span><text:span text:style-name="T18"> <text:s text:c="3"/></text:span><text:span text:style-name="T26">ausländisch, unzivilisiert; </text:span><text:span text:style-name="T90">Subst</text:span><text:span text:style-name="T26">. Barbar</text:span><text:span text:style-name="T21">40</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T71"><text:span text:style-name="T93">civis, civis</text:span><text:span text:style-name="T71"> </text:span><text:span text:style-name="T74">m</text:span><text:span text:style-name="T71"> (</text:span><text:span text:style-name="T74">Gen. Pl</text:span><text:span text:style-name="T71">. </text:span><text:span text:style-name="T93">-ium</text:span><text:span text:style-name="T71">) <text:s text:c="3"/>der Bürger, die Bürgerin</text:span><text:span text:style-name="T79">30</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">cīvitās, cīvitātis</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">f</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>die Gemeinde, der Staat</text:span><text:span text:style-name="T21">20</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T18">cōgitāre, cōgitō, cōgitāvī, cōgitātum <text:s text:c="2"/></text:span><text:span text:style-name="T26"><text:s/>denken, beabsichtigen</text:span><text:span text:style-name="T21">30</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">contendere, contendō, contendī</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>sich anstrengen, kämpfen; eilen; behaupten</text:span><text:span text:style-name="T21">34</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T18"><text:span text:style-name="T18">contrā </text:span><text:span text:style-name="T90">Präp. m. Akk</text:span><text:span text:style-name="T26">. <text:s text:c="3"/>gegen</text:span><text:span text:style-name="T21">38</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T18">convocāre, convocō, convocāvī, convocātum</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>zusammenrufen, versammeln</text:span><text:span text:style-name="T21">38</text:span><text:span text:style-name="T26"> </text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T18"><text:span text:style-name="T18">corripere, corripiō, corripuī, correptum <text:s text:c="3"/></text:span><text:span text:style-name="T26">ergreifen, gewaltsam an sich reißen</text:span><text:span text:style-name="T21">66</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T18"><text:span text:style-name="T93">cum</text:span><text:span text:style-name="T18"> </text:span><text:span text:style-name="T90">Subj. m. Konj.</text:span><text:span text:style-name="T18"> </text:span><text:span text:style-name="T26">als, nachdem; weil; obwohl</text:span><text:span text:style-name="T21">61</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T18"><text:span text:style-name="T18">cūnctī, cūnctae, cūncta <text:s text:c="2"/></text:span><text:span text:style-name="T26">alle (zusammen)</text:span><text:span text:style-name="T21">14</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T18"><text:span text:style-name="T24">cūr?</text:span><text:span text:style-name="T18"> <text:s text:c="3"/></text:span><text:span text:style-name="T26">warum?</text:span><text:span text:style-name="T21">2</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T180">dare, dō, dedī, datum</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>geben</text:span><text:span text:style-name="T21">20. 28. 47</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">dēfendere, dēfendō, dēfendī, dēfēnsum</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">(</text:span><text:span text:style-name="T24">ā</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">m. Abl.)</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>abwehren, verteidigen (vor / gegen)</text:span><text:span text:style-name="T21">33</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T18"><text:span text:style-name="T18">deficiant</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T18">dēspērāre, dēspērō, dēspērāvī, dēspērātum <text:s text:c="2"/></text:span><text:span text:style-name="T26"><text:s/>die Hoffnung aufgeben, verzweifeln</text:span><text:span text:style-name="T21">31</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">diēs, diēī</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">m</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>der Tag</text:span><text:span text:style-name="T21">41</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T18"><text:span text:style-name="T24">enim</text:span><text:span text:style-name="T18"> </text:span><text:span text:style-name="T90">(nachgestellt)</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>nämlich, denn</text:span><text:span text:style-name="T21">18</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T171"><text:span text:style-name="T24">ē / ex </text:span><text:span text:style-name="T168">Präp. m. Abl. <text:s text:c="2"/></text:span><text:span text:style-name="T171"><text:s/>aus, von ... her</text:span><text:span text:style-name="T170">12</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">esse, sum, fuī</text:span><text:span text:style-name="T18"> <text:s text:c="3"/></text:span><text:span text:style-name="T26">sein,</text:span><text:span text:style-name="T18"> </text:span><text:span text:style-name="T26">sich befinden</text:span><text:span text:style-name="T21">2. 25</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T18"><text:span text:style-name="T24">et</text:span><text:span text:style-name="T18"> <text:s text:c="3"/></text:span><text:span text:style-name="T26">und, auch</text:span><text:span text:style-name="T21">1</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T173"><text:span text:style-name="T208">exercitus, exercitūs</text:span><text:span text:style-name="T173"> </text:span><text:span text:style-name="T176">m</text:span><text:span text:style-name="T173"> <text:s text:c="3"/>das Heer</text:span><text:span text:style-name="T181">52</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T16">exstinguere, exstinguō, exstīnxī, exstīnctum</text:span><text:span text:style-name="T18"> <text:s text:c="3"/></text:span><text:span text:style-name="T26">auslöschen, vernichten</text:span><text:span text:style-name="T21">67</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">facere, faciō, fēcī, </text:span><text:span text:style-name="T180">factum</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>machen, tun, handeln</text:span><text:span text:style-name="T21">17. 27. 48</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">fīnis, fīnis</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">m (Gen. Pl.</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T24">-ium</text:span><text:span text:style-name="T90">)</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>das Ende, die Grenze, das Ziel, der Zweck; Pl. das Gebiet</text:span><text:span text:style-name="T21">30</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T18">herī</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">Adv</text:span><text:span text:style-name="T26">. <text:s text:c="3"/>gestern</text:span><text:span text:style-name="T21">20</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">hic, haec, hoc</text:span><text:span text:style-name="T18"> <text:s text:c="3"/></text:span><text:span text:style-name="T26">dieser, diese, dieses (hier); folgender</text:span><text:span text:style-name="T21">40</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">hostis, hostis</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">m</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">(Gen. Pl</text:span><text:span text:style-name="T26">. </text:span><text:span text:style-name="T24">-ium</text:span><text:span text:style-name="T90">)</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>der Feind (Landesfeind)</text:span><text:span text:style-name="T21">35</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T18"><text:span text:style-name="T24">iam</text:span><text:span text:style-name="T18"> </text:span><text:span text:style-name="T90">Adv.</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>schon, bereits; nun</text:span><text:span text:style-name="T21">4</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T21"><text:span text:style-name="T24">in</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">Präp. m. Abl</text:span><text:span text:style-name="T26">. <text:s text:c="3"/>in, an, auf, bei (wo?)</text:span><text:span text:style-name="T21">12</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T180">in</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">Präp. m. Akk</text:span><text:span text:style-name="T26">. <text:s text:c="3"/>in (... hinein), nach (wohin?); </text:span><text:span text:style-name="T234">gegen</text:span><text:span text:style-name="T21">12. 56</text:span><text:span text:style-name="T23"> </text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T71"><text:span text:style-name="T222">invītus, invīta, invītum</text:span><text:span text:style-name="T71"> <text:s text:c="3"/>ungern, gegen den Willen</text:span><text:span text:style-name="T79">60</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T18"><text:span text:style-name="T24">is, ea, id</text:span><text:span text:style-name="T18"> <text:s text:c="3"/></text:span><text:span text:style-name="T26">dieser, diese, dieses; er, sie, es</text:span><text:span text:style-name="T21">26</text:span><text:span text:style-name="T18"> </text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T18"><text:span text:style-name="T30">item</text:span><text:span text:style-name="T18"> </text:span><text:span text:style-name="T90">Adv</text:span><text:span text:style-name="T26">. <text:s text:c="3"/>ebenso, gleichfalls</text:span><text:span text:style-name="T21">67</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T18">iterum </text:span><text:span text:style-name="T90">Adv.</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>wiederum, zum zweiten Mal</text:span><text:span text:style-name="T21">5</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">labor, labōris</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">m</text:span><text:span text:style-name="T26"> <text:s text:c="2"/>die Arbeit, die Anstrengung</text:span><text:span text:style-name="T21">27</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T180">manus, manūs</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">f</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>die Hand; die Schar (von Bewaffneten)</text:span><text:span text:style-name="T21">52</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T71"><text:span text:style-name="T80">m</text:span><text:span text:style-name="T18">ē</text:span><text:span text:style-name="T71"> </text:span><text:span text:style-name="T74">Akk</text:span><text:span text:style-name="T71">. <text:s text:c="3"/>mich</text:span><text:span text:style-name="T79">13</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T18"><text:span text:style-name="T24">meus, mea, meum</text:span><text:span text:style-name="T18"> <text:s text:c="3"/></text:span><text:span text:style-name="T26">mein</text:span><text:span text:style-name="T21">14</text:span><text:span text:style-name="T18"> </text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T18"><text:span text:style-name="T30">mēns, mentis</text:span><text:span text:style-name="T18"> </text:span><text:span text:style-name="T90">f (Gen. Pl.</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T24">-ium</text:span><text:span text:style-name="T90">) <text:s text:c="3"/></text:span><text:span text:style-name="T26">der Geist, der Sinn, der Verstand; dieMeinung</text:span><text:span text:style-name="T21">67</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T18">mihi</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">Dat</text:span><text:span text:style-name="T26">. <text:s text:c="3"/>mir</text:span><text:span text:style-name="T21">13</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">mīles, mīlitis</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">m</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>der Soldat</text:span><text:span text:style-name="T21">32</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T18">mīrus, mīra, mīrum</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>erstaunlich, sonderbar</text:span><text:span text:style-name="T21">24</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T18">mox</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">Adv.</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>bald</text:span><text:span text:style-name="T21">7</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T18"><text:span text:style-name="T24">multus, multa, multum</text:span><text:span text:style-name="T18"> <text:s text:c="3"/></text:span><text:span text:style-name="T26">viel</text:span><text:span text:style-name="T21">14</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T90"><text:span text:style-name="T180">nē</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">Subj. m. Konj</text:span><text:span text:style-name="T26">. <text:s text:c="3"/>dass nicht; </text:span><text:span text:style-name="T233">(nach Ausdrücken des Fürchtens und Hinderns) </text:span><text:span text:style-name="T234">dass; damit nicht, um nicht zu</text:span><text:span text:style-name="T233"> m. Inf</text:span><text:span text:style-name="T90">. </text:span><text:span text:style-name="T21">45. 59</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T16">necessarius, necessāria, necessārium</text:span><text:span text:style-name="T18"> <text:s text:c="3"/></text:span><text:span text:style-name="T26">notwendig</text:span><text:span text:style-name="T21">67</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T18"><text:span text:style-name="T24">nōs</text:span><text:span text:style-name="T18"> </text:span><text:span text:style-name="T90">Nom. / Akk.</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>wir / uns</text:span><text:span text:style-name="T21">13</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T18"><text:span text:style-name="T24">noster, nostra, nostrum</text:span><text:span text:style-name="T18"> <text:s text:c="3"/></text:span><text:span text:style-name="T26">unser</text:span><text:span text:style-name="T21">15</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T71"><text:span text:style-name="T80">num?</text:span><text:span text:style-name="T71"> </text:span><text:span text:style-name="T74">(im Hauptsatz)</text:span><text:span text:style-name="T71"> <text:s text:c="3"/>etwa?</text:span><text:span text:style-name="T79">42</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T18"><text:span text:style-name="T24">omnis, omne</text:span><text:span text:style-name="T18"> <text:s text:c="3"/></text:span><text:span text:style-name="T26">jeder, ganz; </text:span><text:span text:style-name="T90">Pl</text:span><text:span text:style-name="T26">. alle</text:span><text:span text:style-name="T21">33</text:span><text:span text:style-name="T18"> </text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T18"><text:span text:style-name="T179">paene</text:span><text:span text:style-name="T18"> </text:span><text:span text:style-name="T90">Adv.</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>fast</text:span><text:span text:style-name="T21">46</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T18"><text:soft-page-break/><text:span text:style-name="T16">posterī, posterōrum</text:span><text:span text:style-name="T18"> </text:span><text:span text:style-name="T90">m Pl.</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>die Nachkommen</text:span><text:span text:style-name="T21">67</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T18">praemium, praemiī </text:span><text:span text:style-name="T90">n <text:s text:c="3"/></text:span><text:span text:style-name="T26">die Belohnung, der Lohn</text:span><text:span text:style-name="T21">20</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T18">praestāre, praestō, praestitī</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">m. Akk</text:span><text:span text:style-name="T26">. <text:s text:c="3"/>gewähren, leisten, zeigen</text:span><text:span text:style-name="T21">28</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T18">prōcēdere, prōcēdō, prōcessī <text:s text:c="2"/></text:span><text:span text:style-name="T26"><text:s/>(vorwärts)gehen, vorrücken</text:span><text:span text:style-name="T21">44</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T16">prōdere, prōdō, prōdidī, prōditum</text:span><text:span text:style-name="T18"> <text:s text:c="3"/></text:span><text:span text:style-name="T26">verraten; überliefern</text:span><text:span text:style-name="T21">67</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T18"><text:span text:style-name="T18">profectō </text:span><text:span text:style-name="T90">Adv</text:span><text:span text:style-name="T26">. <text:s text:c="3"/>sicherlich, tatsächlich</text:span><text:span text:style-name="T21">6</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">prohibēre, prohibeō, prohibuī, prohibitum (ā)</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">m. Abl</text:span><text:span text:style-name="T26">. <text:s text:c="3"/>abhalten (von), hindern (an)</text:span><text:span text:style-name="T21">28</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T16">proinde</text:span><text:span text:style-name="T18"> </text:span><text:span text:style-name="T90">Adv</text:span><text:span text:style-name="T26">. <text:s text:c="3"/>also, daher</text:span><text:span text:style-name="T21">67</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T179">prōvidēre, prōvideō, prōvīdī, prōvīsum</text:span><text:span text:style-name="T26"> <text:s text:c="3"/></text:span><text:span text:style-name="T90">m. Akk</text:span><text:span text:style-name="T26">. vorhersehen; </text:span><text:span text:style-name="T90">m. Dat.</text:span><text:span text:style-name="T26"> sorgen für</text:span><text:span text:style-name="T21">53</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">prōvincia, prōvinciae</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">f</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>die Provinz</text:span><text:span text:style-name="T21">9</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">pūgnāre, pūgnō, pūgnāvī, pūgnātum</text:span><text:span text:style-name="T18"> <text:s text:c="3"/></text:span><text:span text:style-name="T26">kämpfen</text:span><text:span text:style-name="T21">9</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T18"><text:span text:style-name="T16">quamvīs</text:span><text:span text:style-name="T18"> </text:span><text:span text:style-name="T90">Subj. m. Konj</text:span><text:span text:style-name="T26">. <text:s text:c="3"/>wenn auch, obwohl</text:span><text:span text:style-name="T21">67</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T18"><text:span text:style-name="T16">quiēscere, quiēscō, quiēvī, quiētum</text:span><text:span text:style-name="T18"> <text:s text:c="3"/></text:span><text:span text:style-name="T26">(aus)ruhen,</text:span><text:span text:style-name="T18"> </text:span><text:span text:style-name="T26">schlafen</text:span><text:span text:style-name="T21">67</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">quī, quae, quod</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>der, die, das</text:span><text:span text:style-name="T21">34</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">rēs, reī</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">f</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>die Angelegenheit, das Ding, die Sache</text:span><text:span text:style-name="T21">41</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T18">Rōmānus, Rōmāna, Rōmānum</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>römisch; Subst. Römer, Einwohner Roms</text:span><text:span text:style-name="T21">9. 14</text:span><text:span text:style-name="T26"> </text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">salūs, salūtis</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">f</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>die Gesundheit, die Rettung, der Gruß, das Glück</text:span><text:span text:style-name="T21">25</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T18"><text:span text:style-name="T24">sed</text:span><text:span text:style-name="T18"> <text:s text:c="3"/></text:span><text:span text:style-name="T26">aber, sondern</text:span><text:span text:style-name="T21">3</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T18"><text:span text:style-name="T16">sponte meā (tuā, suā)</text:span><text:span text:style-name="T18"> <text:s text:c="3"/></text:span><text:span text:style-name="T26">freiwillig, von selbst</text:span><text:span text:style-name="T21">67</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T71"><text:span text:style-name="T231">sustinēre, sustineō, sustinuī</text:span><text:span text:style-name="T71"> <text:s text:c="3"/>ertragen, standhalten</text:span><text:span text:style-name="T79">61</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T18"><text:span text:style-name="T24">tamen</text:span><text:span text:style-name="T18"> <text:s text:c="3"/></text:span><text:span text:style-name="T26">dennoch, jedoch</text:span><text:span text:style-name="T21">3</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">tantus, tanta, tantum</text:span><text:span text:style-name="T18"> <text:s text:c="3"/></text:span><text:span text:style-name="T26">so groß, so viel</text:span><text:span text:style-name="T21">18</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">trānsīre, trānseō, trānsiī</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>durchqueren, hinübergehen, überschreiten</text:span><text:span text:style-name="T21">44</text:span><text:span text:style-name="T26"> </text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T18">tribūnus, tribūnī </text:span><text:span text:style-name="T90">m <text:s text:c="3"/></text:span><text:span text:style-name="T26">der</text:span><text:span text:style-name="T18"> </text:span><text:span text:style-name="T26">Tribun </text:span><text:span text:style-name="T90">(führender Vertreter eines Stadtbezirkes, einer Legion oder der Plebs)</text:span><text:span text:style-name="T21">37</text:span></text:p>
