    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T179">monēre, moneō, monuī, </text:span><text:span text:style-name="T16">monitum</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>mahnen, ermahnen</text:span><text:span text:style-name="T21">2. 47</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T18"><text:span text:style-name="T180">petere, petō, petīvī, </text:span><text:span text:style-name="T30">petītum</text:span><text:span text:style-name="T18"> <text:s text:c="3"/></text:span><text:span text:style-name="T26">aufsuchen, (er)streben, bitten, verlangen</text:span><text:span text:style-name="T21">18. 29. 47</text:span></text:p>
