   </text:section>
   <text:section text:style-name="Sect3" text:name="Bereich96">
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">ā / ab</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">Präp. m. Abl</text:span><text:span text:style-name="T26">. <text:s text:c="3"/>von, von ... her</text:span><text:span text:style-name="T21">16</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T179">ācerbus, ācerba, ācerbum</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>bitter, grausam, rücksichtslos</text:span><text:span text:style-name="T21">57</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T18"><text:span text:style-name="T24">ad</text:span><text:span text:style-name="T18"> </text:span><text:span text:style-name="T90">Präp. m. Akk.</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>zu, bei, nach, an</text:span><text:span text:style-name="T21">12</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">agere, agō, ēgī, actum</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>handeln, treiben, verhandeln</text:span><text:span text:style-name="T21">27</text:span><text:span text:style-name="T26"> </text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">amāre, amō, amāvī, amātum</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>lieben</text:span><text:span text:style-name="T21">8</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T174">animadvertere, animadvertō, animadvertī, </text:span><text:span text:style-name="T204">animadversum</text:span><text:span text:style-name="T173"> </text:span><text:span text:style-name="T176">m. AcI / Akk</text:span><text:span text:style-name="T173">. <text:s text:c="3"/></text:span><text:span text:style-name="T26">bemerken</text:span><text:span text:style-name="T21">29. 54</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">apud</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">Präp. m. Akk</text:span><text:span text:style-name="T26">. <text:s text:c="3"/>bei</text:span><text:span text:style-name="T21">18</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T18"><text:span text:style-name="T24">autem</text:span><text:span text:style-name="T18"> </text:span><text:span text:style-name="T90">(nachgestellt)</text:span><text:span text:style-name="T18"> <text:s text:c="3"/></text:span><text:span text:style-name="T26">aber, andererseits</text:span><text:span text:style-name="T21">15</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T16">brevis, breve</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>kurz</text:span><text:span text:style-name="T21">58</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T179">commovēre, commoveō, commōvī, commōtum</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>bewegen, veranlassen</text:span><text:span text:style-name="T21">57</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T18">concēdere, concēdō, concessī, concessum</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>erlauben, nachgeben, zugestehen</text:span><text:span text:style-name="T21">36</text:span><text:span text:style-name="T26"> </text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T179">coniūnx, coniugis</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">m/f</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>der Gatte, die Gattin</text:span><text:span text:style-name="T21">57</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">convenīre, conveniō, convēnī, conventum</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>zusammenkommen, zusammenpassen, besuchen</text:span><text:span text:style-name="T21">30</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">cum</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">Subj. m. Ind</text:span><text:span text:style-name="T26">. <text:s text:c="3"/>als (plötzlich); (immer) wenn</text:span><text:span text:style-name="T21">25</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T180">dare, dō, dedī, datum</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>geben</text:span><text:span text:style-name="T21">20. 28. 47</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">dē</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">Präp. m. Abl</text:span><text:span text:style-name="T26">. <text:s text:c="3"/>von, von ... her, von ... weg, von ... herab; über</text:span><text:span text:style-name="T21">14</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">dēbēre, dēbeō, dēbuī, </text:span><text:span text:style-name="T30">dēbitum</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>müssen, sollen, schulden</text:span><text:span text:style-name="T21">2. 58</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T18">dēdūcere, dēdūcō, dēdūxī, dēductum</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>wegführen, hinführen</text:span><text:span text:style-name="T21">23. 54</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T18">dēlectāre, dēlectō, dēlectāvī, dēlectātum</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>erfreuen, unterhalten</text:span><text:span text:style-name="T21">8</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T18"><text:span text:style-name="T24">deus, deī</text:span><text:span text:style-name="T18"> </text:span><text:span text:style-name="T90">m</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>der Gott, die Gottheit</text:span><text:span text:style-name="T21">6</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T18">dēspērāre, dēspērō, dēspērāvī, dēspērātum <text:s text:c="2"/></text:span><text:span text:style-name="T26"><text:s/>die Hoffnung aufgeben, verzweifeln</text:span><text:span text:style-name="T21">31</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T18">dolus, dolī</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">m <text:s text:c="3"/></text:span><text:span text:style-name="T26">die List, die Täuschung</text:span><text:span text:style-name="T21">9</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T16">effugere, effugiō, effūgī</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">m. Akk</text:span><text:span text:style-name="T26">. <text:s text:c="3"/>entfliehen, entkommen</text:span><text:span text:style-name="T21">58</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">esse, sum, fuī</text:span><text:span text:style-name="T18"> <text:s text:c="3"/></text:span><text:span text:style-name="T26">sein,</text:span><text:span text:style-name="T18"> </text:span><text:span text:style-name="T26">sich befinden</text:span><text:span text:style-name="T21">2. 25</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T18"><text:span text:style-name="T24">et</text:span><text:span text:style-name="T18"> <text:s text:c="3"/></text:span><text:span text:style-name="T26">und, auch</text:span><text:span text:style-name="T21">1</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T167"><text:span text:style-name="T24">etiam</text:span><text:span text:style-name="T18"> <text:s text:c="3"/></text:span><text:span text:style-name="T26">auch, sogar</text:span><text:span text:style-name="T21">5</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">facere, faciō, fēcī, </text:span><text:span text:style-name="T180">factum</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>machen, tun, handeln</text:span><text:span text:style-name="T21">17. 27. 48</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T18">fallere, fallō, fefellī</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>täuschen, betrügen</text:span><text:span text:style-name="T21">40</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">fidēs, fideī</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">f</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>der Glaube, die Treue, das Vertrauen, die Zuverlässigkeit</text:span><text:span text:style-name="T21">41</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">hic, haec, hoc</text:span><text:span text:style-name="T18"> <text:s text:c="3"/></text:span><text:span text:style-name="T26">dieser, diese, dieses (hier); folgender</text:span><text:span text:style-name="T21">40</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T18"><text:span text:style-name="T24">iam</text:span><text:span text:style-name="T18"> </text:span><text:span text:style-name="T90">Adv.</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>schon, bereits; nun</text:span><text:span text:style-name="T21">4</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">ille, illa, illud</text:span><text:span text:style-name="T18"> <text:s text:c="3"/></text:span><text:span text:style-name="T26">jener, jene, jenes; der (dort); jener berühmte</text:span><text:span text:style-name="T21">40</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T16">immō</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">Adv</text:span><text:span text:style-name="T26">. <text:s text:c="3"/>im Gegenteil, ja sogar</text:span><text:span text:style-name="T21">58</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T180"><text:span text:style-name="T180">in </text:span><text:span text:style-name="T185">Präp. m. Abl</text:span><text:span text:style-name="T186">. <text:s text:c="3"/>in, an, auf, bei (wo?)</text:span><text:span text:style-name="T187">12</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T188"><text:span text:style-name="T180">in </text:span><text:span text:style-name="T185">Präp. m. Akk</text:span><text:span text:style-name="T186">. <text:s text:c="3"/>in (... hinein), nach (wohin?)</text:span><text:span text:style-name="T187">12</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T18">inānis, ināne</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>leer, wertlos</text:span><text:span text:style-name="T21">35</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T16">īnferī, īnferōrum</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">m Pl</text:span><text:span text:style-name="T26">. <text:s text:c="3"/>die Bewohner der Unterwelt, Unterwelt</text:span><text:span text:style-name="T21">58</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T180">invenīre, inveniō, invēnī, inventum</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>finden, erfinden</text:span><text:span text:style-name="T21">13. 27. 48</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T180">ipse, ipsa, ipsum</text:span><text:span text:style-name="T26"> (</text:span><text:span text:style-name="T90">Gen</text:span><text:span text:style-name="T26">. </text:span><text:span text:style-name="T180">ipsīus</text:span><text:span text:style-name="T26">, </text:span><text:span text:style-name="T90">Dat</text:span><text:span text:style-name="T26">. </text:span><text:span text:style-name="T180">ipsī</text:span><text:span text:style-name="T26">) <text:s text:c="3"/>(er, sie, es) selbst; persönlich; gerade; sogar (hervorhebend)</text:span><text:span text:style-name="T21">56</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T18"><text:span text:style-name="T179">īra, īrae</text:span><text:span text:style-name="T18"> </text:span><text:span text:style-name="T90">f</text:span><text:span text:style-name="T18"> <text:s text:c="3"/></text:span><text:span text:style-name="T26">der Zorn, die Wut</text:span><text:span text:style-name="T21">46</text:span><text:span text:style-name="T18"> </text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T18"><text:span text:style-name="T24">is, ea, id</text:span><text:span text:style-name="T18"> <text:s text:c="3"/></text:span><text:span text:style-name="T26">dieser, diese, dieses; er, sie, es</text:span><text:span text:style-name="T21">26</text:span><text:span text:style-name="T18"> </text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T167"><text:span text:style-name="T24">itaque </text:span><text:span text:style-name="T168">Adv.</text:span><text:span text:style-name="T18"> <text:s text:c="3"/></text:span><text:span text:style-name="T26">deshalb</text:span><text:span text:style-name="T21">5</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T18">iterum </text:span><text:span text:style-name="T90">Adv.</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>wiederum, zum zweiten Mal</text:span><text:span text:style-name="T21">5</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T18">Iuppiter, Iovis </text:span><text:span text:style-name="T90">m</text:span><text:span text:style-name="T18"> <text:s text:c="3"/></text:span><text:span text:style-name="T26">Jupiter (griech. Zeus; Göttervater und höchster Gott der Römer)</text:span><text:span text:style-name="T21">15. 21. 27. X. XII. XIII. 43. 46</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T180">iubēre, iubeō, iussī, iussum</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">m. Akk</text:span><text:span text:style-name="T26">. <text:s text:c="3"/>anordnen, befehlen</text:span><text:span text:style-name="T21">57</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">labor, labōris</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">m</text:span><text:span text:style-name="T26"> <text:s text:c="2"/>die Arbeit, die Anstrengung</text:span><text:span text:style-name="T21">27</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T179">laetus, laeta, laetum</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>froh; fruchtbar</text:span><text:span text:style-name="T21">52</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">lībertās, lībertātis</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">f</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>die Freiheit</text:span><text:span text:style-name="T21">20</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T175">Mārs, Mārtis</text:span><text:span text:style-name="T173"> </text:span><text:span text:style-name="T176">m <text:s text:c="2"/></text:span><text:span text:style-name="T173"><text:s/>Mars (röm. </text:span><text:span text:style-name="T26">Kriegsgott)</text:span><text:span text:style-name="T21">58</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T30">modus, modī</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">m <text:s text:c="3"/></text:span><text:span text:style-name="T26">die Art, die Weise; das Maß</text:span><text:span text:style-name="T21">58</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T179">monēre, moneō, monuī, monitum</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>mahnen, ermahnen</text:span><text:span text:style-name="T21">2. 47</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">mōns, montis</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">m</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">(Gen. Pl</text:span><text:span text:style-name="T26">. </text:span><text:span text:style-name="T24">-ium</text:span><text:span text:style-name="T90">)</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>der Berg</text:span><text:span text:style-name="T21">23</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T167"><text:span text:style-name="T16">summus mōns</text:span><text:span text:style-name="T18"> <text:s text:c="3"/></text:span><text:span text:style-name="T26">der Berggipfel, die höchste Stelle des Berges</text:span><text:span text:style-name="T21">58</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:soft-page-break/><text:span text:style-name="T24">mors, mortis</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">f</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">(Gen. Pl.</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T24">-ium</text:span><text:span text:style-name="T90">)</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>der Tod</text:span><text:span text:style-name="T21">22</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T21"><text:span text:style-name="T18">Mors, Mortis</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">f <text:s text:c="3"/></text:span><text:span text:style-name="T26">Mors (der Tod als Person)</text:span><text:span text:style-name="T21">0</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T23"><text:span text:style-name="T179">mortālis, mortāle</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>sterblich; </text:span><text:span text:style-name="T90">Subst</text:span><text:span text:style-name="T26">. der Mensch</text:span><text:span text:style-name="T21">55</text:span><text:span text:style-name="T23"> </text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T18">mortuus, mortua,mortuum</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>gestorben, tot; </text:span><text:span text:style-name="T90">Subst</text:span><text:span text:style-name="T26">. der Tote</text:span><text:span text:style-name="T21">21</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">movēre, moveō, mōvī, mōtum</text:span><text:span text:style-name="T18"> <text:s text:c="3"/></text:span><text:span text:style-name="T26">bewegen, beeindrucken</text:span><text:span text:style-name="T21">7. 27</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T18"><text:span text:style-name="T24">nam</text:span><text:span text:style-name="T18"> <text:s text:c="3"/></text:span><text:span text:style-name="T26">denn, nämlich</text:span><text:span text:style-name="T21">3</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">nōn</text:span><text:span text:style-name="T18"> <text:s text:c="3"/></text:span><text:span text:style-name="T26">nicht</text:span><text:span text:style-name="T21">2</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T18">nōndum</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">Adv</text:span><text:span text:style-name="T26">. <text:s text:c="3"/>noch nicht</text:span><text:span text:style-name="T21">25</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">nunc</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">Adv</text:span><text:span text:style-name="T26">. <text:s text:c="3"/>nun, jetzt</text:span><text:span text:style-name="T21">2</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T173"><text:span text:style-name="T175">obsecrāre, obsecrō, obsecrāvī, obsecrātum</text:span><text:span text:style-name="T173"> <text:s text:c="3"/>anflehen, bitten</text:span><text:span text:style-name="T181">58</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T18">Plūtō, Plūtōnis <text:s/></text:span><text:span text:style-name="T90">m</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>Pluto (griech. Hades; Gott der Unterwelt.)</text:span><text:span text:style-name="T21">28.XIX</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T18"><text:span text:style-name="T180">poena, poenae</text:span><text:span text:style-name="T18"> </text:span><text:span text:style-name="T90">f </text:span><text:span text:style-name="T18"><text:s text:c="3"/></text:span><text:span text:style-name="T26">die Strafe</text:span><text:span text:style-name="T21">46</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T18"><text:span text:style-name="T24">posse, possum, potuī</text:span><text:span text:style-name="T18"> <text:s text:c="3"/></text:span><text:span text:style-name="T26">können</text:span><text:span text:style-name="T21">17. 25</text:span><text:span text:style-name="T18"> </text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T30">premere, premō, pressī, pressum</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>(unter)drücken, bedrängen</text:span><text:span text:style-name="T21">58</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T18"><text:span text:style-name="T18">profectō </text:span><text:span text:style-name="T90">Adv.</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>sicherlich, tatsächlich</text:span><text:span text:style-name="T21">6</text:span><text:span text:style-name="T18"> </text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T18">prōmittere, prōmittō, prōmīsī, promissum</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>versprechen</text:span><text:span text:style-name="T21">40</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">quī, quae, quod</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>der, die, das</text:span><text:span text:style-name="T21">34</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">redīre, redeō, rediī, reditum</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>zurückgehen, zurückkehren</text:span><text:span text:style-name="T21">37</text:span><text:span text:style-name="T26"> </text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T16">regere, regō, rēxī, rēctum</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>beherrschen, leiten, lenken</text:span><text:span text:style-name="T21">58</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">relinquere, relinquō, relīquī <text:s text:c="3"/></text:span><text:span text:style-name="T26">verlassen, zurücklassen</text:span><text:span text:style-name="T21">16. 27</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T18">resistere, resistō, restitī</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>stehenbleiben; Widerstand leisten</text:span><text:span text:style-name="T21">36</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T21"><text:span text:style-name="T18">revolvitur</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>es (sie, es) rollt zurück</text:span><text:span text:style-name="T21">0</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T179">rīdēre, rīdeō, rīsī, rīsum</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>lachen, auslachen</text:span><text:span text:style-name="T21">2.34.48</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T18">sacer, sacra, sacrum</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">m. Gen</text:span><text:span text:style-name="T26">. <text:s text:c="3"/>heilig, geweiht (jdm.)</text:span><text:span text:style-name="T21">42</text:span><text:span text:style-name="T23"> </text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">salūs, salūtis</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">f</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>die Gesundheit, die Rettung, der Gruß, das Glück</text:span><text:span text:style-name="T21">25</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T16">saxum, saxī</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">n <text:s text:c="3"/></text:span><text:span text:style-name="T26">der Fels, der Stein</text:span><text:span text:style-name="T21">58</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T18"><text:span text:style-name="T24">sed</text:span><text:span text:style-name="T18"> <text:s text:c="3"/></text:span><text:span text:style-name="T26">aber, sondern</text:span><text:span text:style-name="T21">3</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T18"><text:span text:style-name="T24">semper</text:span><text:span text:style-name="T18"> </text:span><text:span text:style-name="T90">Adv</text:span><text:span text:style-name="T26">. <text:s text:c="3"/>immer</text:span><text:span text:style-name="T21">4</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">servāre, servō, servāvī, servātum</text:span><text:span text:style-name="T18"> <text:s text:c="3"/></text:span><text:span text:style-name="T26">bewahren, retten; beobachten</text:span><text:span text:style-name="T21">15</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T18">Sīsyphus, Sīsyphī </text:span><text:span text:style-name="T90">m</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>Sisyphus (Gründer und König von Korinth. Wegen seiner Freveltaten muss er im Tartarus auf ewig büßen.)</text:span><text:span text:style-name="T21">58</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">spēs, speī</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">f</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>die Erwartung, die Hoffnung</text:span><text:span text:style-name="T21">41</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">summus, summa, summum</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>der höchste, oberste</text:span><text:span text:style-name="T21">15</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">tandem</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">Adv</text:span><text:span text:style-name="T26">. <text:s text:c="3"/>endlich</text:span><text:span text:style-name="T21">7</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T18">Tartarus, Tartarī</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">m <text:s text:c="3"/></text:span><text:span text:style-name="T26">der </text:span><text:span text:style-name="T71">Tartarus</text:span><text:span text:style-name="T26"> (der Teil der Unterwelt, in dem Verbrecher und Übeltäter nach dem Tod ihre Strafen verbüßen mussten)</text:span><text:span text:style-name="T21">21. 28. 57</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">trahere, trahō, trāxī, tractum</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>schleppen, ziehen</text:span><text:span text:style-name="T21">16. 28</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">tum</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">Adv</text:span><text:span text:style-name="T26">. <text:s text:c="3"/>da, dann, darauf, damals</text:span><text:span text:style-name="T21">4</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T21"><text:span text:style-name="T24">velle, volō, voluī</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>wollen</text:span><text:span text:style-name="T21">19. 25</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T18"><text:span text:style-name="T24">venīre, veniō, vēnī, ventum</text:span><text:span text:style-name="T18"> <text:s text:c="3"/></text:span><text:span text:style-name="T26">kommen</text:span><text:span text:style-name="T21">10. 27</text:span><text:span text:style-name="T167"> </text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T18">verbum, verbī </text:span><text:span text:style-name="T90">n</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>das Wort, die Äußerung</text:span><text:span text:style-name="T21">11</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T16">vinculum, vinculī</text:span><text:span text:style-name="T18"> </text:span><text:span text:style-name="T90">n </text:span><text:span text:style-name="T26"><text:s text:c="3"/>das Band, die Fessel; </text:span><text:span text:style-name="T90">Pl</text:span><text:span text:style-name="T26">. das Gefängnis</text:span><text:span text:style-name="T21">58</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T21"><text:span text:style-name="T16">in vincula dare</text:span><text:span text:style-name="T18"> <text:s text:c="3"/></text:span><text:span text:style-name="T26">fesseln, gefangen nehmen</text:span><text:span text:style-name="T21">58</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">vīta, vītae</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">f</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>das Leben</text:span><text:span text:style-name="T21">15</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T16">volvere, volvō, volvī, volūtum</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>rollen, wälzen; überlegen</text:span><text:span text:style-name="T21">58</text:span></text:p>
