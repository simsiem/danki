    <text:p text:style-name="P37" loext:marker-style-name="T71"><text:span text:style-name="T93">cum</text:span><text:span text:style-name="T71"> </text:span><text:span text:style-name="T74">Subj. m. Konj</text:span><text:span text:style-name="T71">. <text:s text:c="3"/>als, nachdem; weil; obwohl</text:span><text:span text:style-name="T79">61</text:span><text:span text:style-name="T71"> </text:span></text:p>
