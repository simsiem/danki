    <text:p text:style-name="P37" loext:marker-style-name="T71"><text:span text:style-name="T226">salve! salvete!</text:span><text:span text:style-name="T215"> <text:s text:c="3"/></text:span><text:span text:style-name="T71">sei(d) gegrüßt!, grüß dich / euch!</text:span><text:span text:style-name="T79">20</text:span></text:p>
