    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T18">statua, statuae </text:span><text:span text:style-name="T90">f</text:span><text:span text:style-name="T18"> <text:s text:c="3"/></text:span><text:span text:style-name="T26">die</text:span><text:span text:style-name="T18"> </text:span><text:span text:style-name="T26">Statue</text:span><text:span text:style-name="T21">11</text:span></text:p>
