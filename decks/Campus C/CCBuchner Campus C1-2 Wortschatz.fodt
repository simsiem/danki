    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T180">capere, capiō, cēpī, captum</text:span><text:span text:style-name="T18"> </text:span><text:span text:style-name="T26"><text:s text:c="3"/>fassen, nehmen, fangen; erobern</text:span><text:span text:style-name="T21">17. 27. 48</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T23"><text:span text:style-name="T18">cadere, cadō, cecidī</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>fallen</text:span><text:span text:style-name="T21">26. 28</text:span><text:span text:style-name="T23"> </text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T21"><text:span text:style-name="T18">cera, cerae</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">f <text:s text:c="3"/></text:span><text:span text:style-name="T26">das Wachs</text:span><text:span text:style-name="T21">0</text:span></text:p>
