    <text:p text:style-name="P53" loext:marker-style-name="T183"/>
   </text:section>
   <text:section text:style-name="Sect3" text:name="Bereich70">
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">adesse, adsum, adfuī</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>da sein, helfen</text:span><text:span text:style-name="T21">18</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T18"><text:span text:style-name="T24">auxilium, auxiliī</text:span><text:span text:style-name="T18"> </text:span><text:span text:style-name="T90">n</text:span><text:span text:style-name="T18"> <text:s text:c="3"/></text:span><text:span text:style-name="T26">die Hilfe</text:span><text:span text:style-name="T21">15</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T18">Brūtus, Brūtī</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">m <text:s text:c="3"/></text:span><text:span text:style-name="T26">Brutus</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T26">(C. Iūlius) </text:span><text:span text:style-name="T18">Caesar, Caesaris</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">m</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>Gajus Julius Cäsar (100–44 v. Chr., röm. Politiker, Feldherr und Schriftsteller</text:span><text:span text:style-name="T21">I. 27. 35. 51</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T174">carēre, careō, caruī</text:span><text:span text:style-name="T173"> </text:span><text:span text:style-name="T176">m. Abl</text:span><text:span text:style-name="T173">. <text:s text:c="3"/></text:span><text:span text:style-name="T26">frei sein von, ohne (etwas) sein, nicht haben</text:span><text:span text:style-name="T21">28</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T18"><text:span text:style-name="T173">(M. Tullius) </text:span><text:span text:style-name="T174">Cicerō, Cicerōnis</text:span><text:span text:style-name="T173"> </text:span><text:span text:style-name="T176">m</text:span><text:span text:style-name="T173"> <text:s text:c="3"/>Cicero (röm. </text:span><text:span text:style-name="T26">Politiker, Redner, Philosoph und Schriftsteller, 106-43 v. Chr.</text:span><text:span text:style-name="T21">50. 53 . XVIII</text:span><text:span text:style-name="T18"> </text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T30">cōnsulere, cōnsulō, cōnsuluī, cōnsultum</text:span><text:span text:style-name="T26"> <text:s text:c="3"/></text:span><text:span text:style-name="T90">m. Akk</text:span><text:span text:style-name="T26">. um Rat fragen; </text:span><text:span text:style-name="T90">m. Dat</text:span><text:span text:style-name="T26">. sorgen für; </text:span><text:span text:style-name="T24">in</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">m. Akk. </text:span><text:span text:style-name="T26">vorgehen gegen</text:span><text:span text:style-name="T21">53</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">dare, dō, dedī, datum</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>geben</text:span><text:span text:style-name="T21">20. 28. 47</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">deus, deī</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">m</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>der Gott, die Gottheit</text:span><text:span text:style-name="T21">6</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T18"><text:span text:style-name="T24">et</text:span><text:span text:style-name="T18"> <text:s text:c="3"/></text:span><text:span text:style-name="T26">und, auch</text:span><text:span text:style-name="T21">1</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">fugere, fugiō, fūgī</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">m. Akk. <text:s text:c="2"/></text:span><text:span text:style-name="T26"><text:s/>fliehen (vor), meiden</text:span><text:span text:style-name="T21">51</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">īnsidiae, īnsidiārum</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">f Pl.</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>die Falle, das Attentat, die Hinterlist</text:span><text:span text:style-name="T21">44</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">is, ea, id</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>dieser, diese, dieses; er, sie, es</text:span><text:span text:style-name="T21">26</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T16">iuvāre, iuvō, iūvī</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">m. Akk</text:span><text:span text:style-name="T26">. <text:s text:c="3"/>unterstützen, helfen; erfreuen</text:span><text:span text:style-name="T21">53</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T18"><text:span text:style-name="T24">multus, multa, multum</text:span><text:span text:style-name="T18"> <text:s text:c="3"/></text:span><text:span text:style-name="T26">viel</text:span><text:span text:style-name="T21">14</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">nōn</text:span><text:span text:style-name="T18"> <text:s text:c="3"/></text:span><text:span text:style-name="T26">nicht</text:span><text:span text:style-name="T21">2</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">parāre, parō, parāvī, parātum</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>(vor)bereiten, vorhaben </text:span><text:span text:style-name="T90">m. Inf</text:span><text:span text:style-name="T26">.; erwerben</text:span><text:span text:style-name="T21">8</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T175">parcere, parcō, pepercī</text:span><text:span text:style-name="T173"> </text:span><text:span text:style-name="T176">m. Dat</text:span><text:span text:style-name="T173">. <text:s text:c="3"/></text:span><text:span text:style-name="T26">schonen, verschonen</text:span><text:span text:style-name="T21">53</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T16">praeesse, praesum, praefuī</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">m. Dat</text:span><text:span text:style-name="T26">. <text:s text:c="3"/>leiten, an der Spitze stehen, kommandieren</text:span><text:span text:style-name="T21">53</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T16">prōvidēre, prōvideō, prōvīdī, prōvīsum</text:span><text:span text:style-name="T26"> <text:s text:c="4"/></text:span><text:span text:style-name="T90">m. Akk</text:span><text:span text:style-name="T26">. vorhersehen; </text:span><text:span text:style-name="T90">m. Dat.</text:span><text:span text:style-name="T26"> sorgen für</text:span><text:span text:style-name="T21">53</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">rēs pūblica, rēī pūblicae</text:span><text:span text:style-name="T18"> </text:span><text:span text:style-name="T90">f</text:span><text:span text:style-name="T18"> <text:s text:c="3"/></text:span><text:span text:style-name="T26">der Staat</text:span><text:span text:style-name="T21">41</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">rēx, rēgis</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">m</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>der König</text:span><text:span text:style-name="T21">27</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T18"><text:span text:style-name="T24">sed</text:span><text:span text:style-name="T18"> <text:s text:c="3"/></text:span><text:span text:style-name="T26">aber, sondern</text:span><text:span text:style-name="T21">3</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">sīgnum, sīgnī</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">n</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>das Merkmal, das Zeichen; die Statue</text:span><text:span text:style-name="T21">32</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">ut</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">Adv</text:span><text:span text:style-name="T26">. <text:s text:c="3"/>wie</text:span><text:span text:style-name="T21">10</text:span></text:p>
    <text:p text:style-name="P34" loext:marker-style-name="T26"><text:span text:style-name="T18">venia, veniae </text:span><text:span text:style-name="T90">f <text:s text:c="2"/></text:span><text:span text:style-name="T26"><text:s/>der Gefallen; die Nachsicht, die Verzeihung</text:span><text:span text:style-name="T21">31</text:span></text:p>
   </text:section>
