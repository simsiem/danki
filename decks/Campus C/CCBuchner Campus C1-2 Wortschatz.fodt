    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T18">īnfāns, īnfantis</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">m/f</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>das (kleine) Kind</text:span><text:span text:style-name="T21">0</text:span></text:p>
