    <text:p text:style-name="P37" loext:marker-style-name="T18"><text:span text:style-name="T24">autem</text:span><text:span text:style-name="T18"> </text:span><text:span text:style-name="T90">(nachgestellt)</text:span><text:span text:style-name="T18"> <text:s text:c="3"/></text:span><text:span text:style-name="T26">aber, andererseits</text:span><text:span text:style-name="T21">15</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T18">cēnāre, cēnō, cēnāvī, cēnātum</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>essen</text:span><text:span text:style-name="T21">9</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T18"><text:span text:style-name="T18">crūdēlis, crūdēle <text:s text:c="3"/></text:span><text:span text:style-name="T26">grausam</text:span><text:span text:style-name="T21">33</text:span></text:p>
