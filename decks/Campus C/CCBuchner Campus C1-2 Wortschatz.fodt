    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">adesse, adsum, adfuī</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>da sein, helfen</text:span><text:span text:style-name="T21">18</text:span></text:p>
