    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">tūtus, tūta, tūtum</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>sicher</text:span><text:span text:style-name="T21">35</text:span></text:p>
