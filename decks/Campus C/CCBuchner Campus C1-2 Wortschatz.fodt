    <text:p text:style-name="P37" loext:marker-style-name="T18"><text:span text:style-name="T24">nōs</text:span><text:span text:style-name="T18"> </text:span><text:span text:style-name="T90">Nom. / Akk.</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>wir / uns</text:span><text:span text:style-name="T21">13</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">nunc</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">Adv</text:span><text:span text:style-name="T26">. <text:s text:c="3"/>nun, jetzt</text:span><text:span text:style-name="T21">2</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T18"><text:span text:style-name="T24">omnis, omne</text:span><text:span text:style-name="T18"> <text:s text:c="3"/></text:span><text:span text:style-name="T26">jeder, ganz; </text:span><text:span text:style-name="T90">Pl</text:span><text:span text:style-name="T26">. alle</text:span><text:span text:style-name="T21">33</text:span><text:span text:style-name="T18"> </text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T170"><text:span text:style-name="T24">parāre, parō, parāvī, parātum <text:s text:c="3"/></text:span><text:span text:style-name="T171">(vor)bereiten, vorhaben </text:span><text:span text:style-name="T168">m. Inf</text:span><text:span text:style-name="T171">.; erwerben</text:span><text:span text:style-name="T170">8</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T18">pārēre, pāreō, pāruī</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>gehorchen</text:span><text:span text:style-name="T21">2</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">pater, patris</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">m</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>der Vater</text:span><text:span text:style-name="T21">20</text:span><text:span text:style-name="T26"> </text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T173"><text:span text:style-name="T182">patria, patriae</text:span><text:span text:style-name="T173"> </text:span><text:span text:style-name="T176">f</text:span><text:span text:style-name="T173"> <text:s text:c="3"/>die Heimat</text:span><text:span text:style-name="T181">9</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T181"><text:span text:style-name="T174">penna, pennae</text:span><text:span text:style-name="T173"> </text:span><text:span text:style-name="T176">f <text:s text:c="3"/></text:span><text:span text:style-name="T173">die Feder</text:span><text:span text:style-name="T181">0</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:soft-page-break/><text:span text:style-name="T24">per</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">Präp. m. Akk</text:span><text:span text:style-name="T26">. <text:s text:c="3"/>durch, hindurch</text:span><text:span text:style-name="T21">16</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">perīculum, perīculī</text:span><text:span text:style-name="T18"> </text:span><text:span text:style-name="T90">n</text:span><text:span text:style-name="T18"> <text:s text:c="3"/></text:span><text:span text:style-name="T26">die Gefahr</text:span><text:span text:style-name="T21">24</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T18">perniciēs, perniciēī</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">f</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>das Verderben, die Vernichtung</text:span><text:span text:style-name="T21">41</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T18"><text:span text:style-name="T24">posse, possum, potuī</text:span><text:span text:style-name="T18"> <text:s text:c="3"/></text:span><text:span text:style-name="T26">können</text:span><text:span text:style-name="T21">17. 25</text:span><text:span text:style-name="T18"> </text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T18"><text:span text:style-name="T18">praebēre, praebeō, praebuī, praebitum <text:s text:c="3"/></text:span><text:span text:style-name="T26">geben, hinhalten</text:span><text:span text:style-name="T21">4</text:span><text:span text:style-name="T18"> </text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">prīmus, prīma, prīmum</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>der (die, das) erste</text:span><text:span text:style-name="T21">22</text:span></text:p>
