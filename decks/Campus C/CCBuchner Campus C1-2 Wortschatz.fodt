    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">ille, illa, illud</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>jener, jene, jenes; der (dort); jener berühmte</text:span><text:span text:style-name="T21">40</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T21"><text:span text:style-name="T18">impluvium, impluviī</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">n <text:s text:c="3"/></text:span><text:span text:style-name="T26">das Wasserbecken (im Atrium)</text:span><text:span text:style-name="T21">0</text:span></text:p>
