    <text:p text:style-name="P37" loext:marker-style-name="T18"><text:span text:style-name="T24">omnis, omne</text:span><text:span text:style-name="T18"> <text:s text:c="3"/></text:span><text:span text:style-name="T26">jeder, ganz; </text:span><text:span text:style-name="T90">Pl</text:span><text:span text:style-name="T26">. alle</text:span><text:span text:style-name="T21">33</text:span><text:span text:style-name="T18"> </text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">parāre, parō, parāvī, parātum</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>(vor)bereiten, vorhaben </text:span><text:span text:style-name="T90">m. Inf</text:span><text:span text:style-name="T26">.; erwerben</text:span><text:span text:style-name="T21">8</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T18"><text:span text:style-name="T18">pecūnia, pecūniae </text:span><text:span text:style-name="T90">f <text:s text:c="3"/></text:span><text:span text:style-name="T26">das</text:span><text:span text:style-name="T18"> </text:span><text:span text:style-name="T26">Geld, das Vermögen</text:span><text:span text:style-name="T21">19</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T179">pergere, pergō, perrēxī</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>aufbrechen; weitermachen</text:span><text:span text:style-name="T21">59</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T71"><text:span text:style-name="T232">pervenīre, perveniō, perv</text:span><text:span text:style-name="T208">ē</text:span><text:span text:style-name="T232">nī, perventum</text:span><text:span text:style-name="T215"> ad / in </text:span><text:span text:style-name="T217">m. Akk</text:span><text:span text:style-name="T215">. <text:s text:c="3"/></text:span><text:span text:style-name="T71">kommen zu / nach</text:span><text:span text:style-name="T79">60</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T21"><text:span text:style-name="T18">portōrium, portōriī </text:span><text:span text:style-name="T90">n</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>der Zoll</text:span><text:span text:style-name="T21">0</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T16">pōscere, pōscō, popōscī</text:span><text:span text:style-name="T18"> <text:s text:c="3"/></text:span><text:span text:style-name="T26">fordern, verlangen</text:span><text:span text:style-name="T21">69</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T18"><text:span text:style-name="T24">posse, possum, potuī</text:span><text:span text:style-name="T18"> <text:s text:c="3"/></text:span><text:span text:style-name="T26">können</text:span><text:span text:style-name="T21">17. 25</text:span><text:span text:style-name="T18"> </text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T18"><text:span text:style-name="T18">profectō </text:span><text:span text:style-name="T90">Adv.</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>sicherlich, tatsächlich</text:span><text:span text:style-name="T21">6</text:span><text:span text:style-name="T18"> </text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T21"><text:span text:style-name="T18">Publius, Publī </text:span><text:span text:style-name="T90">m</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>Eigenname, Steuerpächter</text:span><text:span text:style-name="T21">0</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">quaerere, quaerō, quaesīvī, </text:span><text:span text:style-name="T180">quaesītum</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>erwerben wollen, suchen, fragen</text:span><text:span text:style-name="T21">30. 47</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T18"><text:span text:style-name="T24">quam</text:span><text:span text:style-name="T18"> <text:s text:c="3"/></text:span><text:span text:style-name="T26">als, wie</text:span><text:span text:style-name="T21">17</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">quī, quae, quod</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>der, die, das</text:span><text:span text:style-name="T21">34</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T18">quid?</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>was?</text:span><text:span text:style-name="T21">2</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T181"><text:span text:style-name="T174">(P. Sulpicius) Quirinius, Quirinī </text:span><text:span text:style-name="T176">m</text:span><text:span text:style-name="T173"> <text:s text:c="3"/>Eigenname, römischer Legat</text:span><text:span text:style-name="T181">0</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T18"><text:span text:style-name="T30">quoniam</text:span><text:span text:style-name="T18"> </text:span><text:span text:style-name="T90">Subj. m. Ind</text:span><text:span text:style-name="T26">. <text:s text:c="3"/>da ja, da nun</text:span><text:span text:style-name="T21">69</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">quoque</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">(nachgestellt)</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>auch</text:span><text:span text:style-name="T21">45</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T21"><text:span text:style-name="T18">recuperāre, recuperō, recuperāvī, recuperātum <text:s text:c="3"/></text:span><text:span text:style-name="T26">wiederbekommen</text:span><text:span text:style-name="T21">0</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">rēs pūblica, reī pūblicae</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">f</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>der Staat</text:span><text:span text:style-name="T21">41</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T18">repellere, repellō, reppulī <text:s text:c="3"/></text:span><text:span text:style-name="T26">zurückstoßen, abweisen, vertreiben</text:span><text:span text:style-name="T21">32</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T18">resistere, resistō, restitī</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>stehenbleiben; Widerstand leisten</text:span><text:span text:style-name="T21">36</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T18">Rōmānus, Rōmāna, Rōmānum</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>römisch; </text:span><text:span text:style-name="T90">Subst</text:span><text:span text:style-name="T26">. Römer, Einwohner Roms</text:span><text:span text:style-name="T21">9. 14</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">saepe</text:span><text:span text:style-name="T18"> </text:span><text:span text:style-name="T90">Adv</text:span><text:span text:style-name="T26">. <text:s text:c="3"/>oft</text:span><text:span text:style-name="T21">4</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T71"><text:span text:style-name="T80">salve! salvete!</text:span><text:span text:style-name="T71"> <text:s text:c="3"/>sei(d) gegrüßt!, grüß dich / euch!</text:span><text:span text:style-name="T79">20</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T18"><text:span text:style-name="T24">scīre, sciō, scīvī, scītum</text:span><text:span text:style-name="T18"> <text:s text:c="3"/></text:span><text:span text:style-name="T26">wissen, kennen, verstehen</text:span><text:span text:style-name="T21">10</text:span><text:span text:style-name="T18"> </text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">servus, servī</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">m</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>der Sklave, der Diener</text:span><text:span text:style-name="T21">1</text:span><text:span text:style-name="T26"> </text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T180">solvere, solvō, solvī, solūtum</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>lösen, auflösen; bezahlen</text:span><text:span text:style-name="T21">55</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T181"><text:span text:style-name="T174">stīpendia </text:span><text:span text:style-name="T176">n Pl.</text:span><text:span text:style-name="T173"> <text:s text:c="3"/>der Sold</text:span><text:span text:style-name="T181">0</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T173"><text:span text:style-name="T174">Syria, Syriae </text:span><text:span text:style-name="T176">f</text:span><text:span text:style-name="T174"> <text:s text:c="3"/></text:span><text:span text:style-name="T173">Syrien</text:span><text:span text:style-name="T181">9</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T174">tē</text:span><text:span text:style-name="T173"> </text:span><text:span text:style-name="T176">Akk</text:span><text:span text:style-name="T173">. <text:s text:c="3"/></text:span><text:span text:style-name="T26">dich</text:span><text:span text:style-name="T21">13</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T18"><text:span text:style-name="T24">tū </text:span><text:span text:style-name="T90">Nom</text:span><text:span text:style-name="T26">. <text:s text:c="3"/>du (betont)</text:span><text:span text:style-name="T21">13</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">tuus,tua, tuum</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>dein</text:span><text:span text:style-name="T21">14</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T18"><text:span text:style-name="T18">ūsque </text:span><text:span text:style-name="T90">Adv</text:span><text:span text:style-name="T26">. <text:s text:c="3"/>ohne Unterbrechung</text:span><text:span text:style-name="T21">44. 66</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T21"><text:span text:style-name="T24">ut</text:span><text:span text:style-name="T18"> </text:span><text:span text:style-name="T90">Subj. m. Konj</text:span><text:span text:style-name="T26">. <text:s text:c="3"/>dass, sodass; damit, um zu </text:span><text:span text:style-name="T90">m. Inf.</text:span><text:span text:style-name="T21">45. 59</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T18">utrum ... an </text:span><text:span text:style-name="T90">(Wahlfrage im Hauptsatz)</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>...oder</text:span><text:span text:style-name="T21">66</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T21"><text:span text:style-name="T18">vectīgal, vectīgālis </text:span><text:span text:style-name="T90">n</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>die Steuer</text:span><text:span text:style-name="T21">0</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T21"><text:span text:style-name="T24">velle, volō, voluī</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>wollen</text:span><text:span text:style-name="T21">19.25</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T18">via</text:span><text:span text:style-name="T26">, </text:span><text:span text:style-name="T18">viae </text:span><text:span text:style-name="T90">f</text:span><text:span text:style-name="T26"> <text:s text:c="2"/>der Weg, die Straße</text:span><text:span text:style-name="T21">1</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T18"><text:span text:style-name="T24">vōs</text:span><text:span text:style-name="T18"> </text:span><text:span text:style-name="T90">Nom. / Akk.</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>ihr / euch</text:span><text:span text:style-name="T21">13</text:span></text:p>
   </text:section>
