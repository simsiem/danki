    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T174">animadvertere, animadvertō, animadvertī, </text:span><text:span text:style-name="T204">animadversum</text:span><text:span text:style-name="T173"> </text:span><text:span text:style-name="T176">m. AcI / Akk</text:span><text:span text:style-name="T173">. <text:s text:c="3"/></text:span><text:span text:style-name="T26">bemerken</text:span><text:span text:style-name="T21">29. 54</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">animus, animī </text:span><text:span text:style-name="T90">m</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>der Geist, der Mut, die Gesinnung</text:span><text:span text:style-name="T21">19</text:span><text:span text:style-name="T26"> </text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T80">Antigona</text:span><text:span text:style-name="T71"> <text:s text:c="3"/>Antigone (Tochter des Ödipus; sie widersetzte sich dem Verbot ihres Onkels Kreon, den Leichnam ihres Bruders Polyneikes zu bestatten, und musste dafür mit dem Leben bezahlen.)</text:span><text:span text:style-name="T79">60. 61. XXI</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T180">auctōritās, auctōritātis</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">f</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>das Ansehen, der Einfluss, die Macht</text:span><text:span text:style-name="T21">48</text:span></text:p>
