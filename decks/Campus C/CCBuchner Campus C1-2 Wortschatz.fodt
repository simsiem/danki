    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T18">superbus, superba, superbum</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>stolz, überheblich</text:span><text:span text:style-name="T21">36</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T180">ut</text:span><text:span text:style-name="T18"> </text:span><text:span text:style-name="T90">Adv</text:span><text:span text:style-name="T26">. <text:s text:c="3"/>wie</text:span><text:span text:style-name="T21">10</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T18">verbum, verbī </text:span><text:span text:style-name="T90">n</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>das Wort, die Äußerung</text:span><text:span text:style-name="T21">11</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T21"><text:span text:style-name="T180">vidēre, videō, vīdī, vīsum</text:span><text:span text:style-name="T24"> <text:s text:c="2"/></text:span><text:span text:style-name="T26"><text:s/>sehen</text:span><text:span text:style-name="T21">7. 27. 48</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">vir, virī</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">m</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>der Mann</text:span><text:span text:style-name="T21">15</text:span></text:p>
