   <text:section text:style-name="Sect3" text:name="Bereich146">
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T18">accūsāre, accūsō, accūsāvī, accūsātum</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>anklagen, beschuldigen</text:span><text:span text:style-name="T21">33</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">alius, alia, aliud</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>ein anderer</text:span><text:span text:style-name="T21">29</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T18"><text:span text:style-name="T24">an</text:span><text:span text:style-name="T18"> </text:span><text:span text:style-name="T90">(im Fragesatz)</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>oder (etwa)</text:span><text:span text:style-name="T21">24</text:span></text:p>
