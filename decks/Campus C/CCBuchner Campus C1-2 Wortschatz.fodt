    <text:p text:style-name="P37" loext:marker-style-name="T71"><text:span text:style-name="T96">metuere, metuo, metui</text:span><text:span text:style-name="T71"> <text:s text:c="3"/>(sich) fürchten</text:span><text:span text:style-name="T79">60</text:span></text:p>
