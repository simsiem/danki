    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T18">currere, currō, cucurrī <text:s text:c="3"/></text:span><text:span text:style-name="T26">laufen, eilen</text:span><text:span text:style-name="T21">44</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T16">dēferre, dēferō, dētulī, dēlātum</text:span><text:span text:style-name="T18"> <text:s text:c="3"/></text:span><text:span text:style-name="T26">hinbringen, melden, übertragen</text:span><text:span text:style-name="T21">70</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">dīcere, dīcō, dīxī, dictum <text:s text:c="2"/></text:span><text:span text:style-name="T26"><text:s/>sagen, sprechen</text:span><text:span text:style-name="T21">16. 27</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T18"><text:span text:style-name="T16">differre, differō, distulī, dīlātum</text:span><text:span text:style-name="T18"> </text:span><text:span text:style-name="T90">(</text:span><text:span text:style-name="T18">ā</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">m. Abl.)</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>aufschieben; sich unterscheiden (von)</text:span><text:span text:style-name="T21">70</text:span></text:p>
