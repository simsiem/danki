    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">accipere, accipiō, accēpī</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>erhalten, erfahren, annehmen</text:span><text:span text:style-name="T21">34</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">addūcere, addūcō, </text:span><text:span text:style-name="T180">addūxī, adductum</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>heranführen, veranlassen</text:span><text:span text:style-name="T21">23. 55</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T16">adversus</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">Präp. m. Akk.</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>gegen</text:span><text:span text:style-name="T21">59</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T18">alere, alo, aluī</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>ernähren, großziehen</text:span><text:span text:style-name="T21">42</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">amāre, amō, amāvī, amātum</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>lieben</text:span><text:span text:style-name="T21">8</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T204">Apollō, Apollinis</text:span><text:span text:style-name="T173"> </text:span><text:span text:style-name="T176">m</text:span><text:span text:style-name="T173"> <text:s text:c="3"/>Apollo (griech. </text:span><text:span text:style-name="T26">Apollon; Gott des Lichts, der Musik und Künste sowie der Heilkunst und Weissagung)</text:span><text:span text:style-name="T21">X. 56</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">arma, armōrum</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">n Pl.</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>das Gerät, die Waffen</text:span><text:span text:style-name="T21">26</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T180">atque / ac</text:span><text:span text:style-name="T24"> <text:s text:c="2"/></text:span><text:span text:style-name="T26"><text:s/>und, und auch</text:span><text:span text:style-name="T21">47</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T18">cedere, cedo, cessi <text:s text:c="2"/></text:span><text:span text:style-name="T26"><text:s/>gehen, nachgeben, weichen</text:span><text:span text:style-name="T21">29</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T173"><text:span text:style-name="T175">circúmdare, circumdō, circumdedī, circumdatum</text:span><text:span text:style-name="T173"> <text:s text:c="3"/>umgeben</text:span><text:span text:style-name="T181">59</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T173"><text:span text:style-name="T174">clāmāre, clāmō, clāmāvī, clāmātum</text:span><text:span text:style-name="T173"> <text:s text:c="3"/>laut rufen, schreien</text:span><text:span text:style-name="T181">13</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">c</text:span><text:span text:style-name="T100">ō</text:span><text:span text:style-name="T24">gere, cogo, coegi</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>(ver)sammeln; zwingen</text:span><text:span text:style-name="T21">39</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T16">convertere, convertō, convertī, conversum</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>verändern, (um)wenden</text:span><text:span text:style-name="T21">59</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T174">Corinthus, Corinthī</text:span><text:span text:style-name="T173"> </text:span><text:span text:style-name="T176">f</text:span><text:span text:style-name="T173"> <text:s text:c="3"/>Korinth (reiche griech. </text:span><text:span text:style-name="T26">Handelsstadt am Isthmos)</text:span><text:span text:style-name="T21">39. XVII</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T180">dare, dō, dedī, datum</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>geben</text:span><text:span text:style-name="T21">20. 28. 47</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">dē</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">Präp. m. Abl</text:span><text:span text:style-name="T26">. <text:s text:c="3"/>von, von ... her, von ... weg, von ... herab; über</text:span><text:span text:style-name="T21">14</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">esse, sum, fuī</text:span><text:span text:style-name="T18"> <text:s text:c="3"/></text:span><text:span text:style-name="T26">sein,</text:span><text:span text:style-name="T18"> </text:span><text:span text:style-name="T26">sich befinden</text:span><text:span text:style-name="T21">2. 25</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T18"><text:span text:style-name="T24">et</text:span><text:span text:style-name="T18"> <text:s text:c="3"/></text:span><text:span text:style-name="T26">und, auch</text:span><text:span text:style-name="T21">1</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T21"><text:span text:style-name="T18">expōnere</text:span><text:span text:style-name="T26"> <text:s text:c="2"/>Erschließe die Bedeutung; beachte dabei die Wahl der passenden Bedeutung des Simplex pōnere</text:span><text:span text:style-name="T21">0</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">fīlius, filiī</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">m <text:s text:c="3"/></text:span><text:span text:style-name="T26">der <text:s/>Sohn</text:span><text:span text:style-name="T21">9</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T16">furor, furōris</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">m</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>der Wahnsinn, die Wut</text:span><text:span text:style-name="T21">59</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">hic, haec, hoc</text:span><text:span text:style-name="T18"> <text:s text:c="3"/></text:span><text:span text:style-name="T26">dieser, diese, dieses (hier); folgender</text:span><text:span text:style-name="T21">40</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T18">īgnōtus, īgnōta, īgnōtum</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>unbekannt</text:span><text:span text:style-name="T21">45</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T18"><text:span text:style-name="T179">impedīre, impediō, impedīvī, impedītum</text:span><text:span text:style-name="T18"> <text:s text:c="3"/></text:span><text:span text:style-name="T26">hindern, verhindern</text:span><text:span text:style-name="T21">46</text:span></text:p>
