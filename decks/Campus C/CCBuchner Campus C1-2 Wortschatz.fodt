    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">prīmus, prīma, prīmum</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>der (die, das) erste</text:span><text:span text:style-name="T21">22</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T18">puella, puellae</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">f</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>das Mädchen</text:span><text:span text:style-name="T21">1</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">puer, puerī</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">m</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>der Junge, der Bub</text:span><text:span text:style-name="T21">15</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">pulcher, pulchra, pulchrum</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>schön</text:span><text:span text:style-name="T21">15</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T180">relinquere, relinquō, relīquī, relictum</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>verlassen, zurücklassen</text:span><text:span text:style-name="T21">16. 27. 50</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T18"><text:span text:style-name="T179">reprehendere, reprehendō, reprehendī, reprehēnsum</text:span><text:span text:style-name="T18"> <text:s text:c="3"/></text:span><text:span text:style-name="T26">schimpfen, kritisieren</text:span><text:span text:style-name="T21">48</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">rogāre, rogō, rogāvī, rogātum</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>fragen, bitten</text:span><text:span text:style-name="T21">8</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">salūs, salūtis</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">f</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>die Gesundheit, die Rettung, der Gruß, das Glück</text:span><text:span text:style-name="T21">25</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T21"><text:span text:style-name="T18">salūtem dīcere</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>grüßen</text:span><text:span text:style-name="T21">0</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T18">sentīre, sentiō, sēnsī, sēnsum <text:s text:c="2"/></text:span><text:span text:style-name="T26"><text:s/>fühlen, meinen, wahrnehmen</text:span><text:span text:style-name="T21">29</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T23"><text:span text:style-name="T18">septem</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">indekl</text:span><text:span text:style-name="T26">. <text:s text:c="3"/>sieben</text:span><text:span text:style-name="T21">12</text:span><text:span text:style-name="T23"> </text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">servāre, servō, servāvī, servātum</text:span><text:span text:style-name="T18"> <text:s text:c="3"/></text:span><text:span text:style-name="T26">bewahren, retten; beobachten</text:span><text:span text:style-name="T21">15</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T18">statim</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">Adv</text:span><text:span text:style-name="T26">. <text:s text:c="3"/>sofort</text:span><text:span text:style-name="T21">5</text:span><text:span text:style-name="T26"> </text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">superāre, superō, superāvī, superātum</text:span><text:span text:style-name="T18"> <text:s text:c="2"/></text:span><text:span text:style-name="T26"><text:s/>besiegen, überwinden, übertreffen</text:span><text:span text:style-name="T21">9</text:span><text:span text:style-name="T26"> </text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T18"><text:span text:style-name="T24">tamen</text:span><text:span text:style-name="T18"> <text:s text:c="3"/></text:span><text:span text:style-name="T26">dennoch, jedoch</text:span><text:span text:style-name="T21">3</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T173"><text:span text:style-name="T18">tē</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">Akk</text:span><text:span text:style-name="T26">. <text:s text:c="3"/></text:span><text:span text:style-name="T173">dich</text:span><text:span text:style-name="T181">13</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T18">Theseus, Thesei</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">m</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>Theseus (athenischer Held; auf Kreta tötete er mithilfe der Ariadne den Minotaurus)</text:span><text:span text:style-name="T21">XX</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T173"><text:span text:style-name="T18">tibi</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">Dat</text:span><text:span text:style-name="T26">. <text:s text:c="3"/></text:span><text:span text:style-name="T173">dir</text:span><text:span text:style-name="T181">13</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T174">torquēre, torqueō, torsī, tortum</text:span><text:span text:style-name="T173"> <text:s text:c="3"/>drehen; quälen</text:span><text:span text:style-name="T181">5. </text:span><text:span text:style-name="T21">27</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">tū</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">Nom</text:span><text:span text:style-name="T26">. <text:s text:c="3"/>du </text:span><text:span text:style-name="T90">(betont)</text:span><text:span text:style-name="T21">13</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">tuus,tua, tuum</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>dein</text:span><text:span text:style-name="T21">14</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">valēre, valeō, valuī</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>gesund sein, stark sein, Einfluss haben</text:span><text:span text:style-name="T21">7</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T18">verbum, verbī </text:span><text:span text:style-name="T90">n</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>das Wort, die Äußerung</text:span><text:span text:style-name="T21">11</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T18">via</text:span><text:span text:style-name="T26">, </text:span><text:span text:style-name="T18">viae </text:span><text:span text:style-name="T90">f</text:span><text:span text:style-name="T26"> <text:s text:c="2"/>der Weg, die Straße</text:span><text:span text:style-name="T21">1</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">vir, virī</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">m</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>der Mann</text:span><text:span text:style-name="T21">15</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T21"><text:span text:style-name="T24">vōx, vōcis</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">f</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>die Stimme, die Äußerung, der Laut</text:span><text:span text:style-name="T21">25</text:span></text:p>
