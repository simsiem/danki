    <text:p text:style-name="P26" loext:marker-style-name="T43"><text:span text:style-name="T53">is, ea, id</text:span><text:span text:style-name="T119"> <text:s text:c="3"/></text:span><text:span text:style-name="T43">dieser, diese, dieses; er, sie, es</text:span><text:span text:style-name="T44">26</text:span><text:span text:style-name="T43"> </text:span></text:p>
