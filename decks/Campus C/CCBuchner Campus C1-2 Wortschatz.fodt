    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T18">amīca, amīcae</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">f</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>die Freundin</text:span><text:span text:style-name="T21">2</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T173"><text:span text:style-name="T182">amor, amōris</text:span><text:span text:style-name="T173"> </text:span><text:span text:style-name="T176">m</text:span><text:span text:style-name="T173"> <text:s text:c="3"/>Liebe</text:span><text:span text:style-name="T181">19</text:span><text:span text:style-name="T173"> </text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T174">animadvertere, animadvertō, animadvertī, </text:span><text:span text:style-name="T204">animadversum</text:span><text:span text:style-name="T173"> </text:span><text:span text:style-name="T176">m. AcI / Akk</text:span><text:span text:style-name="T173">. <text:s text:c="3"/></text:span><text:span text:style-name="T26">bemerken</text:span><text:span text:style-name="T21">29. 54</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T18"><text:span text:style-name="T24">autem</text:span><text:span text:style-name="T18"> </text:span><text:span text:style-name="T90">(nachgestellt)</text:span><text:span text:style-name="T18"> <text:s text:c="3"/></text:span><text:span text:style-name="T26">aber, andererseits</text:span><text:span text:style-name="T21">15</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T180">capere, capiō, cēpī, captum</text:span><text:span text:style-name="T18"> </text:span><text:span text:style-name="T26"><text:s text:c="3"/>fassen, nehmen, fangen; erobern</text:span><text:span text:style-name="T21">17. 27. 48</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T21"><text:span text:style-name="T18">Cerēs, Cereris</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">f <text:s text:c="3"/></text:span><text:span text:style-name="T26">Ceres</text:span><text:span text:style-name="T21">0</text:span></text:p>
