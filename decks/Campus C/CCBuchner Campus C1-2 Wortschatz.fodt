    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T174">Caesar, Caesaris </text:span><text:span text:style-name="T176">m</text:span><text:span text:style-name="T173"> <text:s text:c="3"/>Gajus Julius Cäsar </text:span><text:span text:style-name="T176">(röm. </text:span><text:span text:style-name="T90">Politiker, Feldherr und Schriftsteller, 100-44 v. Chr.)</text:span><text:span text:style-name="T21">51</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T21"><text:span text:style-name="T18">Cingetorix, Cingetorigis </text:span><text:span text:style-name="T90">m</text:span><text:span text:style-name="T18"> <text:s text:c="3"/></text:span><text:span text:style-name="T26">Eigenname, gallischer Kaufmann</text:span><text:span text:style-name="T21">0</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T18"><text:span text:style-name="T18">cognōscere, cognōscō, cognōvī, cognitum <text:s text:c="3"/></text:span><text:span text:style-name="T26">erkennen, kennenlernen; Perf. kennen, wissen</text:span><text:span text:style-name="T21">39.63</text:span></text:p>
