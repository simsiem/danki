    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T30">abesse, absum, āfuī</text:span><text:span text:style-name="T18"> </text:span><text:span text:style-name="T90">(</text:span><text:span text:style-name="T24">ā </text:span><text:span text:style-name="T90">m. Abl.)</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>entfernt sein, abwesend sein, fehlen</text:span><text:span text:style-name="T21">68</text:span></text:p>
