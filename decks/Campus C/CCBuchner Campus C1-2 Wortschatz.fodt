    <text:p text:style-name="P37" loext:marker-style-name="T71"><text:span text:style-name="T80">superbia, superbiae </text:span><text:span text:style-name="T74">f</text:span><text:span text:style-name="T71"> <text:s text:c="3"/>der Stolz, der Hochmut</text:span><text:span text:style-name="T79">9</text:span></text:p>
