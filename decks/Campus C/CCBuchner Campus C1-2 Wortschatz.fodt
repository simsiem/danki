    <text:p text:style-name="P25" loext:marker-style-name="T44"><text:span text:style-name="T53">scr</text:span><text:span text:style-name="T129">ī</text:span><text:span text:style-name="T53">bere, scr</text:span><text:span text:style-name="T129">ī</text:span><text:span text:style-name="T53">b</text:span><text:span text:style-name="T129">ō</text:span><text:span text:style-name="T53">, scr</text:span><text:span text:style-name="T129">ī</text:span><text:span text:style-name="T53">ps</text:span><text:span text:style-name="T129">ī</text:span><text:span text:style-name="T119"> <text:s text:c="3"/></text:span><text:span text:style-name="T43">schreiben, beschreiben</text:span><text:span text:style-name="T44">16. 34</text:span></text:p>
