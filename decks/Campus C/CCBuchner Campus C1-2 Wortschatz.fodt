    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">iter, itineris</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">n</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>die Reise, der Marsch, der Weg</text:span><text:span text:style-name="T21">44</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T18">iuvenis, iuvenis</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">m</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>junger Mann; </text:span><text:span text:style-name="T90">Adj</text:span><text:span text:style-name="T26">. jung</text:span><text:span text:style-name="T21">32</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T18">Lāius</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>Laios (König von Theben, Vater des Ödipus; wurde von seinem Sohn, der ihn nicht erkannt hatte, im Affekt erschlagen.)</text:span><text:span text:style-name="T21">59</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T180">manus, manūs</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">f</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>die Hand; die Schar (von Bewaffneten)</text:span><text:span text:style-name="T21">52</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">māter, mātris</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">f</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>die Mutter</text:span><text:span text:style-name="T21">20</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T21"><text:span text:style-name="T18">Meropa</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>Merope</text:span><text:span text:style-name="T21">0</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">mōns, montis</text:span><text:span text:style-name="T26"> m (</text:span><text:span text:style-name="T90">Gen. Pl.</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T24">-ium</text:span><text:span text:style-name="T26">) <text:s text:c="3"/>der Berg</text:span><text:span text:style-name="T21">23</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">movēre, moveō, mōvī, mōtum</text:span><text:span text:style-name="T18"> <text:s text:c="3"/></text:span><text:span text:style-name="T26">bewegen, beeindrucken</text:span><text:span text:style-name="T21">7. 27</text:span></text:p>
