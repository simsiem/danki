    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T16">ōrāculum, ōrāculī</text:span><text:span text:style-name="T18"> </text:span><text:span text:style-name="T90">n </text:span><text:span text:style-name="T18"><text:s text:c="3"/></text:span><text:span text:style-name="T26">das Orakel, der Orakelspruch</text:span><text:span text:style-name="T21">59</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T179">parere, pariō, peperī, partum</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>zur Welt bringen, gebären; schaffen</text:span><text:span text:style-name="T21">56</text:span><text:span text:style-name="T26"> </text:span></text:p>
