    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T179">nōnnūllī, nōnnūllae, nōnnūlla</text:span><text:span text:style-name="T18"> <text:s text:c="3"/></text:span><text:span text:style-name="T26">einige, manche</text:span><text:span text:style-name="T21">63</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T18"><text:span text:style-name="T24">nōs</text:span><text:span text:style-name="T18"> </text:span><text:span text:style-name="T90">Nom. / Akk.</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>wir / uns</text:span><text:span text:style-name="T21">13</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T18"><text:span text:style-name="T24">noster, nostra, nostrum</text:span><text:span text:style-name="T18"> <text:s text:c="3"/></text:span><text:span text:style-name="T26">unser</text:span><text:span text:style-name="T21">15</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">officium, officiī</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">n</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>der Dienst, die Pflicht, das Pflichtgefühl</text:span><text:span text:style-name="T21">28</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T18"><text:span text:style-name="T24">omnis, omne</text:span><text:span text:style-name="T18"> <text:s text:c="3"/></text:span><text:span text:style-name="T26">jeder, ganz; </text:span><text:span text:style-name="T90">Pl</text:span><text:span text:style-name="T26">. alle</text:span><text:span text:style-name="T21">33</text:span><text:span text:style-name="T18"> </text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">parāre, parō, parāvī, parātum</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>(vor)bereiten, vorhaben </text:span><text:span text:style-name="T90">m. Inf</text:span><text:span text:style-name="T26">.; erwerben</text:span><text:span text:style-name="T21">8</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T18">perniciēs, perniciēī</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">f</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>das Verderben, die Vernichtung</text:span><text:span text:style-name="T21">41</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T179">perterrēre, perterreō, perterruī, perterritum</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>sehr erschrecken, einschüchtern</text:span><text:span text:style-name="T21">54</text:span><text:span text:style-name="T23"> </text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T16">plēnus, plēna, plēnum</text:span><text:span text:style-name="T18"> </text:span><text:span text:style-name="T90">m. Gen</text:span><text:span text:style-name="T26">. <text:s text:c="3"/>voll (von / mit)</text:span><text:span text:style-name="T21">19. 68</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T18"><text:span text:style-name="T24">posse, possum, potuī</text:span><text:span text:style-name="T18"> <text:s text:c="3"/></text:span><text:span text:style-name="T26">können</text:span><text:span text:style-name="T21">17. 25</text:span><text:span text:style-name="T18"> </text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">prīmus, prīma, prīmum</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>der (die, das) erste</text:span><text:span text:style-name="T21">22</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T18">prōcēdere, prōcēdō, prōcessī <text:s text:c="2"/></text:span><text:span text:style-name="T26"><text:s/>(vorwärts)gehen, vorrücken</text:span><text:span text:style-name="T21">44</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">prohibēre, prohibeō, prohibuī, prohibitum (ā)</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">m. Abl</text:span><text:span text:style-name="T26">. <text:s text:c="3"/>abhalten (von), hindern (an)</text:span><text:span text:style-name="T21">28</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T30">prope</text:span><text:span text:style-name="T18"> </text:span><text:span text:style-name="T90">Präp. m. Akk</text:span><text:span text:style-name="T26">. <text:s text:c="3"/>nahe bei, in der Nähe von</text:span><text:span text:style-name="T21">68</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T18"><text:span text:style-name="T18">quamvīs </text:span><text:span text:style-name="T90">Subj. m. Konj</text:span><text:span text:style-name="T26">. <text:s text:c="3"/>wenn auch, obwohl</text:span><text:span text:style-name="T21">67</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T18"><text:span text:style-name="T30">quasi</text:span><text:span text:style-name="T18"> </text:span><text:span text:style-name="T90">Adv</text:span><text:span text:style-name="T26">. <text:s text:c="3"/>gleichsam</text:span><text:span text:style-name="T21">68</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">quī, quae, quod</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>der, die, das</text:span><text:span text:style-name="T21">34</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T173"><text:span text:style-name="T182">quia</text:span><text:span text:style-name="T173"> </text:span><text:span text:style-name="T176">Subj.</text:span><text:span text:style-name="T173"> <text:s text:c="3"/>weil</text:span><text:span text:style-name="T181">19</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T173"><text:span text:style-name="T174">quid?</text:span><text:span text:style-name="T173"> <text:s text:c="3"/>was?</text:span><text:span text:style-name="T181">2</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">quidem</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">Adv</text:span><text:span text:style-name="T26">. <text:s text:c="3"/>freilich, gewiss, wenigstens, zwar</text:span><text:span text:style-name="T21">31</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T21"><text:span text:style-name="T16">quin?</text:span><text:span text:style-name="T18"> </text:span><text:span text:style-name="T90">(im Hauptsatz)</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>warum nicht? <text:s text:c="3"/></text:span><text:span text:style-name="T206">Subj. m. Konj.</text:span><text:span text:style-name="T195"> </text:span><text:span text:style-name="T206">(in festen Wendungen)</text:span><text:span text:style-name="T195"> <text:s text:c="3"/>dass</text:span><text:span text:style-name="T21">17. 68</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">redīre, redeō, rediī, reditum</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>zurückgehen, zurückkehren</text:span><text:span text:style-name="T21">37</text:span><text:span text:style-name="T26"> </text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T18"><text:span text:style-name="T24">regiō, regiōnis</text:span><text:span text:style-name="T18"> </text:span><text:span text:style-name="T90">f</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>das Gebiet, die Gegend, die Richtung</text:span><text:span text:style-name="T21">23</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T18">Rōmānus, Rōmāna, Rōmānum</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>römisch; </text:span><text:span text:style-name="T90">Subst</text:span><text:span text:style-name="T26">. der Römer, der Einwohner Roms</text:span><text:span text:style-name="T21">9. 14</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T18"><text:span text:style-name="T18">rūs, rūris </text:span><text:span text:style-name="T90">n</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>das Feld, das Land </text:span><text:span text:style-name="T90">(im Gegensatz zu Stadt)</text:span><text:span text:style-name="T26">, das Landgut</text:span><text:span text:style-name="T21">64</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">salūs, salūtis</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">f</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>die Gesundheit, die Rettung, der Gruß, das Glück</text:span><text:span text:style-name="T21">25</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T18">s</text:span><text:span text:style-name="T189">ē</text:span><text:span text:style-name="T18"> </text:span><text:span text:style-name="T90">Akk. / Abl</text:span><text:span text:style-name="T26">. <text:s text:c="3"/>sich</text:span><text:span text:style-name="T21">19</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T18">silva, silvae</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">f <text:s text:c="3"/></text:span><text:span text:style-name="T26">der Wald</text:span><text:span text:style-name="T21">1</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T180">socius, sociī</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">m</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>der Gefährte, Verbündeter</text:span><text:span text:style-name="T21">47</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">spēs, speī</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">f</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>die Erwartung, die Hoffnung</text:span><text:span text:style-name="T21">41</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">suus, sua, suum</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>sein, ihr</text:span><text:span text:style-name="T21">30</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T18">subitō</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">Adv</text:span><text:span text:style-name="T26">. <text:s text:c="3"/>plötzlich</text:span><text:span text:style-name="T21">5</text:span><text:span text:style-name="T26"> </text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">tōtus, tōta, tōtum</text:span><text:span text:style-name="T18"> </text:span><text:span text:style-name="T90">(Gen.</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T24">tōtīus</text:span><text:span text:style-name="T26">, </text:span><text:span text:style-name="T90">Dat.</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T24">tōtī</text:span><text:span text:style-name="T90">)</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>ganz, gesamt</text:span><text:span text:style-name="T21">40</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T21"><text:span text:style-name="T18">trānsfīgere, trānsfigō, trānsfīxī, trānsfīxum <text:s text:c="3"/></text:span><text:span text:style-name="T26">durchbohren</text:span><text:span text:style-name="T21">0</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T173"><text:span text:style-name="T182">trēs, trēs, tria</text:span><text:span text:style-name="T173"> <text:s text:c="3"/>drei</text:span><text:span text:style-name="T181">33</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">tum</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">Adv</text:span><text:span text:style-name="T26">. <text:s text:c="3"/>da, dann, darauf, damals</text:span><text:span text:style-name="T21">4</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T18"><text:span text:style-name="T179">umquam</text:span><text:span text:style-name="T18"> </text:span><text:span text:style-name="T90">Adv</text:span><text:span text:style-name="T26">. <text:s text:c="3"/>jemals</text:span><text:span text:style-name="T21">62</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T179">undique</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">Adv</text:span><text:span text:style-name="T26">. <text:s text:c="3"/>von allen Seiten, von überallher</text:span><text:span text:style-name="T21">48</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T180">ut</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">Subj. m. Konj</text:span><text:span text:style-name="T26">. <text:s text:c="3"/>dass, sodass; </text:span><text:span text:style-name="T234">damit, um zu </text:span><text:span text:style-name="T233">m. Inf</text:span><text:span text:style-name="T234">.</text:span><text:span text:style-name="T21">45. 59</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T23"><text:span text:style-name="T16">ūtilis, ūtile</text:span><text:span text:style-name="T18"> <text:s text:c="3"/></text:span><text:span text:style-name="T26">nützlich</text:span><text:span text:style-name="T21">68</text:span><text:span text:style-name="T23"> </text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:soft-page-break/><text:span text:style-name="T26">(P. Quinctilius)</text:span><text:span text:style-name="T18"> Vārus, Vārī </text:span><text:span text:style-name="T90">m</text:span><text:span text:style-name="T18"> <text:s text:c="3"/></text:span><text:span text:style-name="T26">Varus (Feldherr des röm. Kaisers Augustus; verlor 9 n. Chr. die Schlacht im Teutoburger Wald, nachdem er vom Cheruskerfürsten Arminius in einen Hinterhalt gelockt worden war)</text:span><text:span text:style-name="T21">68. XXIV. 69</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T179">vehemēns, vehementis</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>energisch, heftig</text:span><text:span text:style-name="T21">55</text:span><text:span text:style-name="T26"> </text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T23"><text:span text:style-name="T24">ventus, ventī</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">m </text:span><text:span text:style-name="T26"><text:s text:c="3"/>der Wind</text:span><text:span text:style-name="T21">6</text:span><text:span text:style-name="T23"> </text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T18">via</text:span><text:span text:style-name="T26">, </text:span><text:span text:style-name="T18">viae </text:span><text:span text:style-name="T90">f</text:span><text:span text:style-name="T26"> <text:s text:c="2"/>der Weg, die Straße</text:span><text:span text:style-name="T21">1</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T180">victōria, victōriae</text:span><text:span text:style-name="T18"> </text:span><text:span text:style-name="T90">f</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>der</text:span><text:span text:style-name="T18"> </text:span><text:span text:style-name="T26">Sieg</text:span><text:span text:style-name="T21">45</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T18"><text:span text:style-name="T24">virtūs, virtūtis</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">f</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>die Tapferkeit, die Tüchtigkeit, die Leistung; die Tugend</text:span><text:span text:style-name="T21">22</text:span><text:span text:style-name="T18"> </text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T71"><text:span text:style-name="T24">vīvere, vīvō, vīxī</text:span><text:span text:style-name="T71"> <text:s text:c="3"/>leben</text:span><text:span text:style-name="T79">30</text:span></text:p>
   </text:section>
   <text:section text:style-name="Sect2" text:name="Bereich145">
    <text:p text:style-name="P39" loext:marker-style-name="T14"/>
    <text:p text:style-name="P107" loext:marker-style-name="T14"><text:span text:style-name="T14">XXIV kompakt. T, Seite 122 <text:s text:c="2"/></text:span></text:p>
    <text:p text:style-name="P39" loext:marker-style-name="T14"/>
