    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T18">apertus, aperta, apertum</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>offen, offenkundig</text:span><text:span text:style-name="T21">43</text:span></text:p>
