    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">nēmō, nēminis</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>niemand</text:span><text:span text:style-name="T21">38</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T16">Nioba, Niobae</text:span><text:span text:style-name="T18"> </text:span><text:span text:style-name="T90">f <text:s text:c="2"/></text:span><text:span text:style-name="T26"><text:s/>Niobe (Tochter des Tantalus; durch die Heirat mit Amphion Königin von Theben.)</text:span><text:span text:style-name="T21">56</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">nōn</text:span><text:span text:style-name="T18"> <text:s text:c="3"/></text:span><text:span text:style-name="T26">nicht</text:span><text:span text:style-name="T21">2</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T18"><text:span text:style-name="T24">omnis, omne</text:span><text:span text:style-name="T18"> <text:s text:c="3"/></text:span><text:span text:style-name="T26">jeder, ganz; </text:span><text:span text:style-name="T90">Pl</text:span><text:span text:style-name="T26">. alle</text:span><text:span text:style-name="T21">33</text:span><text:span text:style-name="T18"> </text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">pater, patris</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">m</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>der Vater</text:span><text:span text:style-name="T21">20</text:span><text:span text:style-name="T26"> </text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T16">parere, pariō, peperī, partum</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>zur Welt bringen, gebären; schaffen</text:span><text:span text:style-name="T21">56</text:span><text:span text:style-name="T26"> </text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T23"><text:span text:style-name="T16">potēns, potentis</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>mächtig, stark</text:span><text:span text:style-name="T21">56</text:span><text:span text:style-name="T23"> </text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T179">praeclārus, praeclāra, praeclārum</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>großartig</text:span><text:span text:style-name="T21">54</text:span><text:span text:style-name="T26"> </text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T18"><text:span text:style-name="T18">profectō </text:span><text:span text:style-name="T90">Adv.</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>sicherlich, tatsächlich</text:span><text:span text:style-name="T21">6</text:span><text:span text:style-name="T18"> </text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">prohibēre, prohibeō, prohibuī, prohibitum (ā)</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">m. Abl</text:span><text:span text:style-name="T26">. <text:s text:c="3"/>abhalten (von), hindern (an)</text:span><text:span text:style-name="T21">28</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">putāre, putō, putāvī, putātum</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>glauben, meinen</text:span><text:span text:style-name="T21">29</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">quī, quae, quod</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>der, die, das</text:span><text:span text:style-name="T21">34</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T21"><text:span text:style-name="T24">reddere, reddō, reddidī, redditum</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>zurückgeben, etw. zukommen lassen; </text:span><text:span text:style-name="T90">m. dopp. Akk.</text:span><text:span text:style-name="T26"> jdn. zu etw. machen</text:span><text:span text:style-name="T21">0</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T18"><text:span text:style-name="T179">reprehendere, reprehendō, reprehendī, reprehēnsum</text:span><text:span text:style-name="T18"> <text:s text:c="3"/></text:span><text:span text:style-name="T26">schimpfen, kritisieren</text:span><text:span text:style-name="T21">48</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T179">rīdēre, rīdeō, rīsī, rīsum</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>lachen, auslachen</text:span><text:span text:style-name="T21">2.34.48</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T179">sacerdōs, sacerdōtis</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">m/f</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>der/die Priester(in)</text:span><text:span text:style-name="T21">50</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T18">sacer, sacra, sacrum</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">m. Gen</text:span><text:span text:style-name="T26">. <text:s text:c="3"/>heilig, geweiht (jdm.)</text:span><text:span text:style-name="T21">42</text:span><text:span text:style-name="T23"> </text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T18">sē</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">Akk. / Abl.</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>sich</text:span><text:span text:style-name="T21">19</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T23"><text:span text:style-name="T18">septem</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">indekl</text:span><text:span text:style-name="T26">. <text:s text:c="3"/>sieben</text:span><text:span text:style-name="T21">12</text:span><text:span text:style-name="T23"> </text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">suus, sua, suum</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>sein, ihr</text:span><text:span text:style-name="T21">30</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">superāre, superō, superāvī, superātum</text:span><text:span text:style-name="T18"> <text:s text:c="2"/></text:span><text:span text:style-name="T26"><text:s/>besiegen, überwinden, übertreffen</text:span><text:span text:style-name="T21">9</text:span><text:span text:style-name="T26"> </text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T18">superbus, superba, superbum</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>stolz, überheblich</text:span><text:span text:style-name="T21">36</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T30">superī, superōrum</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">m Pl</text:span><text:span text:style-name="T26">. <text:s text:c="3"/>die Götter</text:span><text:span text:style-name="T21">56</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T180">tālis, tāle</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>derartig, ein solcher, so (beschaffen)</text:span><text:span text:style-name="T21">52</text:span><text:span text:style-name="T26"> </text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T16">Tantalus, Tantalī</text:span><text:span text:style-name="T18"> </text:span><text:span text:style-name="T90">m <text:s text:c="2"/></text:span><text:span text:style-name="T26"><text:s/>Tantalus (Sohn des Jupiter, König von Lydien, Vater der Niobe und des Pelops)</text:span><text:span text:style-name="T21">56</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">tantum</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">Adv. (nachgestellt)</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>nur</text:span><text:span text:style-name="T21">5</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T21"><text:span text:style-name="T18">Th</text:span><text:span text:style-name="T179">ē</text:span><text:span text:style-name="T18">bānus, Th</text:span><text:span text:style-name="T179">ē</text:span><text:span text:style-name="T18">bāna, Th</text:span><text:span text:style-name="T179">ē</text:span><text:span text:style-name="T18">bānum <text:s text:c="3"/></text:span><text:span text:style-name="T26">thebanisch</text:span><text:span text:style-name="T21">0</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T179">tribuere, tribuō, tribuī, tribūtum</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>schenken, zuteilen</text:span><text:span text:style-name="T21">50</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T18">trīstis, trīste</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>traurig, unfreundlich</text:span><text:span text:style-name="T21">33</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T18">verbum, verbī </text:span><text:span text:style-name="T90">n</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>das Wort, die Äußerung</text:span><text:span text:style-name="T21">11</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T16">vindicāre, vindicō, vindicāvī, vindicātum</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>beanspruchen, bestrafen; </text:span><text:span text:style-name="T18">in</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">m. Akk</text:span><text:span text:style-name="T26">. vorgehen gegen</text:span><text:span text:style-name="T21">56</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T174">vōbīs</text:span><text:span text:style-name="T173"> </text:span><text:span text:style-name="T176">Dat</text:span><text:span text:style-name="T173">. <text:s text:c="3"/></text:span><text:span text:style-name="T26">euch</text:span><text:span text:style-name="T21">13</text:span><text:span text:style-name="T26"> </text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T18"><text:span text:style-name="T24">vōs</text:span><text:span text:style-name="T18"> </text:span><text:span text:style-name="T90">Nom. / Akk.</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>ihr / euch</text:span><text:span text:style-name="T21">13</text:span></text:p>
