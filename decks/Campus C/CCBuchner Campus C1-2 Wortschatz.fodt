   <text:section text:style-name="Sect3" text:name="Bereich114">
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">amāre, amō, amāvī, amātum</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>lieben</text:span><text:span text:style-name="T21">8</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T174">Caesar, Caesaris </text:span><text:span text:style-name="T176">m</text:span><text:span text:style-name="T173"> <text:s text:c="3"/>Gajus Julius Cäsar </text:span><text:span text:style-name="T176">(röm. </text:span><text:span text:style-name="T90">Politiker, Feldherr und Schriftsteller, 100-44 v. Chr.)</text:span><text:span text:style-name="T21">51</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T174"><text:span text:style-name="T174">Augustus, Augustī </text:span><text:span text:style-name="T176">m</text:span><text:span text:style-name="T174"> <text:s text:c="3"/></text:span><text:span text:style-name="T173">Augustus (erster röm. Kaiser 27 v. Chr.– 14 n. Chr.)</text:span><text:span text:style-name="T181">63</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T18">clāmāre, clāmō, clāmāvī, clāmātum</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>laut rufen, schreien</text:span><text:span text:style-name="T21">13</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T18">dēlectāre, dēlectō, dēlectāvī, dēlectātum</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>erfreuen, unterhalten</text:span><text:span text:style-name="T21">8</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">esse, sum, fuī</text:span><text:span text:style-name="T18"> <text:s text:c="3"/></text:span><text:span text:style-name="T26">sein,</text:span><text:span text:style-name="T18"> </text:span><text:span text:style-name="T26">sich befinden</text:span><text:span text:style-name="T21">2. 25</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">fīlius, filiī</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">m <text:s text:c="3"/></text:span><text:span text:style-name="T26">der <text:s/>Sohn</text:span><text:span text:style-name="T21">9</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">hic, haec, hoc</text:span><text:span text:style-name="T18"> <text:s text:c="3"/></text:span><text:span text:style-name="T26">dieser, diese, dieses (hier); folgender</text:span><text:span text:style-name="T21">40</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T18"><text:span text:style-name="T18">idem, eadem, idem <text:s text:c="3"/></text:span><text:span text:style-name="T26">derselbe, der gleiche</text:span><text:span text:style-name="T21">42</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">ille, illa, illud</text:span><text:span text:style-name="T18"> <text:s text:c="3"/></text:span><text:span text:style-name="T26">jener, jene, jenes; der (dort); jener berühmte</text:span><text:span text:style-name="T21">40</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T180">ipse, ipsa, ipsum</text:span><text:span text:style-name="T26"> (</text:span><text:span text:style-name="T90">Gen</text:span><text:span text:style-name="T26">. </text:span><text:span text:style-name="T180">ipsīus</text:span><text:span text:style-name="T26">, </text:span><text:span text:style-name="T90">Dat</text:span><text:span text:style-name="T26">. </text:span><text:span text:style-name="T180">ipsī</text:span><text:span text:style-name="T26">) <text:s text:c="3"/>(er, sie, es) selbst; persönlich; gerade; sogar </text:span><text:span text:style-name="T90">(hervorhebend)</text:span><text:span text:style-name="T21">56</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T18"><text:span text:style-name="T24">is, ea, id</text:span><text:span text:style-name="T18"> <text:s text:c="3"/></text:span><text:span text:style-name="T26">dieser, diese, dieses; er, sie, es</text:span><text:span text:style-name="T21">26</text:span><text:span text:style-name="T18"> </text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T71"><text:span text:style-name="T221">iste, ista, istud</text:span><text:span text:style-name="T219"> (</text:span><text:span text:style-name="T220">Gen</text:span><text:span text:style-name="T219">. </text:span><text:span text:style-name="T221">istius</text:span><text:span text:style-name="T219">, </text:span><text:span text:style-name="T220">Dat</text:span><text:span text:style-name="T219">. </text:span><text:span text:style-name="T221">isti</text:span><text:span text:style-name="T219">)</text:span><text:span text:style-name="T213"> </text:span><text:span text:style-name="T71"><text:s text:c="3"/>dieser, diese, dieses (da)</text:span><text:span text:style-name="T79">60</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T18"><text:span text:style-name="T24">nam</text:span><text:span text:style-name="T18"> <text:s text:c="3"/></text:span><text:span text:style-name="T26">denn, nämlich</text:span><text:span text:style-name="T21">3</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T167"><text:span text:style-name="T18">nepos, nepotis </text:span><text:span text:style-name="T90">m <text:s text:c="3"/>der </text:span><text:span text:style-name="T26">Enkel</text:span><text:span text:style-name="T21">0</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T18"><text:span text:style-name="T16">Octāvius, Octāviī</text:span><text:span text:style-name="T18"> </text:span><text:span text:style-name="T90">m</text:span><text:span text:style-name="T18"> <text:s text:c="3"/></text:span><text:span text:style-name="T26">Octavius (der spätere Kaiser Augustus)</text:span><text:span text:style-name="T21">62</text:span><text:span text:style-name="T18"> </text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T18">postea </text:span><text:span text:style-name="T90">Adv</text:span><text:span text:style-name="T26">. <text:s text:c="3"/>nachher, später</text:span><text:span text:style-name="T21">26</text:span><text:span text:style-name="T26"> </text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T18">Rōmānus, Rōmāna, Rōmānum</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>römisch; </text:span><text:span text:style-name="T90">Subst</text:span><text:span text:style-name="T26">. der Römer, der Einwohner Roms</text:span><text:span text:style-name="T21">9. 14</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">salūs, salūtis</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">f</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>die Gesundheit, die Rettung, der Gruß, das Glück</text:span><text:span text:style-name="T21">25</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">servus, servī</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">m <text:s text:c="3"/></text:span><text:span text:style-name="T26">der Sklave, der Diener</text:span><text:span text:style-name="T21">1</text:span><text:span text:style-name="T26"> </text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">ut</text:span><text:span text:style-name="T18"> </text:span><text:span text:style-name="T90">Adv</text:span><text:span text:style-name="T26">. <text:s text:c="3"/>wie</text:span><text:span text:style-name="T21">10</text:span><text:span text:style-name="T26"> </text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">verbum, verbī</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">n</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>das Wort, die Äußerung</text:span><text:span text:style-name="T21">11</text:span><text:span text:style-name="T26"> </text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">vir, virī</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">m</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>der Mann</text:span><text:span text:style-name="T21">15</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">vocāre, vocō, vocāvī, vocātum</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>rufen; nennen, benennen</text:span><text:span text:style-name="T21">8</text:span></text:p>
