    <text:p text:style-name="P25" loext:marker-style-name="T43"><text:span text:style-name="T56">apertus, a, um</text:span><text:span text:style-name="T43"> <text:s text:c="3"/>offen, offenkundig</text:span><text:span text:style-name="T44">43</text:span><text:span text:style-name="T43"> </text:span></text:p>
