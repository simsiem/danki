    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">vīta, vītae</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">f</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>das Leben</text:span><text:span text:style-name="T21">15</text:span></text:p>
