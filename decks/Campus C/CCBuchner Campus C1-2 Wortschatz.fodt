    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T30">ferre, ferō, tulī, lātum</text:span><text:span text:style-name="T18"> <text:s text:c="3"/></text:span><text:span text:style-name="T26">bringen, tragen; ertragen</text:span><text:span text:style-name="T21">70</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T18"><text:span text:style-name="T18">forum, forī </text:span><text:span text:style-name="T90">n</text:span><text:span text:style-name="T18"> <text:s text:c="3"/></text:span><text:span text:style-name="T26">das</text:span><text:span text:style-name="T18"> </text:span><text:span text:style-name="T26">Forum, der Marktplatz</text:span><text:span text:style-name="T21">11</text:span></text:p>
