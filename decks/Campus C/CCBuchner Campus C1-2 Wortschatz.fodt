    <text:p text:style-name="P26" loext:marker-style-name="T43"><text:span text:style-name="T56">R</text:span><text:span text:style-name="T142">ō</text:span><text:span text:style-name="T56">m</text:span><text:span text:style-name="T142">ā</text:span><text:span text:style-name="T56">nus, a, um</text:span><text:span text:style-name="T43"> <text:s text:c="3"/>römisch; </text:span><text:span text:style-name="T55">Subst. </text:span><text:span text:style-name="T43">der</text:span><text:span text:style-name="T55"> </text:span><text:span text:style-name="T43">Römer, der Einwohner Roms</text:span><text:span text:style-name="T44">9. 14</text:span><text:span text:style-name="T43"> </text:span></text:p>
