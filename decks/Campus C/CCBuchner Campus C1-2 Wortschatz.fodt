    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">dum</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">Subj</text:span><text:span text:style-name="T26">. <text:s text:c="3"/>während </text:span><text:span text:style-name="T90">(m. Ind. Präs.)</text:span><text:span text:style-name="T26">, solange, bis</text:span><text:span text:style-name="T21">19</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">duo, duae, duo</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>zwei, beide</text:span><text:span text:style-name="T21">16</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">enim</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">(nachgestellt)</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>nämlich, denn</text:span><text:span text:style-name="T21">18</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T18"><text:span text:style-name="T24">esse, sum, fuī</text:span><text:span text:style-name="T18"> <text:s text:c="3"/></text:span><text:span text:style-name="T26">sein, sich befinden</text:span><text:span text:style-name="T21">2. 25</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T18"><text:span text:style-name="T24">et</text:span><text:span text:style-name="T18"> <text:s text:c="3"/></text:span><text:span text:style-name="T26">und, auch</text:span><text:span text:style-name="T21">1</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">facere, faciō, fēcī, factum</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>machen, tun, handeln</text:span><text:span text:style-name="T21">17. 27. 48</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T21"><text:span text:style-name="T18">fortasse</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>vielleicht</text:span><text:span text:style-name="T21">0</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T16">fundere, fundō, fūdī, fūsum</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>(aus)gießen, zerstreuen</text:span><text:span text:style-name="T21">50</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T18">fūr, fūris</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">m</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>der Dieb</text:span><text:span text:style-name="T21">19</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T30">genus, generis</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">n</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>die Abstammung, die Art, das Geschlecht</text:span><text:span text:style-name="T21">50</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">hic, haec, hoc</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>dieser, diese, dieses (hier); folgender</text:span><text:span text:style-name="T21">40</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T16">hostia, hostiae</text:span><text:span text:style-name="T18"> </text:span><text:span text:style-name="T90">f</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>das Opfertier, das Schlachtopfer</text:span><text:span text:style-name="T21">50</text:span></text:p>
