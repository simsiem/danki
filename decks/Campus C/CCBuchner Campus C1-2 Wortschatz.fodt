    <text:p text:style-name="P37" loext:marker-style-name="T193"><text:span text:style-name="T24">itaque </text:span><text:span text:style-name="T168">Adv.</text:span><text:span text:style-name="T18"> <text:s text:c="3"/></text:span><text:span text:style-name="T173">deshalb</text:span><text:span text:style-name="T181">5</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T173"><text:span text:style-name="T182">laudāre, laudō, laudāvī, laudātum</text:span><text:span text:style-name="T173"> <text:s text:c="3"/>loben</text:span><text:span text:style-name="T181">8</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T167"><text:span text:style-name="T24">magnus, magna, magnum</text:span><text:span text:style-name="T18"> <text:s text:c="3"/></text:span><text:span text:style-name="T26">groß, bedeutend</text:span><text:span text:style-name="T21">14</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T18"><text:span text:style-name="T24">multus, multa, multum</text:span><text:span text:style-name="T18"> <text:s text:c="3"/></text:span><text:span text:style-name="T26">viel</text:span><text:span text:style-name="T21">14</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T18">neglegere, neglegō, neglēxī, neglēctum</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>nicht (be)achten, vernachlässigen</text:span><text:span text:style-name="T21">41</text:span><text:span text:style-name="T23"> </text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T18"><text:span text:style-name="T24">omnis, omne</text:span><text:span text:style-name="T18"> <text:s text:c="3"/></text:span><text:span text:style-name="T26">jeder, ganz; </text:span><text:span text:style-name="T90">Pl</text:span><text:span text:style-name="T26">. alle</text:span><text:span text:style-name="T21">33</text:span><text:span text:style-name="T18"> </text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T21"><text:span text:style-name="T16">Orpheus, Orpheī</text:span><text:span text:style-name="T203"> </text:span><text:span text:style-name="T90">m</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>Orpheus (berühmter thrakischer Sänger)</text:span><text:span text:style-name="T21">57</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">quia</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">Subj.</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>weil</text:span><text:span text:style-name="T21">19</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">suus, sua, suum</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>sein, ihr</text:span><text:span text:style-name="T21">30</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">uxor, uxōris</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">f</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>die Ehefrau</text:span><text:span text:style-name="T21">18</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">vir, virī</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">m</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>der Mann</text:span><text:span text:style-name="T21">15</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">vōx, vōcis</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">f</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>die Stimme, die Äußerung, der Laut</text:span><text:span text:style-name="T21">25</text:span></text:p>
   </text:section>
   <text:section text:style-name="Sect2" text:name="Bereich91">
    <text:p text:style-name="P65" loext:marker-style-name="T173"/>
    <text:p text:style-name="P79" loext:marker-style-name="T173"><text:span text:style-name="T183">LEKTION 57. T, Seite 83 <text:s text:c="2"/></text:span></text:p>
    <text:p text:style-name="P68" loext:marker-style-name="T200"/>
   </text:section>
   <text:section text:style-name="Sect3" text:name="Bereich92">
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">ā / ab</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">Präp. m. Abl</text:span><text:span text:style-name="T26">. <text:s text:c="3"/>von, von ... her</text:span><text:span text:style-name="T21">16</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">accipere, accipiō, accēpī</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>erhalten, erfahren, annehmen</text:span><text:span text:style-name="T21">34</text:span><text:span text:style-name="T26">; <text:s text:c="3"/></text:span><text:span text:style-name="T90">hier</text:span><text:span text:style-name="T26">: akzeptieren</text:span><text:span text:style-name="T21">0</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T16">ācerbus, ācerba, ācerbum</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>bitter, grausam, rücksichtslos</text:span><text:span text:style-name="T21">57</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T18"><text:span text:style-name="T24">ad</text:span><text:span text:style-name="T18"> </text:span><text:span text:style-name="T90">Präp. m. Akk.</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>zu, bei, nach, an</text:span><text:span text:style-name="T21">12</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">adīre, adeō, adiī, aditum</text:span><text:span text:style-name="T18"> </text:span><text:span text:style-name="T90">m. Akk.</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>herantreten (an), bitten, aufsuchen</text:span><text:span text:style-name="T21">37</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">amāre, amō, amāvī, amātum</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>lieben</text:span><text:span text:style-name="T21">8</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T173"><text:span text:style-name="T182">amor, amōris</text:span><text:span text:style-name="T173"> </text:span><text:span text:style-name="T176">m <text:s text:c="2"/></text:span><text:span text:style-name="T173"><text:s/>Liebe</text:span><text:span text:style-name="T181">19</text:span><text:span text:style-name="T173"> </text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T174">animadvertere, animadvertō, animadvertī, </text:span><text:span text:style-name="T204">animadversum</text:span><text:span text:style-name="T173"> </text:span><text:span text:style-name="T176">m. AcI / Akk</text:span><text:span text:style-name="T173">. <text:s text:c="3"/></text:span><text:span text:style-name="T26">bemerken</text:span><text:span text:style-name="T21">29. 54</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T23"><text:span text:style-name="T180">at</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>aber, dagegen, jedoch</text:span><text:span text:style-name="T21">54</text:span><text:span text:style-name="T23"> </text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T18"><text:span text:style-name="T24">audīre, audiō, audīvī, audītum</text:span><text:span text:style-name="T18"> <text:s text:c="3"/></text:span><text:span text:style-name="T26">hören</text:span><text:span text:style-name="T21">10</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T18"><text:span text:style-name="T24">autem</text:span><text:span text:style-name="T18"> </text:span><text:span text:style-name="T90">(nachgestellt)</text:span><text:span text:style-name="T18"> <text:s text:c="3"/></text:span><text:span text:style-name="T26">aber, andererseits</text:span><text:span text:style-name="T21">15</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T18"><text:span text:style-name="T18">beātus, beāta, beātum <text:s text:c="3"/></text:span><text:span text:style-name="T26">glücklich, reich</text:span><text:span text:style-name="T21">36</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T18">campus, campī</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">m <text:s text:c="3"/></text:span><text:span text:style-name="T26">das Feld, freier Platz</text:span><text:span text:style-name="T21">1</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T179">cantāre, cantō, cantāvī, cantātum</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>singen, dichten</text:span><text:span text:style-name="T21">50</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T180">capere, capiō, cēpī, captum</text:span><text:span text:style-name="T18"> </text:span><text:span text:style-name="T26"><text:s text:c="3"/>fassen, nehmen, fangen; erobern</text:span><text:span text:style-name="T21">17. 27. 48</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T179">carmen, carminis</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">n</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>das Gedicht, das Lied</text:span><text:span text:style-name="T21">50</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T16">commovēre, commoveō, commōvī, commōtum</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>bewegen, veranlassen</text:span><text:span text:style-name="T21">57</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T16">condiciō, condiciōnis</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">f</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>die Bedingung, die Lage</text:span><text:span text:style-name="T21">57</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T16">coniūnx, coniugis</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">m/f</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>der Gatte, die Gattin</text:span><text:span text:style-name="T21">57</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T180">dare, dō, dedī, datum</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>geben</text:span><text:span text:style-name="T21">20. 28. 47</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T18">dēcernere, dēcernō, dēcrēvī</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>beschließen, entscheiden</text:span><text:span text:style-name="T21">39</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T18">dēscendere, dēscendō, dēscendī, dēscēnsum</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>herabsteigen</text:span><text:span text:style-name="T21">17. 27</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T18">dēsīderāre, dēsīderō, dēsīderāvī, dēsīderātum <text:s text:c="2"/></text:span><text:span text:style-name="T26"><text:s/>sich sehnen nach, vermissen</text:span><text:span text:style-name="T21">10</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T18">dēspērāre, dēspērō, dēspērāvī, dēspērātum <text:s text:c="2"/></text:span><text:span text:style-name="T26"><text:s/>die Hoffnung aufgeben, verzweifeln</text:span><text:span text:style-name="T21">31</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T18"><text:span text:style-name="T24">deus, deī</text:span><text:span text:style-name="T18"> </text:span><text:span text:style-name="T90">m</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>der Gott, die Gottheit</text:span><text:span text:style-name="T21">6</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">diū</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">Adv.</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>lange (Zeit)</text:span><text:span text:style-name="T21">7</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T18">dulcis, dulce</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>angenehm, süß</text:span><text:span text:style-name="T21">33</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T171"><text:span text:style-name="T24">ē / ex </text:span><text:span text:style-name="T168">Präp. m. Abl. <text:s text:c="2"/></text:span><text:span text:style-name="T171"><text:s/>aus, von ... her</text:span><text:span text:style-name="T170">12</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T18">ēdūcere, ēdūcō, ēdūxī, ēductum</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>herausführen</text:span><text:span text:style-name="T21">23</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T18"><text:span text:style-name="T24">enim</text:span><text:span text:style-name="T18"> </text:span><text:span text:style-name="T90">(nachgestellt)</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>nämlich, denn</text:span><text:span text:style-name="T21">18</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">esse, sum, fuī</text:span><text:span text:style-name="T18"> <text:s text:c="3"/></text:span><text:span text:style-name="T26">sein,</text:span><text:span text:style-name="T18"> </text:span><text:span text:style-name="T26">sich befinden</text:span><text:span text:style-name="T21">2. 25</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T18"><text:span text:style-name="T24">et</text:span><text:span text:style-name="T18"> <text:s text:c="3"/></text:span><text:span text:style-name="T26">und, auch</text:span><text:span text:style-name="T21">1</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T167"><text:span text:style-name="T24">etiam</text:span><text:span text:style-name="T18"> <text:s text:c="3"/></text:span><text:span text:style-name="T26">auch, sogar</text:span><text:span text:style-name="T21">5</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T16">Eurydica, Eurydicae</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">f </text:span><text:span text:style-name="T26"><text:s text:c="3"/>Eurydike (die Gattin des Orpheus)</text:span><text:span text:style-name="T21">57</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T16">flectere, flectō, flexī, flexum</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>biegen, (hin)lenken, umstimmen</text:span><text:span text:style-name="T21">57</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">fortūna, fortūnae</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">f</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>das Schicksal, das Glück</text:span><text:span text:style-name="T21">35</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">hic, haec, hoc</text:span><text:span text:style-name="T18"> <text:s text:c="3"/></text:span><text:span text:style-name="T26">dieser, diese, dieses (hier); folgender</text:span><text:span text:style-name="T21">40</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T18"><text:span text:style-name="T24">iam</text:span><text:span text:style-name="T18"> </text:span><text:span text:style-name="T90">Adv.</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>schon, bereits; nun</text:span><text:span text:style-name="T21">4</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">ille, illa, illud</text:span><text:span text:style-name="T18"> <text:s text:c="3"/></text:span><text:span text:style-name="T26">jener, jene, jenes; der (dort); jener berühmte</text:span><text:span text:style-name="T21">40</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T180"><text:span text:style-name="T180">in </text:span><text:span text:style-name="T185">Präp. m. Abl</text:span><text:span text:style-name="T186">. <text:s text:c="3"/>in, an, auf, bei (wo?)</text:span><text:span text:style-name="T187">12</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T188"><text:span text:style-name="T180">in </text:span><text:span text:style-name="T185">Präp. m. Akk</text:span><text:span text:style-name="T186">. <text:s text:c="3"/>in (... hinein), nach (wohin?)</text:span><text:span text:style-name="T187">12</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T180">interficere, interficiō, interfēcī, interfectum</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>töten, vernichten</text:span><text:span text:style-name="T21">22. 27. 49</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T18"><text:span text:style-name="T24">is, ea, id</text:span><text:span text:style-name="T18"> <text:s text:c="3"/></text:span><text:span text:style-name="T26">dieser, diese, dieses; er, sie, es</text:span><text:span text:style-name="T21">26</text:span><text:span text:style-name="T18"> </text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T18">iterum </text:span><text:span text:style-name="T90">Adv.</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>wiederum, zum zweiten Mal</text:span><text:span text:style-name="T21">5</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T30">iubēre, iubeō, iussī, iussum</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">m. Akk</text:span><text:span text:style-name="T26">. <text:s text:c="3"/>anordnen, befehlen</text:span><text:span text:style-name="T21">57</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">lūx, lūcis</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">f</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>das Licht, das Tageslicht</text:span><text:span text:style-name="T21">25</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T18">marītus, marītī </text:span><text:span text:style-name="T90">m <text:s text:c="3"/></text:span><text:span text:style-name="T26">der Ehemann</text:span><text:span text:style-name="T21">30</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T18">Mercurius, Mercuriī</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">m <text:s text:c="2"/></text:span><text:span text:style-name="T26"><text:s/>Merkur (Götterbote)</text:span><text:span text:style-name="T21">21</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T18">mihi</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">Dat</text:span><text:span text:style-name="T26">. <text:s text:c="3"/>mir</text:span><text:span text:style-name="T21">13</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T179">monēre, moneō, monuī, monitum</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>mahnen, ermahnen</text:span><text:span text:style-name="T21">2. 47</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T23"><text:span text:style-name="T179">mortālis, mortāle</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>sterblich; </text:span><text:span text:style-name="T90">Subst</text:span><text:span text:style-name="T26">. der Mensch</text:span><text:span text:style-name="T21">55</text:span><text:span text:style-name="T23"> </text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T18">mox</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">Adv.</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>bald</text:span><text:span text:style-name="T21">7</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T18"><text:span text:style-name="T24">nam</text:span><text:span text:style-name="T18"> <text:s text:c="3"/></text:span><text:span text:style-name="T26">denn, nämlich</text:span><text:span text:style-name="T21">3</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">nōn</text:span><text:span text:style-name="T18"> <text:s text:c="3"/></text:span><text:span text:style-name="T26">nicht</text:span><text:span text:style-name="T21">2</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T18"><text:span text:style-name="T18">nūntius, nūntiī <text:s text:c="3"/></text:span><text:span text:style-name="T26">der Bote, die Nachricht</text:span><text:span text:style-name="T21">16</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T16">nūbere, nūbō, nūpsī, nūptum</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">m. Dat</text:span><text:span text:style-name="T26">. <text:s text:c="3"/>heiraten</text:span><text:span text:style-name="T21">57</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">oculus, oculī</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">m</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>das Auge</text:span><text:span text:style-name="T21">2</text:span><text:span text:style-name="T26"> </text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T21"><text:soft-page-break/><text:span text:style-name="T16">Orpheus, Orpheī</text:span><text:span text:style-name="T203"> </text:span><text:span text:style-name="T90">m</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>Orpheus (berühmter thrakischer Sänger)</text:span><text:span text:style-name="T21">57</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T18"><text:span text:style-name="T179">paene</text:span><text:span text:style-name="T18"> </text:span><text:span text:style-name="T90">Adv.</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>fast</text:span><text:span text:style-name="T21">46</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T179">pectus, pectoris</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">n</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>die Brust, das Herz</text:span><text:span text:style-name="T21">49</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T180">pēs, pedis</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">m <text:s text:c="2"/></text:span><text:span text:style-name="T26"><text:s/>der </text:span><text:span text:style-name="T90">Fuß (als Längenmaß: ca. 30 cm)</text:span><text:span text:style-name="T21">50</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T16">perdere, perdō, perdidī, perditum</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>verlieren, verschwenden, zugrunde richten</text:span><text:span text:style-name="T21">57</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T18"><text:span text:style-name="T24">petere, petō, petīvī <text:s text:c="3"/></text:span><text:span text:style-name="T26">aufsuchen, (er)streben, bitten, verlangen</text:span><text:span text:style-name="T21">18. 29</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T18">Plūtō, Plūtōnis <text:s/></text:span><text:span text:style-name="T90">m</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>Pluto (griech. Hades; Gott der Unterwelt.)</text:span><text:span text:style-name="T21">28.XIX</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T18"><text:span text:style-name="T24">posse, possum, potuī</text:span><text:span text:style-name="T18"> <text:s text:c="3"/></text:span><text:span text:style-name="T26">können</text:span><text:span text:style-name="T21">17. 25</text:span><text:span text:style-name="T18"> </text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T18"><text:span text:style-name="T18">profectō </text:span><text:span text:style-name="T90">Adv.</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>sicherlich, tatsächlich</text:span><text:span text:style-name="T21">6</text:span><text:span text:style-name="T18"> </text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T21"><text:span text:style-name="T24">reddere, reddō, reddidī, redditum</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>zurückgeben, etw. zukommen lassen; </text:span><text:span text:style-name="T90">m. dopp. Akk.</text:span><text:span text:style-name="T26"> jdn. zu etw. machen</text:span><text:span text:style-name="T21">0</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">redīre, redeō, rediī, reditum</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>zurückgehen, zurückkehren</text:span><text:span text:style-name="T21">37</text:span><text:span text:style-name="T26"> </text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T16">redūcere, redūcō, redūxī, reductum</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>zurückführen, zurückziehen</text:span><text:span text:style-name="T21">57</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T16">respicere, respiciō, respexī, respectum</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>zurückblicken, berücksichtigen</text:span><text:span text:style-name="T21">57</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">rēx, rēgis</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">m</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>der König</text:span><text:span text:style-name="T21">27</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T18"><text:span text:style-name="T24">sed</text:span><text:span text:style-name="T18"> <text:s text:c="3"/></text:span><text:span text:style-name="T26">aber, sondern</text:span><text:span text:style-name="T21">3</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T21"><text:span text:style-name="T18">serp</text:span><text:span text:style-name="T179">ē</text:span><text:span text:style-name="T18">ns, serpentis</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">m/f </text:span><text:span text:style-name="T26"><text:s text:c="3"/>die Schlange</text:span><text:span text:style-name="T21">0</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T30">simul</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">Adv</text:span><text:span text:style-name="T26">. <text:s text:c="3"/>gleichzeitig, zugleich</text:span><text:span text:style-name="T21">57</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">sōl, sōlis</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">m</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>die Sonne</text:span><text:span text:style-name="T21">23</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T18"><text:span text:style-name="T24">sōlum</text:span><text:span text:style-name="T18"> </text:span><text:span text:style-name="T90">Adv</text:span><text:span text:style-name="T26">. <text:s text:c="3"/>nur</text:span><text:span text:style-name="T21">21</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T18">statim</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">Adv</text:span><text:span text:style-name="T26">. <text:s text:c="3"/>sofort</text:span><text:span text:style-name="T21">5</text:span><text:span text:style-name="T26"> </text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T180">superī, superōrum</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">m Pl</text:span><text:span text:style-name="T26">. <text:s text:c="3"/>die Götter</text:span><text:span text:style-name="T21">56</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T18">tangere, tangō, tetigī, </text:span><text:span text:style-name="T16">tāctum</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>berühren</text:span><text:span text:style-name="T21">43. 54</text:span><text:span text:style-name="T26"> </text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T18">Tartarus, Tartarī</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">m <text:s text:c="3"/></text:span><text:span text:style-name="T26">der </text:span><text:span text:style-name="T71">Tartarus</text:span><text:span text:style-name="T26"> (der Teil der Unterwelt, in dem Verbrecher und Übeltäter nach dem Tod ihre Strafen verbüßen mussten)</text:span><text:span text:style-name="T21">21. 28. 57</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T18">tē</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">Akk</text:span><text:span text:style-name="T26">. <text:s text:c="3"/>dich</text:span><text:span text:style-name="T21">13</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T18">tenebrae, tenebrārum</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">f Pl.</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>die Dunkelheit, die Finsternis</text:span><text:span text:style-name="T21">26</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">tōtus, tōta, tōtum</text:span><text:span text:style-name="T18"> </text:span><text:span text:style-name="T90">(Gen.</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T24">tōtīus</text:span><text:span text:style-name="T26">, </text:span><text:span text:style-name="T90">Dat.</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T24">tōtī</text:span><text:span text:style-name="T90">)</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>ganz, gesamt</text:span><text:span text:style-name="T21">40</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T16">tribuere, tribuō, tribuī, tribūtum</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>schenken, zuteilen</text:span><text:span text:style-name="T21">50. 57</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T18">trīstis, trīste</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>traurig, unfreundlich</text:span><text:span text:style-name="T21">33</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T18">tū</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">Nom</text:span><text:span text:style-name="T26">. <text:s text:c="3"/>du (betont)</text:span><text:span text:style-name="T21">13</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T18">umbra, umbrae</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">f <text:s text:c="2"/></text:span><text:span text:style-name="T26"><text:s/>der Schatten</text:span><text:span text:style-name="T21">12</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">uxor, uxōris</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">f</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>die Ehefrau</text:span><text:span text:style-name="T21">18</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T18">venia, veniae </text:span><text:span text:style-name="T90">f <text:s text:c="2"/></text:span><text:span text:style-name="T26"><text:s/>der Gefallen; die Nachsicht, die Verzeihung</text:span><text:span text:style-name="T21">31</text:span><text:span text:style-name="T26"> </text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T18">vertere, vertō, vertī, versum</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>drehen, wenden</text:span><text:span text:style-name="T21">27</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T16">vetāre, vetō, vetuī, vetitum</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">m. Akk</text:span><text:span text:style-name="T26">. <text:s text:c="3"/>verbieten</text:span><text:span text:style-name="T21">57</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">vōx, vōcis</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">f</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>die Stimme, die Äußerung, der Laut</text:span><text:span text:style-name="T21">25</text:span></text:p>
   </text:section>
