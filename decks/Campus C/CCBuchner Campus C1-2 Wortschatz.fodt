    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">tantus, tanta, tantum</text:span><text:span text:style-name="T18"> <text:s text:c="3"/></text:span><text:span text:style-name="T26">so groß, so viel</text:span><text:span text:style-name="T21">18</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T18">tegere, tegō, tēxī, tēctum <text:s text:c="2"/></text:span><text:span text:style-name="T26"><text:s/>bedecken, schützen, verbergen</text:span><text:span text:style-name="T21">39</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T18"><text:span text:style-name="T30">tēlum, tēlī</text:span><text:span text:style-name="T18"> </text:span><text:span text:style-name="T90">n <text:s text:c="2"/></text:span><text:span text:style-name="T18"><text:s/></text:span><text:span text:style-name="T26">die</text:span><text:span text:style-name="T18"> </text:span><text:span text:style-name="T26">(Angriffs-)Waffe, das Geschoss</text:span><text:span text:style-name="T21">65</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T18">trīstis, trīste</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>traurig, unfreundlich</text:span><text:span text:style-name="T21">33</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">ut</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">Adv</text:span><text:span text:style-name="T26">. <text:s text:c="3"/>wie</text:span><text:span text:style-name="T21">10</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T180">ut</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">Subj. m. Konj</text:span><text:span text:style-name="T26">. <text:s text:c="3"/>dass, sodass; </text:span><text:span text:style-name="T234">damit, um zu </text:span><text:span text:style-name="T233">m. Inf</text:span><text:span text:style-name="T234">.</text:span><text:span text:style-name="T21">45. 59</text:span></text:p>
   </text:section>
   <text:section text:style-name="Sect2" text:name="Bereich131">
    <text:p text:style-name="P53" loext:marker-style-name="T183"/>
