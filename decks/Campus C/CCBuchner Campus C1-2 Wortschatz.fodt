   <text:section text:style-name="Sect3" text:name="Bereich132">
    <text:p text:style-name="P37" loext:marker-style-name="T18"><text:span text:style-name="T24">ā / ab</text:span><text:span text:style-name="T18"> </text:span><text:span text:style-name="T90">Präp. m. Abl.</text:span><text:span text:style-name="T18"> <text:s text:c="3"/></text:span><text:span text:style-name="T26">von, von ... her</text:span><text:span text:style-name="T21">16</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T18"><text:span text:style-name="T24">ad</text:span><text:span text:style-name="T18"> </text:span><text:span text:style-name="T90">Präp. m. Akk.</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>zu, bei, nach, an</text:span><text:span text:style-name="T21">12</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T193"><text:span text:style-name="T174">Aenēis, Aenēidis </text:span><text:span text:style-name="T176">m</text:span><text:span text:style-name="T174"> <text:s text:c="3"/></text:span><text:span text:style-name="T173">vgl. </text:span><text:span text:style-name="T199">V</text:span><text:span text:style-name="T173"> a</text:span><text:span text:style-name="T181">0</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">animus, animī</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">m</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>der Geist, der Mut, die Gesinnung</text:span><text:span text:style-name="T21">19</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T180">appellāre, appellō, appellāvī, appellātum</text:span><text:span text:style-name="T203"> </text:span><text:span text:style-name="T26"><text:s text:c="3"/>anrufen, anreden; </text:span><text:span text:style-name="T90">m. dopp. Akk</text:span><text:span text:style-name="T26">. nennen</text:span><text:span text:style-name="T21">56</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T174"><text:span text:style-name="T174">Augustus, Augustī </text:span><text:span text:style-name="T176">m</text:span><text:span text:style-name="T174"> <text:s text:c="3"/></text:span><text:span text:style-name="T173">Augustus (erster röm. Kaiser 27 v. Chr.– 14 n. Chr.)</text:span><text:span text:style-name="T181">63</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">bene</text:span><text:span text:style-name="T18"> </text:span><text:span text:style-name="T90">Adv.</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>gut</text:span><text:span text:style-name="T21">4</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T179">commovēre, commoveō, commōvī, commōtum</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>bewegen, veranlassen</text:span><text:span text:style-name="T21">57</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T18">condere, condō, condidī, </text:span><text:span text:style-name="T179">conditum</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>verwahren, verbergen; erbauen, gründen</text:span><text:span text:style-name="T21">34. 55</text:span><text:span text:style-name="T23"> </text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">cōnsilium, consiliī</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">n</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>die Beratung, der Beschluss, der Plan, der Rat</text:span><text:span text:style-name="T21">11</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T180">corpus, corporis</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">n</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>der Körper, der Leichnam</text:span><text:span text:style-name="T21">49</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T71"><text:span text:style-name="T235">cum</text:span><text:span text:style-name="T71"> </text:span><text:span text:style-name="T74">Subj. m. Konj</text:span><text:span text:style-name="T71">. <text:s text:c="3"/>als, nachdem; weil; obwohl</text:span><text:span text:style-name="T79">61</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">cūra, cūrae</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">f</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>die Pflege, die Sorge</text:span><text:span text:style-name="T21">36</text:span><text:span text:style-name="T26"> </text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">dē</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">Präp. m. Abl</text:span><text:span text:style-name="T26">. <text:s text:c="3"/>von, von ... her, von ... weg, von ... herab; über</text:span><text:span text:style-name="T21">14</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T18"><text:span text:style-name="T24">enim</text:span><text:span text:style-name="T18"> </text:span><text:span text:style-name="T90">(nachgestellt)</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>nämlich, denn</text:span><text:span text:style-name="T21">18</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">esse, sum, fuī</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>sein, sich befinden</text:span><text:span text:style-name="T21">2. 25</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">et</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>und, auch</text:span><text:span text:style-name="T21">1</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T167"><text:span text:style-name="T24">etiam</text:span><text:span text:style-name="T18"> <text:s text:c="3"/></text:span><text:span text:style-name="T26">auch, sogar</text:span><text:span text:style-name="T21">5</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T23"><text:span text:style-name="T24">fīlia, fīliae</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">f</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>die Tochter</text:span><text:span text:style-name="T21">7</text:span><text:span text:style-name="T23"> </text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">fīlius, filiī</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">m <text:s text:c="3"/></text:span><text:span text:style-name="T26">der <text:s/>Sohn</text:span><text:span text:style-name="T21">9</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">fortūna, fortūnae</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">f</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>das Schicksal, das Glück</text:span><text:span text:style-name="T21">35</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">honor, honōris</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">m</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>die Ehre, das Ehrenamt</text:span><text:span text:style-name="T21">18</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">in</text:span><text:span text:style-name="T18"> </text:span><text:span text:style-name="T90">Präp. m. Abl</text:span><text:span text:style-name="T26">. <text:s text:c="3"/>in, an, auf, bei (wo?)</text:span><text:span text:style-name="T21">12</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T18">inānis, ināne</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>leer, wertlos</text:span><text:span text:style-name="T21">35</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T18">īnfēlīx, īnfēlīcis <text:s text:c="3"/></text:span><text:span text:style-name="T26">unglücklich</text:span><text:span text:style-name="T21">65</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T18"><text:span text:style-name="T24">is, ea, id</text:span><text:span text:style-name="T18"> <text:s text:c="3"/></text:span><text:span text:style-name="T26">dieser, diese, dieses; er, sie, es</text:span><text:span text:style-name="T21">26</text:span><text:span text:style-name="T18"> </text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T18">Iulia, Iuliae </text:span><text:span text:style-name="T90">f <text:s text:c="3"/></text:span><text:span text:style-name="T26">Eigenname, Tochter des Augustus</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T180">iubēre, iubeō, iussī, iussum</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">m. Akk</text:span><text:span text:style-name="T26">. <text:s text:c="3"/>anordnen, befehlen</text:span><text:span text:style-name="T21">57</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T18">iuvenis, iuvenis</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">m</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>junger Mann; </text:span><text:span text:style-name="T90">Adj</text:span><text:span text:style-name="T26">. jung</text:span><text:span text:style-name="T21">32</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T179">laetus, laeta, laetum</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>froh; fruchtbar</text:span><text:span text:style-name="T21">52</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T18"><text:span text:style-name="T18">Mārcellus, Mārcellī </text:span><text:span text:style-name="T90">m</text:span><text:span text:style-name="T18"> <text:s text:c="3"/></text:span><text:span text:style-name="T26">Marcellus (Sohn der Octavia, Neffe des Augustus)</text:span><text:span text:style-name="T21">XXIII</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">māter, mātris</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">f</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>die Mutter</text:span><text:span text:style-name="T21">20</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T167"><text:span text:style-name="T18">Mausōlēum, Mausōleī <text:s text:c="3"/></text:span><text:span text:style-name="T26">vgl. </text:span><text:span text:style-name="T237">V</text:span><text:span text:style-name="T26"> a</text:span><text:span text:style-name="T21">0</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">mors, mortis</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">f (Gen. Pl</text:span><text:span text:style-name="T26">. </text:span><text:span text:style-name="T24">-ium</text:span><text:span text:style-name="T90">)</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>der Tod</text:span><text:span text:style-name="T21">22</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T18">mortuus, mortua,mortuum</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>gestorben, tot; </text:span><text:span text:style-name="T90">Subst</text:span><text:span text:style-name="T26">. der Tote</text:span><text:span text:style-name="T21">21</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T18"><text:span text:style-name="T24">multus, multa, multum</text:span><text:span text:style-name="T18"> <text:s text:c="3"/></text:span><text:span text:style-name="T26">viel</text:span><text:span text:style-name="T21">14</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T18">mūtāre, mūtō, mūtāvī, mūtātum</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>(ver)ändern, verwandeln</text:span><text:span text:style-name="T21">41</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T23"><text:span text:style-name="T180">nōmen, nōminis</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">n</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>der Name</text:span><text:span text:style-name="T21">49</text:span><text:span text:style-name="T23"> </text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">nōn</text:span><text:span text:style-name="T18"> <text:s text:c="3"/></text:span><text:span text:style-name="T26">nicht</text:span><text:span text:style-name="T21">2</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T179">nūbere, nūbō, nūpsī, nūptum</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">m. Dat</text:span><text:span text:style-name="T26">. <text:s text:c="3"/>heiraten</text:span><text:span text:style-name="T21">57</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T173"><text:span text:style-name="T174">Octāvia, Octāviae </text:span><text:span text:style-name="T176">f</text:span><text:span text:style-name="T174"> <text:s text:c="3"/></text:span><text:span text:style-name="T173">Octavia (Schwester des Augustus)</text:span><text:span text:style-name="T181">XXIII</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T170"><text:span text:style-name="T24">parāre, parō, parāvī, parātum <text:s text:c="3"/></text:span><text:span text:style-name="T171">(vor)bereiten, vorhaben </text:span><text:span text:style-name="T168">m. Inf</text:span><text:span text:style-name="T171">.; erwerben</text:span><text:span text:style-name="T170">8</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T204">pertinēre, pertineō</text:span><text:span text:style-name="T238"> </text:span><text:span text:style-name="T204">ad</text:span><text:span text:style-name="T173"> </text:span><text:span text:style-name="T176">m. Akk</text:span><text:span text:style-name="T173">. <text:s text:c="3"/></text:span><text:span text:style-name="T26">betreffen, gehören (zu), sich erstrecken (bis)</text:span><text:span text:style-name="T21">52</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">populus, populī</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">m</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>das Volk</text:span><text:span text:style-name="T21">6</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T18"><text:span text:style-name="T24">posse, possum, potuī</text:span><text:span text:style-name="T18"> <text:s text:c="3"/></text:span><text:span text:style-name="T26">können</text:span><text:span text:style-name="T21">17. 25</text:span><text:span text:style-name="T18"> </text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T18">praesēns, praesentis <text:s text:c="3"/></text:span><text:span text:style-name="T26">anwesend, gegenwärtig</text:span><text:span text:style-name="T21">60</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T180">prīnceps, prīncipis</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>der erste, der führende; Subst. Erster, führender Mann, Kaiser</text:span><text:span text:style-name="T21">63</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T179">prōvidēre, prōvideō, prōvīdī, prōvīsum</text:span><text:span text:style-name="T26"> <text:s text:c="3"/></text:span><text:span text:style-name="T90">m. Akk</text:span><text:span text:style-name="T26">. vorhersehen; </text:span><text:span text:style-name="T90">m. Dat.</text:span><text:span text:style-name="T26"> sorgen für</text:span><text:span text:style-name="T21">53</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">putāre, putō, putāvī, putātum</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>glauben, meinen</text:span><text:span text:style-name="T21">29</text:span></text:p>
