    <text:p text:style-name="P25" loext:marker-style-name="T40"><text:span text:style-name="T140">Hamilcar, Hamilcaris</text:span><text:span text:style-name="T40"> </text:span><text:span text:style-name="T39">m <text:s text:c="2"/></text:span><text:span text:style-name="T40">Hamilkar </text:span><text:span text:style-name="T39">(Vater Hannibals)</text:span><text:span text:style-name="T37">43</text:span><text:span text:style-name="T40"> </text:span><text:span text:style-name="T43"><text:s/></text:span></text:p>
    <text:p text:style-name="P25" loext:marker-style-name="T40"><text:span text:style-name="T32">hostis, hostis</text:span><text:span text:style-name="T33"> </text:span><text:span text:style-name="T39">m (Gen. Pl. </text:span><text:span text:style-name="T40">-ium</text:span><text:span text:style-name="T39">) <text:s text:c="3"/></text:span><text:span text:style-name="T40">der Feind (Landesfeind)</text:span><text:span text:style-name="T37">35</text:span><text:span text:style-name="T40"> </text:span><text:span text:style-name="T43"><text:s/></text:span></text:p>
