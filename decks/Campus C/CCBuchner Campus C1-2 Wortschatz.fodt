    <text:p text:style-name="P37" loext:marker-style-name="T21"><text:span text:style-name="T18">quin? </text:span><text:span text:style-name="T90">(im Hauptsatz)</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>warum nicht? <text:s text:c="3"/></text:span><text:span text:style-name="T90">Subj. m. Konj.</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">(in festen Wendungen)</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>dass</text:span><text:span text:style-name="T21">17. 68</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">quoque</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">(nachgestellt)</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>auch</text:span><text:span text:style-name="T21">45</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">rēs pūblica, reī pūblicae</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">f</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>der Staat</text:span><text:span text:style-name="T21">41</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T18">Rōmānus, Rōmāna, Rōmānum</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>römisch; </text:span><text:span text:style-name="T90">Subst</text:span><text:span text:style-name="T26">. Römer, Einwohner Roms</text:span><text:span text:style-name="T21">9. 14</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T18"><text:span text:style-name="T24">scīre, sciō, scīvī, scītum</text:span><text:span text:style-name="T18"> <text:s text:c="3"/></text:span><text:span text:style-name="T26">wissen, kennen, verstehen</text:span><text:span text:style-name="T21">10</text:span><text:span text:style-name="T18"> </text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">scrībere, scrībō, scrīpsī, scrīptum</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>schreiben, beschreiben</text:span><text:span text:style-name="T21">16. 34</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T18"><text:span text:style-name="T24">sed</text:span><text:span text:style-name="T18"> <text:s text:c="3"/></text:span><text:span text:style-name="T26">aber, sondern</text:span><text:span text:style-name="T21">3</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">sine</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">Präp. m. Abl</text:span><text:span text:style-name="T26">. <text:s text:c="3"/>ohne</text:span><text:span text:style-name="T21">12</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T71"><text:span text:style-name="T80">superbia, superbiae </text:span><text:span text:style-name="T74">f</text:span><text:span text:style-name="T71"> <text:s text:c="3"/>der Stolz, der Hochmut</text:span><text:span text:style-name="T79">9</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">tantum</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">Adv. (nachgestellt)</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>nur</text:span><text:span text:style-name="T21">5</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T26">(P. Quinctilius)</text:span><text:span text:style-name="T18"> Vārus, Vārī </text:span><text:span text:style-name="T90">m</text:span><text:span text:style-name="T18"> <text:s text:c="3"/></text:span><text:span text:style-name="T26">Varus (Feldherr des röm. Kaisers Augustus; verlor 9 n. Chr. die Schlacht im Teutoburger Wald, nachdem er vom Cheruskerfürsten Arminius in einen Hinterhalt gelockt worden war)</text:span><text:span text:style-name="T21">68. XXIV. 69</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T218"><text:span text:style-name="T93">vincere, vincō, vīcī, victum</text:span><text:span text:style-name="T71"> <text:s text:c="3"/>(be)siegen, übertreffen</text:span><text:span text:style-name="T79">27. </text:span><text:span text:style-name="T218">48</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T179">vindicāre, vindicō, vindicāvī, vindicātum</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>beanspruchen, bestrafen; </text:span><text:span text:style-name="T18">in</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">m. Akk</text:span><text:span text:style-name="T26">. vorgehen gegen</text:span><text:span text:style-name="T21">56</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T71"><text:span text:style-name="T24">vīvere, vīvō, vīxī</text:span><text:span text:style-name="T71"> <text:s text:c="3"/>leben</text:span><text:span text:style-name="T79">30</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">vocāre, vocō, vocāvī, vocātum</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>rufen; nennen, benennen</text:span><text:span text:style-name="T21">8</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T18"><text:span text:style-name="T24">vōs</text:span><text:span text:style-name="T18"> </text:span><text:span text:style-name="T90">Nom. / Akk.</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>ihr / euch</text:span><text:span text:style-name="T21">13</text:span></text:p>
