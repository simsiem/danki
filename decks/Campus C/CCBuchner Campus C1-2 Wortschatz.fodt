    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">prohibēre, prohibeō, prohibuī, prohibitum (ā)</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">m. Abl</text:span><text:span text:style-name="T26">. <text:s text:c="3"/>abhalten (von), hindern (an)</text:span><text:span text:style-name="T21">28</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">puer, puerī</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">m</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>der Junge, der Bub</text:span><text:span text:style-name="T21">15</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">quī, quae, quod</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>der, die, das</text:span><text:span text:style-name="T21">34</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">respondēre, respondeō, respondī <text:s text:c="2"/></text:span><text:span text:style-name="T26">antworten</text:span><text:span text:style-name="T21">3.34</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T16">retinēre, retineō, retinuī, retentum</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>zurückhalten, festhalten, behalten</text:span><text:span text:style-name="T21">55</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T18"><text:span text:style-name="T24">sed</text:span><text:span text:style-name="T18"> <text:s text:c="3"/></text:span><text:span text:style-name="T26">aber, sondern</text:span><text:span text:style-name="T21">3</text:span></text:p>
