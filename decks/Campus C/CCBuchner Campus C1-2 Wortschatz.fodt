    <text:p text:style-name="P37" loext:marker-style-name="T71"><text:span text:style-name="T231">restituere, restituō, restituī, restitūtum</text:span><text:span text:style-name="T71"> <text:s text:c="3"/>wiederherstellen</text:span><text:span text:style-name="T79">61</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T173"><text:span text:style-name="T174">Rōma, Rōmae</text:span><text:span text:style-name="T173"> </text:span><text:span text:style-name="T176">f</text:span><text:span text:style-name="T173"> <text:s text:c="2"/>Rom</text:span><text:span text:style-name="T181">7</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T18"><text:span text:style-name="T16">rūs, rūris</text:span><text:span text:style-name="T18"> </text:span><text:span text:style-name="T90">n</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>das Feld, das Land </text:span><text:span text:style-name="T90">(im Gegensatz zu Stadt)</text:span><text:span text:style-name="T26">, das Landgut</text:span><text:span text:style-name="T21">64</text:span></text:p>
