   <text:section text:style-name="Sect3" text:name="Bereich98">
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">ā / ab</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">Präp. m. Abl</text:span><text:span text:style-name="T26">. <text:s text:c="3"/>von, von ... her</text:span><text:span text:style-name="T21">16</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T18"><text:span text:style-name="T18">ācer, ācris, ācre <text:s text:c="3"/></text:span><text:span text:style-name="T26">energisch, heftig, scharf</text:span><text:span text:style-name="T21">32</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">amor, amōris</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">m</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>Liebe</text:span><text:span text:style-name="T21">19</text:span><text:span text:style-name="T26"> </text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T21"><text:span text:style-name="T179">amore capi</text:span><text:span text:style-name="T18"> <text:s text:c="3"/></text:span><text:span text:style-name="T26">von Liebe ergriffen werden</text:span><text:span text:style-name="T21">54</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T174">animadvertere, animadvertō, animadvertī, </text:span><text:span text:style-name="T204">animadversum</text:span><text:span text:style-name="T173"> </text:span><text:span text:style-name="T176">m. AcI / Akk</text:span><text:span text:style-name="T173">. <text:s text:c="3"/></text:span><text:span text:style-name="T26">bemerken</text:span><text:span text:style-name="T21">29. 54</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T18">Ariadna</text:span><text:span text:style-name="T26">, </text:span><text:span text:style-name="T18">Ariadnae </text:span><text:span text:style-name="T90">f <text:s text:c="2"/></text:span><text:span text:style-name="T26"><text:s/>Ariadne (Tochter des Königs Minos; half Theseus mit dem roten Faden bei der Überwindung des Minotaurus)</text:span><text:span text:style-name="T21">XX</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T18">Athēniēnsis, Athēniēnsis</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">m </text:span><text:span text:style-name="T26"><text:s text:c="3"/>der Athener</text:span><text:span text:style-name="T21">0</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T18"><text:span text:style-name="T24">autem</text:span><text:span text:style-name="T18"> </text:span><text:span text:style-name="T90">(nachgestellt)</text:span><text:span text:style-name="T18"> <text:s text:c="3"/></text:span><text:span text:style-name="T26">aber, andererseits</text:span><text:span text:style-name="T21">15</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T180">capere, capiō, cēpī, captum</text:span><text:span text:style-name="T18"> </text:span><text:span text:style-name="T26"><text:s text:c="3"/>fassen, nehmen, fangen; erobern</text:span><text:span text:style-name="T21">17. 27. 48</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T18">cōnfirmāre, cōnfirmō, cōnfirmāvī, cōnfirmātum</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>bekräftigen, ermutigen, stärken</text:span><text:span text:style-name="T21">37</text:span></text:p>
