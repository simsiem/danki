    <text:p text:style-name="P37" loext:marker-style-name="T18"><text:span text:style-name="T24">is, ea, id</text:span><text:span text:style-name="T18"> <text:s text:c="3"/></text:span><text:span text:style-name="T26">dieser, diese, dieses; er, sie, es</text:span><text:span text:style-name="T21">26</text:span><text:span text:style-name="T18"> </text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T71"><text:span text:style-name="T210">iste, ista, istud</text:span><text:span text:style-name="T219"> (</text:span><text:span text:style-name="T220">Gen</text:span><text:span text:style-name="T219">. </text:span><text:span text:style-name="T221">istius</text:span><text:span text:style-name="T219">, </text:span><text:span text:style-name="T220">Dat</text:span><text:span text:style-name="T219">. </text:span><text:span text:style-name="T221">isti</text:span><text:span text:style-name="T219">)</text:span><text:span text:style-name="T213"> </text:span><text:span text:style-name="T71"><text:s text:c="3"/>dieser, diese, dieses (da)</text:span><text:span text:style-name="T79">60</text:span></text:p>
