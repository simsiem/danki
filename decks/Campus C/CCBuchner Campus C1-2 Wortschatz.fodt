    <text:p text:style-name="P37" loext:marker-style-name="T76"><text:span text:style-name="T93">non iam</text:span><text:span text:style-name="T71"> <text:s text:c="3"/>nicht mehr</text:span><text:span text:style-name="T79">4</text:span><text:span text:style-name="T76"> </text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">ille, illa, illud</text:span><text:span text:style-name="T18"> <text:s text:c="3"/></text:span><text:span text:style-name="T26">jener, jene, jenes; der (dort); jener berühmte</text:span><text:span text:style-name="T21">40</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T18"><text:span text:style-name="T24">imperāre, imperō, imperāvī, imperātum</text:span><text:span text:style-name="T18"> <text:s text:c="3"/></text:span><text:span text:style-name="T26">befehlen, herrschen (über)</text:span><text:span text:style-name="T21">9</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T71"><text:span text:style-name="T231">impius, impia, impium</text:span><text:span text:style-name="T71"> <text:s text:c="3"/>gottlos, gewissenlos</text:span><text:span text:style-name="T79">61</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T71"><text:span text:style-name="T93">in</text:span><text:span text:style-name="T71"> </text:span><text:span text:style-name="T74">Präp. m. Akk</text:span><text:span text:style-name="T71">. <text:s text:c="3"/>in (... hinein), nach (wohin?); gegen</text:span><text:span text:style-name="T79">12. 56</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T18"><text:span text:style-name="T24">is, ea, id</text:span><text:span text:style-name="T18"> <text:s text:c="3"/></text:span><text:span text:style-name="T26">dieser, diese, dieses; er, sie, es</text:span><text:span text:style-name="T21">26</text:span><text:span text:style-name="T18"> </text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T71"><text:span text:style-name="T221">iste, ista, istud</text:span><text:span text:style-name="T219"> (</text:span><text:span text:style-name="T220">Gen</text:span><text:span text:style-name="T219">. </text:span><text:span text:style-name="T221">istius</text:span><text:span text:style-name="T219">, </text:span><text:span text:style-name="T220">Dat</text:span><text:span text:style-name="T219">. </text:span><text:span text:style-name="T221">isti</text:span><text:span text:style-name="T219">)</text:span><text:span text:style-name="T213"> </text:span><text:span text:style-name="T71"><text:s text:c="3"/>dieser, diese, dieses (da)</text:span><text:span text:style-name="T79">60</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T180">iubēre, iubeō, iussī, iussum</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">m. Akk</text:span><text:span text:style-name="T26">. <text:s text:c="3"/>anordnen, befehlen</text:span><text:span text:style-name="T21">57</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T18">iuvenis, iuvenis</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">m</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>junger Mann; </text:span><text:span text:style-name="T90">Adj</text:span><text:span text:style-name="T26">. jung</text:span><text:span text:style-name="T21">32</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T71"><text:span text:style-name="T80">iuventūs, iuventūtis</text:span><text:span text:style-name="T71"> </text:span><text:span text:style-name="T74">f</text:span><text:span text:style-name="T71"> <text:s text:c="3"/>die Jugend</text:span><text:span text:style-name="T79">40</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T18"><text:span text:style-name="T24">lēx, lēgis</text:span><text:span text:style-name="T18"> </text:span><text:span text:style-name="T90">f</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>das Gesetz, die Bedingung</text:span><text:span text:style-name="T21">36</text:span><text:span text:style-name="T18"> </text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T71"><text:span text:style-name="T80">metuere, metuo, metui</text:span><text:span text:style-name="T71"> <text:s text:c="3"/>(sich) fürchten</text:span><text:span text:style-name="T79">60</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T71"><text:span text:style-name="T80">mōnstrum, mōnstrī</text:span><text:span text:style-name="T71"> </text:span><text:span text:style-name="T74">n <text:s text:c="3"/></text:span><text:span text:style-name="T71">das Ungeheuer</text:span><text:span text:style-name="T79">24</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">movēre, moveō, mōvī, mōtum</text:span><text:span text:style-name="T18"> <text:s text:c="3"/></text:span><text:span text:style-name="T26">bewegen, beeindrucken</text:span><text:span text:style-name="T21">7. 27</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">mulier, mulieris</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">f</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>die Frau</text:span><text:span text:style-name="T21">19</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T71"><text:span text:style-name="T93">n</text:span><text:span text:style-name="T180">ē</text:span><text:span text:style-name="T71"> </text:span><text:span text:style-name="T74">Subj. m. Konj</text:span><text:span text:style-name="T71">. <text:s text:c="3"/>dass nicht; (nach Ausdrücken des Fürchtens und Hinderns) dass; damit nicht, um nicht zu </text:span><text:span text:style-name="T74">m. Inf.</text:span><text:span text:style-name="T79">45. 59</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T23"><text:span text:style-name="T179">nefārius, nefāria, nefārium</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>gottlos, verbrecherisch</text:span><text:span text:style-name="T21">56</text:span><text:span text:style-name="T23"> </text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">nōn</text:span><text:span text:style-name="T18"> <text:s text:c="3"/></text:span><text:span text:style-name="T26">nicht</text:span><text:span text:style-name="T21">2</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T18"><text:span text:style-name="T18">nūntius, nūntiī <text:s text:c="3"/></text:span><text:span text:style-name="T26">der Bote, die Nachricht</text:span><text:span text:style-name="T21">16</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T71"><text:soft-page-break/><text:span text:style-name="T80">omittere, omittō, omīsī, omissum</text:span><text:span text:style-name="T71"> <text:s text:c="3"/>aufgeben, beiseite lassen</text:span><text:span text:style-name="T79">37</text:span><text:span text:style-name="T76"> </text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T18"><text:span text:style-name="T24">omnis, omne</text:span><text:span text:style-name="T18"> <text:s text:c="3"/></text:span><text:span text:style-name="T26">jeder, ganz; </text:span><text:span text:style-name="T90">Pl</text:span><text:span text:style-name="T26">. alle</text:span><text:span text:style-name="T21">33</text:span><text:span text:style-name="T18"> </text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">pater, patris</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">m</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>der Vater</text:span><text:span text:style-name="T21">20</text:span><text:span text:style-name="T26"> </text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T179">perdere, perdō, perdidī, perditum</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>verlieren, verschwenden, zugrunde richten</text:span><text:span text:style-name="T21">57</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T18"><text:span text:style-name="T24">perīre, pereō, periī</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>umkommen, zugrunde gehen</text:span><text:span text:style-name="T21">44</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T18"><text:span text:style-name="T180">poena, poenae</text:span><text:span text:style-name="T18"> </text:span><text:span text:style-name="T90">f </text:span><text:span text:style-name="T18"><text:s text:c="3"/></text:span><text:span text:style-name="T26">die Strafe</text:span><text:span text:style-name="T21">46</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T18"><text:span text:style-name="T24">posse, possum, potuī</text:span><text:span text:style-name="T18"> <text:s text:c="3"/></text:span><text:span text:style-name="T26">können</text:span><text:span text:style-name="T21">17. 25</text:span><text:span text:style-name="T18"> </text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T18"><text:span text:style-name="T24">postquam</text:span><text:span text:style-name="T18"> </text:span><text:span text:style-name="T90">Subj. m. Perf</text:span><text:span text:style-name="T26">. <text:s text:c="3"/>nachdem, als</text:span><text:span text:style-name="T21">33</text:span><text:span text:style-name="T18"> </text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T76"><text:span text:style-name="T80">prex, precis</text:span><text:span text:style-name="T71"> </text:span><text:span text:style-name="T74">f</text:span><text:span text:style-name="T71"> <text:s text:c="3"/>die Bitte, das Gebet</text:span><text:span text:style-name="T79">50</text:span><text:span text:style-name="T76"> </text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T182">ubi primum</text:span><text:span text:style-name="T217"> Subj. m. Ind</text:span><text:span text:style-name="T215">. <text:s text:c="3"/></text:span><text:span text:style-name="T71">sobald</text:span><text:span text:style-name="T79">61</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T18">properāre, properō, properāvī, properātum</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>eilen, sich beeilen</text:span><text:span text:style-name="T21">8</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T71"><text:span text:style-name="T231">prōtinus</text:span><text:span text:style-name="T71"> </text:span><text:span text:style-name="T74">Adv</text:span><text:span text:style-name="T71">. <text:s text:c="3"/>sofort</text:span><text:span text:style-name="T79">61</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T18">puella, puellae</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">f</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>das Mädchen</text:span><text:span text:style-name="T21">1</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">quī, quae, quod</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>der, die, das</text:span><text:span text:style-name="T21">34</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T173"><text:span text:style-name="T182">quia</text:span><text:span text:style-name="T173"> </text:span><text:span text:style-name="T176">Subj.</text:span><text:span text:style-name="T173"> <text:s text:c="3"/>weil</text:span><text:span text:style-name="T181">19</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T173"><text:span text:style-name="T182">respondēre, respondeō, respondī <text:s text:c="2"/></text:span><text:span text:style-name="T173">antworten</text:span><text:span text:style-name="T181">3.34</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">rēx, rēgis</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">m</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>der König</text:span><text:span text:style-name="T21">27</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">scelus, sceleris</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">n</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>das Verbrechen; der Schurke</text:span><text:span text:style-name="T21">49</text:span><text:span text:style-name="T26"> </text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T71"><text:span text:style-name="T80">spōnsus, sponsī</text:span><text:span text:style-name="T71"> </text:span><text:span text:style-name="T74">m</text:span><text:span text:style-name="T71"> <text:s text:c="3"/>der Verlobte</text:span><text:span text:style-name="T79">0</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T18"><text:span text:style-name="T24">tamen</text:span><text:span text:style-name="T18"> <text:s text:c="3"/></text:span><text:span text:style-name="T26">dennoch, jedoch</text:span><text:span text:style-name="T21">3</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T18">tē</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">Akk</text:span><text:span text:style-name="T26">. <text:s text:c="3"/>dich</text:span><text:span text:style-name="T21">13</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T18">temptāre, temptō, temptāvī, temptātum</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>angreifen; prüfen, versuchen</text:span><text:span text:style-name="T21">26</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T18">tibi</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">Dat</text:span><text:span text:style-name="T26">. <text:s text:c="3"/>dir</text:span><text:span text:style-name="T21">13</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T18">trīstis, trīste</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>traurig, unfreundlich</text:span><text:span text:style-name="T21">33</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">tū</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">Nom</text:span><text:span text:style-name="T26">. <text:s text:c="3"/>du </text:span><text:span text:style-name="T90">(betont)</text:span><text:span text:style-name="T21">13</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">tuus,tua, tuum</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>dein</text:span><text:span text:style-name="T21">14</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T215"><text:span text:style-name="T232">ubi (primum)</text:span><text:span text:style-name="T215"> </text:span><text:span text:style-name="T217">Subj. m. Ind</text:span><text:span text:style-name="T215">. <text:s text:c="3"/>sobald</text:span><text:span text:style-name="T218">61</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T71"><text:span text:style-name="T216">ut</text:span><text:span text:style-name="T215"> </text:span><text:span text:style-name="T217">Subj. m. Konj</text:span><text:span text:style-name="T215">. <text:s text:c="3"/></text:span><text:span text:style-name="T71">dass, sodass; damit, um zu </text:span><text:span text:style-name="T74">m. Inf</text:span><text:span text:style-name="T71">.</text:span><text:span text:style-name="T79">45. 59</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T18"><text:span text:style-name="T24">venīre, veniō, vēnī, ventum</text:span><text:span text:style-name="T18"> <text:s text:c="3"/></text:span><text:span text:style-name="T26">kommen</text:span><text:span text:style-name="T21">10. 27</text:span><text:span text:style-name="T167"> </text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T180">vērus, vēra, vērum</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>echt, richtig, wahr</text:span><text:span text:style-name="T21">59</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T79"><text:span text:style-name="T80">vinculum, vinculī</text:span><text:span text:style-name="T71"> </text:span><text:span text:style-name="T74">n <text:s text:c="3"/></text:span><text:span text:style-name="T71">das Band, die Fessel; </text:span><text:span text:style-name="T74">Pl</text:span><text:span text:style-name="T71">. das Gefängnis</text:span><text:span text:style-name="T79">58</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T71"><text:span text:style-name="T80">in vincula dare</text:span><text:span text:style-name="T71"> <text:s text:c="3"/>fesseln, gefangen nehmen</text:span><text:span text:style-name="T79">58</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T179">vindicāre, vindicō, vindicāvī, vindicātum</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>beanspruchen, bestrafen; </text:span><text:span text:style-name="T18">in</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">m. Akk</text:span><text:span text:style-name="T26">. vorgehen gegen</text:span><text:span text:style-name="T21">56</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T23"><text:span text:style-name="T24">virgō, virginis</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">f</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>das Mädchen, die Jungfrau</text:span><text:span text:style-name="T21">36</text:span><text:span text:style-name="T23"> </text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T71"><text:span text:style-name="T80">vīvere, vīvō, vīxī</text:span><text:span text:style-name="T71"> <text:s text:c="3"/>leben</text:span><text:span text:style-name="T79">30</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T21"><text:span text:style-name="T24">velle, volō, voluī</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>wollen</text:span><text:span text:style-name="T21">19. 25</text:span></text:p>
   </text:section>
