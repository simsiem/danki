    <text:p text:style-name="P25" loext:marker-style-name="T43"><text:span text:style-name="T42">Alpēs, Alpium</text:span><text:span text:style-name="T43"> </text:span><text:span text:style-name="T55">f Pl. <text:s text:c="3"/></text:span><text:span text:style-name="T43">die Alpen</text:span><text:span text:style-name="T44">44</text:span><text:span text:style-name="T43"> </text:span></text:p>
