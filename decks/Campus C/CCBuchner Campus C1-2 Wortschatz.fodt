    <text:p text:style-name="P37" loext:marker-style-name="T18"><text:span text:style-name="T18">Gallus, Galla, Gallum <text:s text:c="3"/></text:span><text:span text:style-name="T26">gallisch; </text:span><text:span text:style-name="T90">Subst</text:span><text:span text:style-name="T26">. der Gallier</text:span><text:span text:style-name="T21">42</text:span></text:p>
