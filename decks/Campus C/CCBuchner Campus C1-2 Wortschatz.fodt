   </text:section>
   <text:section text:style-name="Sect3" text:name="Bereich48">
    <text:p text:style-name="P37" loext:marker-style-name="T18"><text:span text:style-name="T24">ā / ab</text:span><text:span text:style-name="T18"> </text:span><text:span text:style-name="T90">Präp. m. Abl.</text:span><text:span text:style-name="T18"> <text:s text:c="3"/></text:span><text:span text:style-name="T26">von, von ... her</text:span><text:span text:style-name="T21">16</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T180">capere, capiō, cēpī, </text:span><text:span text:style-name="T30">captum</text:span><text:span text:style-name="T18"> </text:span><text:span text:style-name="T26"><text:s text:c="3"/>fassen, nehmen, fangen; erobern</text:span><text:span text:style-name="T21">17. 27. 48</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">cīvis, cīvis</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">m</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">(Gen. Pl.</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T24">-ium</text:span><text:span text:style-name="T90">)</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>der Bürger</text:span><text:span text:style-name="T21">30</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T179">comprehendere, comprehendō, comprehendī,</text:span><text:span text:style-name="T16"> comprehēnsum</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>begreifen, ergreifen, festnehmen</text:span><text:span text:style-name="T21">24. 27. 48</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">cōnsilium, consiliī</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">n</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>die Beratung, der Beschluss, der Plan, der Rat</text:span><text:span text:style-name="T21">11</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T18">consilium capere</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>einen Plan (Entschluss) fassen</text:span><text:span text:style-name="T21">27</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T21"><text:span text:style-name="T24">dūcere, dūco, dūxī, </text:span><text:span text:style-name="T30">ductum</text:span><text:span text:style-name="T184"> </text:span><text:span text:style-name="T26"><text:s text:c="3"/>führen, ziehen</text:span><text:span text:style-name="T21">16.27.48</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T18"><text:span text:style-name="T24">esse, sum, fuī</text:span><text:span text:style-name="T18"> <text:s text:c="3"/></text:span><text:span text:style-name="T26">sein, sich befinden</text:span><text:span text:style-name="T21">2. 25</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T167"><text:span text:style-name="T24">etiam</text:span><text:span text:style-name="T18"> <text:s text:c="3"/></text:span><text:span text:style-name="T26">auch, sogar</text:span><text:span text:style-name="T21">5</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T18">forum, forī</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">n</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>das Forum, der Marktplatz</text:span><text:span text:style-name="T21">11</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T18">Graecus, Graeca, Graecum</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>griechisch; </text:span><text:span text:style-name="T90">Subst</text:span><text:span text:style-name="T26">. der Grieche</text:span><text:span text:style-name="T21">18</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">homō, hominis</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">m</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>der Mensch</text:span><text:span text:style-name="T21">23</text:span><text:span text:style-name="T26"> </text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T180"><text:span text:style-name="T180">in </text:span><text:span text:style-name="T185">Präp. m. Abl</text:span><text:span text:style-name="T186">. <text:s text:c="3"/>in, an, auf, bei (wo?)</text:span><text:span text:style-name="T187">12</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T188"><text:span text:style-name="T180">in </text:span><text:span text:style-name="T185">Präp. m. Akk</text:span><text:span text:style-name="T186">. <text:s text:c="3"/>in (... hinein), nach (wohin?)</text:span><text:span text:style-name="T187">12</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">laudāre, laudō, laudāvī, laudātum</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>loben</text:span><text:span text:style-name="T21">8</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">magnus, magna, magnum</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>groß, bedeutend</text:span><text:span text:style-name="T21">14</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T180">mittere, mittō, mīsī, </text:span><text:span text:style-name="T30">missum</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>(los)lassen, schicken, werfen</text:span><text:span text:style-name="T21">16. 27. 48</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T18"><text:span text:style-name="T24">multus, multa, multum</text:span><text:span text:style-name="T18"> <text:s text:c="3"/></text:span><text:span text:style-name="T26">viel</text:span><text:span text:style-name="T21">14</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">nunc</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">Adv</text:span><text:span text:style-name="T26">. <text:s text:c="3"/>nun, jetzt</text:span><text:span text:style-name="T21">2</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">nūntiāre, nūntiō, nūntiāvī, nūntiātum</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>melden</text:span><text:span text:style-name="T21">21</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T18">nūntius, nuntiī</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">m</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>der Bote, die Nachricht</text:span><text:span text:style-name="T21">16</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">omnis, omne</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>jeder, ganz; </text:span><text:span text:style-name="T90">Pl</text:span><text:span text:style-name="T26">. alle</text:span><text:span text:style-name="T21">33</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">oppidum, oppidī</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">n</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>die Stadt (Kleinstadt)</text:span><text:span text:style-name="T21">16</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T18">Rōmānus, Rōmāna, Rōmānum</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>römisch; </text:span><text:span text:style-name="T90">Subst</text:span><text:span text:style-name="T26">. der Römer, der Einwohner Roms</text:span><text:span text:style-name="T21">9. 14</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T18">senātor, senātōris</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">m</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>der Senator</text:span><text:span text:style-name="T21">18</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T180">socius, sociī</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">m</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>der Gefährte, Verbündeter</text:span><text:span text:style-name="T21">47</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">spēs, speī</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">f</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>die Erwartung, die Hoffnung</text:span><text:span text:style-name="T21">41</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T18">verbum, verbī </text:span><text:span text:style-name="T90">n</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>das Wort, die Äußerung</text:span><text:span text:style-name="T21">11</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T180">vidēre, videō, vīdī, </text:span><text:span text:style-name="T30">vīsum</text:span><text:span text:style-name="T24"> <text:s text:c="2"/></text:span><text:span text:style-name="T26"><text:s/>sehen</text:span><text:span text:style-name="T21">7. 27. 48</text:span></text:p>
   </text:section>
   <text:section text:style-name="Sect2" text:name="Bereich49">
    <text:p text:style-name="P51" loext:marker-style-name="T89"/>
    <text:p text:style-name="P54" loext:marker-style-name="T89"><text:span text:style-name="T183">LEKTION 48. T, Seite 47</text:span></text:p>
    <text:p text:style-name="P53" loext:marker-style-name="T183"/>
   </text:section>
   <text:section text:style-name="Sect3" text:name="Bereich50">
    <text:p text:style-name="P37" loext:marker-style-name="T18"><text:span text:style-name="T24">ā / ab</text:span><text:span text:style-name="T18"> </text:span><text:span text:style-name="T90">Präp. m. Abl.</text:span><text:span text:style-name="T18"> <text:s text:c="3"/></text:span><text:span text:style-name="T26">von, von ... her</text:span><text:span text:style-name="T21">16</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T18"><text:span text:style-name="T18">ācer, ācris, ācre <text:s text:c="3"/></text:span><text:span text:style-name="T26">energisch, heftig, scharf</text:span><text:span text:style-name="T21">32</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T18"><text:span text:style-name="T24">ad</text:span><text:span text:style-name="T18"> </text:span><text:span text:style-name="T90">Präp. m. Akk.</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>zu, bei, nach, an</text:span><text:span text:style-name="T21">12</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">adīre, adeō, adiī</text:span><text:span text:style-name="T18"> </text:span><text:span text:style-name="T90">m. Akk.</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>herantreten (an), bitten, aufsuchen</text:span><text:span text:style-name="T21">37</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T173"><text:span text:style-name="T182">alius, alia, aliud</text:span><text:span text:style-name="T173"> <text:s text:c="3"/>ein anderer</text:span><text:span text:style-name="T181">29</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">animus, animī </text:span><text:span text:style-name="T90">m</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>der Geist, der Mut, die Gesinnung</text:span><text:span text:style-name="T21">19</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">apud</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">Präp. m. Akk</text:span><text:span text:style-name="T26">. <text:s text:c="3"/>bei</text:span><text:span text:style-name="T21">18</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T180">atque / ac</text:span><text:span text:style-name="T24"> <text:s text:c="2"/></text:span><text:span text:style-name="T26"><text:s/>und, und auch</text:span><text:span text:style-name="T21">47</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T30">auctōritās, auctōritātis</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">f</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>das Ansehen, der Einfluss, die Macht</text:span><text:span text:style-name="T21">48</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T18"><text:span text:style-name="T24">audīre, audiō, audīvī, audītum</text:span><text:span text:style-name="T18"> <text:s text:c="3"/></text:span><text:span text:style-name="T26">hören</text:span><text:span text:style-name="T21">10</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T18"><text:span text:style-name="T24">autem</text:span><text:span text:style-name="T18"> </text:span><text:span text:style-name="T90">(nachgestellt)</text:span><text:span text:style-name="T18"> <text:s text:c="3"/></text:span><text:span text:style-name="T26">aber, andererseits</text:span><text:span text:style-name="T21">15</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T18"><text:span text:style-name="T18">beātus, beāta, beātum <text:s text:c="3"/></text:span><text:span text:style-name="T26">glücklich, reich</text:span><text:span text:style-name="T21">36</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T180">capere, capiō, cēpī, </text:span><text:span text:style-name="T30">captum</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>fassen, nehmen, fangen; erobern</text:span><text:span text:style-name="T21">17. 27. 48</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">cīvitās, cīvitātis</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">f</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>die Gemeinde, der Staat</text:span><text:span text:style-name="T21">20</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T18"><text:span text:style-name="T18">clāmor, clāmōris </text:span><text:span text:style-name="T90">m</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>Geschrei, Lärm</text:span><text:span text:style-name="T21">19</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">clārus, clāra, clārum</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>klar, hell, berühmt</text:span><text:span text:style-name="T21">15</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T179">comprehendere, comprehendō, comprehendī, </text:span><text:span text:style-name="T16">comprehēnsum</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>begreifen, ergreifen, festnehmen</text:span><text:span text:style-name="T21">24. 27. 48</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T18">conicere, coniciō, coniēcī, coniectum</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>(zusammen)werfen, folgern, vermuten</text:span><text:span text:style-name="T21">38</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">convenīre, conveniō, convēnī, conventum</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>zusammenkommen, zusammenpassen, besuchen</text:span><text:span text:style-name="T21">30</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">crēdere, crēdō, crēdidī, crēditum</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>glauben, anvertrauen</text:span><text:span text:style-name="T21">35</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T18"><text:span text:style-name="T24">cūr?</text:span><text:span text:style-name="T18"> <text:s text:c="3"/></text:span><text:span text:style-name="T26">warum?</text:span><text:span text:style-name="T21">2</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">dē</text:span><text:span text:style-name="T18"> </text:span><text:span text:style-name="T90">Präp. m. Abl.</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>von, von ... her, von ... weg, von ... herab; über</text:span><text:span text:style-name="T21">14</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T21"><text:span text:style-name="T24">dēbēre, dēbeō, dēbuī <text:s text:c="2"/></text:span><text:span text:style-name="T26"><text:s/>müssen, sollen</text:span><text:span text:style-name="T21">2</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">dīcere, dīcō, dīxī, dictum <text:s text:c="2"/></text:span><text:span text:style-name="T26"><text:s/>sagen, sprechen</text:span><text:span text:style-name="T21">16. 27</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">diēs, diēī</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">m</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>der Tag</text:span><text:span text:style-name="T21">41</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T18">doctrīna, doctrīnae</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">f</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>die Lehre</text:span><text:span text:style-name="T21">0</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T21"><text:span text:style-name="T24">dūcere, dūco, dūxī, </text:span><text:span text:style-name="T30">ductum</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>führen, ziehen</text:span><text:span text:style-name="T21">16. 27. 48</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T171"><text:span text:style-name="T24">ē / ex </text:span><text:span text:style-name="T168">Präp. m. Abl. <text:s text:c="2"/></text:span><text:span text:style-name="T171"><text:s/>aus, von ... her</text:span><text:span text:style-name="T170">12</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">enim</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">(nachgestellt)</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>nämlich, denn</text:span><text:span text:style-name="T21">18</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T18"><text:span text:style-name="T24">esse, sum, fuī</text:span><text:span text:style-name="T18"> <text:s text:c="3"/></text:span><text:span text:style-name="T26">sein, sich befinden</text:span><text:span text:style-name="T21">2. 25</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T24"><text:span text:style-name="T24">et <text:s text:c="3"/></text:span><text:span text:style-name="T26">und, auch</text:span><text:span text:style-name="T21">1</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T167"><text:span text:style-name="T24">etiam</text:span><text:span text:style-name="T18"> <text:s text:c="3"/></text:span><text:span text:style-name="T26">auch, sogar</text:span><text:span text:style-name="T21">5</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">facere, faciō, fēcī, </text:span><text:span text:style-name="T30">factum</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>machen, tun, handeln</text:span><text:span text:style-name="T21">17. 27. 48</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">fortis, forte <text:s text:c="3"/></text:span><text:span text:style-name="T26">kräftig, tapfer</text:span><text:span text:style-name="T21">33</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T18">forum, forī</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">n</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>das Forum, der Marktplatz</text:span><text:span text:style-name="T21">11</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T18">Graecus, Graeca, Graecum</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>griechisch; </text:span><text:span text:style-name="T90">Subst</text:span><text:span text:style-name="T26">. der Grieche</text:span><text:span text:style-name="T21">18</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T18">herī</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">Adv</text:span><text:span text:style-name="T26">. <text:s text:c="3"/>gestern</text:span><text:span text:style-name="T21">20</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">hic, haec, hoc</text:span><text:span text:style-name="T18"> <text:s text:c="3"/></text:span><text:span text:style-name="T26">dieser, diese, dieses (hier); folgender</text:span><text:span text:style-name="T21">40</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">homō, hominis</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">m</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>der Mensch</text:span><text:span text:style-name="T21">23</text:span><text:span text:style-name="T26"> </text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">honor, honōris</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">m</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>die Ehre, das Ehrenamt</text:span><text:span text:style-name="T21">18</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T171"><text:span text:style-name="T189">in honōre esse <text:s text:c="3"/></text:span><text:span text:style-name="T171">in Ehren stehen, angesehen sein</text:span><text:span text:style-name="T170">18</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">ibī</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">Adv</text:span><text:span text:style-name="T26">. <text:s text:c="3"/>dort</text:span><text:span text:style-name="T21">3</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T18">idōneus, idōnea, idōneum</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>geeignet, passend</text:span><text:span text:style-name="T21">34</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">ille, illa, illud</text:span><text:span text:style-name="T18"> <text:s text:c="3"/></text:span><text:span text:style-name="T26">jener, jene, jenes; der (dort); jener berühmte</text:span><text:span text:style-name="T21">40</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T180"><text:span text:style-name="T180">in </text:span><text:span text:style-name="T185">Präp. m. Abl</text:span><text:span text:style-name="T186">. <text:s text:c="3"/>in, an, auf, bei (wo?)</text:span><text:span text:style-name="T187">12</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T188"><text:span text:style-name="T180">in </text:span><text:span text:style-name="T185">Präp. m. Akk</text:span><text:span text:style-name="T186">. <text:s text:c="3"/>in (... hinein), nach (wohin?)</text:span><text:span text:style-name="T187">12</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T18">inānis, ināne</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>leer, wertlos</text:span><text:span text:style-name="T21">35</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T180">invenīre, inveniō, invēnī, </text:span><text:span text:style-name="T30">inventum</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>finden, erfinden</text:span><text:span text:style-name="T21">13. 27. 48</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T18"><text:span text:style-name="T24">is, ea, id</text:span><text:span text:style-name="T18"> <text:s text:c="3"/></text:span><text:span text:style-name="T26">dieser, diese, dieses; er, sie, es</text:span><text:span text:style-name="T21">26</text:span><text:span text:style-name="T18"> </text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T18"><text:span text:style-name="T24">itaque</text:span><text:span text:style-name="T18"> <text:s text:c="3"/></text:span><text:span text:style-name="T26">deshalb</text:span><text:span text:style-name="T21">5</text:span><text:span text:style-name="T18"> </text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T18">iuvenis, iuvenis</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">m</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>junger Mann; </text:span><text:span text:style-name="T90">Adj</text:span><text:span text:style-name="T26">. jung</text:span><text:span text:style-name="T21">32</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T16">laedere, laedō, laesī, laesum</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>beschädigen, verletzen, beleidigen</text:span><text:span text:style-name="T21">48</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T18">mālle, mālō, māluī</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>lieber wollen</text:span><text:span text:style-name="T21">19. 25</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T18">mihi</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">Dat</text:span><text:span text:style-name="T26">. <text:s text:c="3"/>mir</text:span><text:span text:style-name="T21">13</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T180">mittere, mittō, mīsī, </text:span><text:span text:style-name="T30">missum</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>(los)lassen, schicken, werfen</text:span><text:span text:style-name="T21">16. 27. 48</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">mōs, mōris</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">m</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>die Sitte, der Brauch; </text:span><text:span text:style-name="T90">Pl</text:span><text:span text:style-name="T26">. der Charakter</text:span><text:span text:style-name="T21">36</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">movēre, moveō, mōvī, mōtum</text:span><text:span text:style-name="T18"> <text:s text:c="3"/></text:span><text:span text:style-name="T26">bewegen, beeindrucken</text:span><text:span text:style-name="T21">7. 27</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:soft-page-break/><text:span text:style-name="T18">mox</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">Adv.</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>bald</text:span><text:span text:style-name="T21">7</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T171"><text:span text:style-name="T190">(M. Porcius) Catō, ōnis (Cēnsōrius)</text:span><text:span text:style-name="T191"> </text:span><text:span text:style-name="T192">m</text:span><text:span text:style-name="T191"> <text:s text:c="3"/>Marcus Porcius Cato (röm. </text:span><text:span text:style-name="T171">Politiker und Schriftsteller, 234-149 v. Chr)</text:span><text:span text:style-name="T170">48</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">mulier, mulieris</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">f</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>die Frau</text:span><text:span text:style-name="T21">19</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T18"><text:span text:style-name="T24">multus, multa, multum</text:span><text:span text:style-name="T18"> <text:s text:c="3"/></text:span><text:span text:style-name="T26">viel</text:span><text:span text:style-name="T21">14</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T18">mūtāre, mūtō, mūtāvī, mūtātum</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>(ver)ändern, verwandeln</text:span><text:span text:style-name="T21">41</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T18"><text:span text:style-name="T24">nātūra, nātūrae</text:span><text:span text:style-name="T18"> </text:span><text:span text:style-name="T90">f</text:span><text:span text:style-name="T18"> <text:s text:c="3"/></text:span><text:span text:style-name="T26">die</text:span><text:span text:style-name="T18"> </text:span><text:span text:style-name="T26">Natur, das Wesen, die Beschaffenheit</text:span><text:span text:style-name="T21">6</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">nēmō, nēminis</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>niemand</text:span><text:span text:style-name="T21">38</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">neque</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>und nicht, auch nicht</text:span><text:span text:style-name="T21">3</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T18"><text:span text:style-name="T24">noster, nostra, nostrum</text:span><text:span text:style-name="T18"> <text:s text:c="3"/></text:span><text:span text:style-name="T26">unser</text:span><text:span text:style-name="T21">15</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">nunc</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">Adv</text:span><text:span text:style-name="T26">. <text:s text:c="3"/>nun, jetzt</text:span><text:span text:style-name="T21">2</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T18">nūntius, nuntiī</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">m</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>der Bote, die Nachricht</text:span><text:span text:style-name="T21">16</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T18">occidere, occidō, occidī</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>(zu Boden) fallen, umkommen, untergehen</text:span><text:span text:style-name="T21">28</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">officium, officiī</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">n</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>der Dienst, die Pflicht, das Pflichtgefühl</text:span><text:span text:style-name="T21">28</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T18">officium praestāre <text:s text:c="3"/></text:span><text:span text:style-name="T26">eine Pflicht leisten, erfüllen</text:span><text:span text:style-name="T21">28</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">ōrātiō, ōrātiōnis</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">f</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>die Rede</text:span><text:span text:style-name="T21">44</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">patria, patriae</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">f</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>die Heimat</text:span><text:span text:style-name="T21">9</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T30">paucī, paucae, pauca</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>wenige</text:span><text:span text:style-name="T21">48</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T18"><text:span text:style-name="T24">paulō</text:span><text:span text:style-name="T18"> </text:span><text:span text:style-name="T90">Adv.</text:span><text:span text:style-name="T18"> <text:s text:c="3"/></text:span><text:span text:style-name="T26">(um) ein wenig</text:span><text:span text:style-name="T21">40</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T18">paulō post</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>(ein) wenig später</text:span><text:span text:style-name="T21">26</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T18">pellere, pellō, pepulī, pulsum</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>stoßen, schlagen, (ver)treiben</text:span><text:span text:style-name="T21">32</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">per</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">Präp. m. Akk</text:span><text:span text:style-name="T26">. <text:s text:c="3"/>durch, hindurch</text:span><text:span text:style-name="T21">16</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">post</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">Präp. m. Akk</text:span><text:span text:style-name="T26">. <text:s text:c="3"/>hinter, nach</text:span><text:span text:style-name="T21">12</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T18"><text:span text:style-name="T24">postquam</text:span><text:span text:style-name="T18"> </text:span><text:span text:style-name="T90">Subj. m. Perf</text:span><text:span text:style-name="T26">. <text:s text:c="3"/>nachdem, als</text:span><text:span text:style-name="T21">33</text:span><text:span text:style-name="T18"> </text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T18">praestāre, praestō, praestitī</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">m. Akk</text:span><text:span text:style-name="T26">. <text:s text:c="3"/>gewähren, leisten, zeigen</text:span><text:span text:style-name="T21">28</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T18">prīmō</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">Adv</text:span><text:span text:style-name="T26">. <text:s text:c="3"/>zuerst</text:span><text:span text:style-name="T21">4</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">puer, puerī</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">m</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>der Junge, der Bub</text:span><text:span text:style-name="T21">15</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">quaerere, quaerō, quaesīvī, quaesītum</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>erwerben wollen, suchen, fragen</text:span><text:span text:style-name="T21">30. 47</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">quī, quae, quod</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>der, die, das</text:span><text:span text:style-name="T21">34</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">quia</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">Subj.</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>weil</text:span><text:span text:style-name="T21">19</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T18"><text:span text:style-name="T16">reprehendere, reprehendō, reprehendī, reprehēnsum</text:span><text:span text:style-name="T18"> <text:s text:c="3"/></text:span><text:span text:style-name="T26">schimpfen, kritisieren</text:span><text:span text:style-name="T21">48</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">rēs pūblica, reī pūblicae</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">f</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>der Staat</text:span><text:span text:style-name="T21">41</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T179">rīdēre, rīdeō, rīsī, </text:span><text:span text:style-name="T16">rīsum</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>lachen, auslachen</text:span><text:span text:style-name="T21">2.34.48</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T18">Rōma, Rōmae</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">f</text:span><text:span text:style-name="T26"> <text:s text:c="2"/>Rom</text:span><text:span text:style-name="T21">7</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T18">Rōmānus, Rōmāna, Rōmānum</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>römisch; </text:span><text:span text:style-name="T90">Subst</text:span><text:span text:style-name="T26">. Römer, Einwohner Roms</text:span><text:span text:style-name="T21">9. 14</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T18"><text:span text:style-name="T24">semper</text:span><text:span text:style-name="T18"> </text:span><text:span text:style-name="T90">Adv</text:span><text:span text:style-name="T26">. <text:s text:c="3"/>immer</text:span><text:span text:style-name="T21">4</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T18">senātor, senātōris</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">m</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>der Senator</text:span><text:span text:style-name="T21">18</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T30">sententia, sententiae</text:span><text:span text:style-name="T18"> </text:span><text:span text:style-name="T90">f</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>die Meinung, der Satz, der Sinn, der Antrag (im Senat)</text:span><text:span text:style-name="T21">48</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">suus, sua, suum</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>sein, ihr</text:span><text:span text:style-name="T21">30</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">summus, summa, summum</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>der höchste, oberste</text:span><text:span text:style-name="T21">15</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">tōtus, tōta, tōtum</text:span><text:span text:style-name="T18"> </text:span><text:span text:style-name="T90">(Gen.</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T24">tōtīus</text:span><text:span text:style-name="T26">, </text:span><text:span text:style-name="T90">Dat.</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T24">tōtī</text:span><text:span text:style-name="T90">)</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>ganz, gesamt</text:span><text:span text:style-name="T21">40</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">tum</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">Adv</text:span><text:span text:style-name="T26">. <text:s text:c="3"/>da, dann, darauf, damals</text:span><text:span text:style-name="T21">4</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T16">undique</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">Adv</text:span><text:span text:style-name="T26">. <text:s text:c="3"/>von allen Seiten, von überallher</text:span><text:span text:style-name="T21">48</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">urbs, urbis</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">f</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">(Gen. Pl.</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T24">-ium</text:span><text:span text:style-name="T90">)</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>die Stadt; die Stadt Rom</text:span><text:span text:style-name="T21">22</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T18">varius, varia, varium</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>bunt, verschieden, vielfältig</text:span><text:span text:style-name="T21">21</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T21"><text:span text:style-name="T24">velle, volō, voluī</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>wollen</text:span><text:span text:style-name="T21">19. 25</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T180">venīre, veniō, vēnī, </text:span><text:span text:style-name="T30">ventum</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>kommen</text:span><text:span text:style-name="T21">10. 27. 48</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T18"><text:span text:style-name="T16">ventum est</text:span><text:span text:style-name="T18"> <text:s text:c="3"/></text:span><text:span text:style-name="T26">man kam</text:span><text:span text:style-name="T21">48</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T18">verbum, verbī </text:span><text:span text:style-name="T90">n</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>das Wort, die Äußerung</text:span><text:span text:style-name="T21">11</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T18">vertere, vertō, vertī, versum</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>drehen, wenden</text:span><text:span text:style-name="T21">27</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T173"><text:span text:style-name="T182">vincere, vincō, vīcī, victum</text:span><text:span text:style-name="T173"> <text:s text:c="3"/>(be)siegen,</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T26">übertreffen</text:span><text:span text:style-name="T21">27</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">vir, virī</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">m</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>der Mann</text:span><text:span text:style-name="T21">15</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T21"><text:span text:style-name="T24">vidēre, videō, vīdī, </text:span><text:span text:style-name="T30">vīsum</text:span><text:span text:style-name="T24"> <text:s text:c="2"/></text:span><text:span text:style-name="T26"><text:s/>sehen</text:span><text:span text:style-name="T21">7. 27. 48</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">vīs</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">f</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">(Akk.</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T24">vim</text:span><text:span text:style-name="T26">, </text:span><text:span text:style-name="T90">Abl.</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T24">vī</text:span><text:span text:style-name="T90">)</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>die Gewalt, die Kraft, die Menge</text:span><text:span text:style-name="T21">38</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">vīta, vītae</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">f</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>das Leben</text:span><text:span text:style-name="T21">15</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T18">vōbīs</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">Dat</text:span><text:span text:style-name="T26">. <text:s text:c="3"/>euch</text:span><text:span text:style-name="T21">13</text:span><text:span text:style-name="T26"> </text:span></text:p>
   </text:section>
   <text:section text:style-name="Sect2" text:name="Bereich51">
    <text:p text:style-name="P49" loext:marker-style-name="T178"/>
    <text:p text:style-name="P55" loext:marker-style-name="T178"><text:span text:style-name="T14"><text:s/>XVII kompakt. T, Seite 48</text:span></text:p>
