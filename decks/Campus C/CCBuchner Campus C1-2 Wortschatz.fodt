    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T18">flēre, fleō, flēvī, flētum <text:s text:c="2"/></text:span><text:span text:style-name="T26"><text:s/>weinen, beweinen</text:span><text:span text:style-name="T21">5. 25</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">fuga, fugae</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">f <text:s text:c="3"/></text:span><text:span text:style-name="T26">die Flucht</text:span><text:span text:style-name="T21">25</text:span></text:p>
