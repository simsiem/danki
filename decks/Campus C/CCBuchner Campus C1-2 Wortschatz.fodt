    <text:p text:style-name="P37" loext:marker-style-name="T23"><text:span text:style-name="T18">dēligere, dēligō, dēlēgī, dēlēctum</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>(aus)wählen</text:span><text:span text:style-name="T21">34. 56</text:span><text:span text:style-name="T23"> </text:span></text:p>
