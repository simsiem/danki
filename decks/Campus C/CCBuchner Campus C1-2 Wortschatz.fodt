    <text:p text:style-name="P37" loext:marker-style-name="T18"><text:span text:style-name="T18">dum </text:span><text:span text:style-name="T90">Subj. <text:s text:c="2"/></text:span><text:span text:style-name="T26"><text:s/>während </text:span><text:span text:style-name="T90">(m. Ind. Präs.)</text:span><text:span text:style-name="T26">, solange, bis</text:span><text:span text:style-name="T21">19</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T18"><text:span text:style-name="T24">esse, sum, fuī</text:span><text:span text:style-name="T18"> <text:s text:c="3"/></text:span><text:span text:style-name="T26">sein, sich befinden</text:span><text:span text:style-name="T21">2. 25</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T18"><text:span text:style-name="T18">gaudēre, gaudeō <text:s text:c="3"/></text:span><text:span text:style-name="T26">sich freuen</text:span><text:span text:style-name="T21">4</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T71"><text:span text:style-name="T93">gerere, gerō, gessī, </text:span><text:span text:style-name="T235">gestum</text:span><text:span text:style-name="T71"> <text:s text:c="3"/>ausführen, führen, tragen</text:span><text:span text:style-name="T79">29. 61</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">hostis, hostis</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">m</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">(Gen. Pl</text:span><text:span text:style-name="T26">. </text:span><text:span text:style-name="T24">-ium</text:span><text:span text:style-name="T90">)</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>der Feind (Landesfeind)</text:span><text:span text:style-name="T21">35</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T18">inīre, ineō, iniī</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>hineingehen (in), beginnen</text:span><text:span text:style-name="T21">37</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T179">laetus, laeta, laetum</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>froh; fruchtbar</text:span><text:span text:style-name="T21">52</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T18"><text:span text:style-name="T16">Līvia, Līviae</text:span><text:span text:style-name="T90">f</text:span><text:span text:style-name="T18"> <text:s text:c="3"/></text:span><text:span text:style-name="T26">Livia (Frau des Augustus)</text:span><text:span text:style-name="T21">63</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">nox, noctis</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">f</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">(Gen. Pl.</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T24">-ium</text:span><text:span text:style-name="T90">)</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>die Nacht</text:span><text:span text:style-name="T21">25</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T18"><text:span text:style-name="T179">Octāvius, Octāviī</text:span><text:span text:style-name="T18"> </text:span><text:span text:style-name="T90">m</text:span><text:span text:style-name="T18"> <text:s text:c="3"/></text:span><text:span text:style-name="T26">Octavius (der spätere Kaiser Augustus)</text:span><text:span text:style-name="T21">62</text:span><text:span text:style-name="T18"> </text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T18"><text:span text:style-name="T24">omnis, omne</text:span><text:span text:style-name="T18"> <text:s text:c="3"/></text:span><text:span text:style-name="T26">jeder, ganz; </text:span><text:span text:style-name="T90">Pl</text:span><text:span text:style-name="T26">. alle</text:span><text:span text:style-name="T21">33</text:span><text:span text:style-name="T18"> </text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T18"><text:span text:style-name="T24">postquam</text:span><text:span text:style-name="T18"> </text:span><text:span text:style-name="T90">Subj. m. Perf</text:span><text:span text:style-name="T26">. <text:s text:c="3"/>nachdem, als</text:span><text:span text:style-name="T21">33</text:span><text:span text:style-name="T18"> </text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T18"><text:span text:style-name="T24">timēre, timeō, timuī</text:span><text:span text:style-name="T18"> <text:s text:c="3"/></text:span><text:span text:style-name="T26">fürchten, Angst haben</text:span><text:span text:style-name="T21">2</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T173"><text:span text:style-name="T182">vincere, vincō, vīcī, victum</text:span><text:span text:style-name="T173"> <text:s text:c="3"/>(be)siegen, </text:span><text:span text:style-name="T26">übertreffen</text:span><text:span text:style-name="T21">27</text:span></text:p>
   </text:section>
