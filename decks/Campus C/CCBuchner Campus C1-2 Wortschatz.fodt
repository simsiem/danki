    <text:p text:style-name="P26" loext:marker-style-name="T43"><text:span text:style-name="T53">sal</text:span><text:span text:style-name="T129">ū</text:span><text:span text:style-name="T53">s, sal</text:span><text:span text:style-name="T129">ū</text:span><text:span text:style-name="T53">tis</text:span><text:span text:style-name="T119"> </text:span><text:span text:style-name="T55">f <text:s text:c="3"/></text:span><text:span text:style-name="T43">die Gesundheit, die Rettung, der Gruß, das Glück</text:span><text:span text:style-name="T44">25</text:span><text:span text:style-name="T43"> </text:span></text:p>
    <text:p text:style-name="P26" loext:marker-style-name="T43"><text:span text:style-name="T53">sed <text:s/></text:span><text:span text:style-name="T43"><text:s text:c="2"/>aber, sondern</text:span><text:span text:style-name="T44">3</text:span><text:span text:style-name="T43"> </text:span></text:p>
    <text:p text:style-name="P26" loext:marker-style-name="T43"><text:span text:style-name="T56">superbia</text:span><text:span text:style-name="T43"> <text:s text:c="3"/>der Stolz, der Hochmut</text:span><text:span text:style-name="T44">9</text:span><text:span text:style-name="T43"> </text:span></text:p>
