    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">miser, misera, miserum</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>arm, erbärmlich, unglücklich</text:span><text:span text:style-name="T21">15</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T179">monēre, moneō, monuī, monitum</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>mahnen, ermahnen</text:span><text:span text:style-name="T21">2. 47</text:span></text:p>
