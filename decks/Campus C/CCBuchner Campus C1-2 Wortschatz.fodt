    <text:p text:style-name="P37" loext:marker-style-name="T71"><text:span text:style-name="T80">Haemōn, Haemōnis</text:span><text:span text:style-name="T71"> </text:span><text:span text:style-name="T74">m</text:span><text:span text:style-name="T71"> <text:s text:c="3"/>Haimon (Sohn des thebanischen Königs Kreon und Verlobter der Antigone)</text:span><text:span text:style-name="T79">XXI</text:span><text:span text:style-name="T76"> </text:span></text:p>
