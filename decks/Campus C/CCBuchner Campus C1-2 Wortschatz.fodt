    <text:p text:style-name="P37" loext:marker-style-name="T21"><text:span text:style-name="T24">annus, anni</text:span><text:span text:style-name="T18"> </text:span><text:span text:style-name="T90">n</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>das</text:span><text:span text:style-name="T18"> </text:span><text:span text:style-name="T26">Jahr</text:span><text:span text:style-name="T21">22</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">ante</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">Präp. m. Akk.</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>vor</text:span><text:span text:style-name="T21">12</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T18"><text:span text:style-name="T24">audīre, audiō, audīvī, audītum</text:span><text:span text:style-name="T18"> <text:s text:c="3"/></text:span><text:span text:style-name="T26">hören</text:span><text:span text:style-name="T21">10</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T16">cantāre, cantō, cantāvī, cantātum</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>singen, dichten</text:span><text:span text:style-name="T21">50</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T16">carmen, carminis</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">n</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>das Gedicht, das Lied</text:span><text:span text:style-name="T21">50</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T18">conicere, coniciō, coniēcī, coniectum</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>(zusammen)werfen, folgern, vermuten</text:span><text:span text:style-name="T21">38</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">crēdere, crēdō, crēdidī, credītum</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>glauben, anvertrauen</text:span><text:span text:style-name="T21">35</text:span></text:p>
