    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T179">laetus, laeta, laetum</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>froh; fruchtbar</text:span><text:span text:style-name="T21">52</text:span></text:p>
