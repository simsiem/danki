    <text:p text:style-name="P37" loext:marker-style-name="T21"><text:span text:style-name="T18">Polybus</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>Polybus</text:span><text:span text:style-name="T21">0</text:span></text:p>
