    <text:p text:style-name="P24" loext:marker-style-name="T40"><text:span text:style-name="T32">in </text:span><text:span text:style-name="T39">Präp. m. Akk. <text:s text:c="3"/></text:span><text:span text:style-name="T40">in (... hinein), nach </text:span><text:span text:style-name="T39">(wohin?)</text:span><text:span text:style-name="T37">12</text:span><text:span text:style-name="T40"> <text:s/></text:span></text:p>
