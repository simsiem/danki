 <office:body>
  <office:text text:use-soft-page-breaks="true">
   <text:sequence-decls>
    <text:sequence-decl text:display-outline-level="0" text:name="Illustration"/>
    <text:sequence-decl text:display-outline-level="0" text:name="Table"/>
    <text:sequence-decl text:display-outline-level="0" text:name="Text"/>
    <text:sequence-decl text:display-outline-level="0" text:name="Drawing"/>
    <text:sequence-decl text:display-outline-level="0" text:name="Figure"/>
   </text:sequence-decls>
   <text:h text:style-name="P1" text:outline-level="1"><text:bookmark-start text:name="Lektion_04_01"/><text:bookmark-start text:name="Lektion_04"/><text:bookmark-start text:name="Lektion42_T"/>LEKTION 38. E, Seite 14 <text:s text:c="2"/></text:h>
   <text:p text:style-name="P2"><text:span text:style-name="T1">Alexander, Alexandr</text:span><text:span text:style-name="T2">ī</text:span><text:span text:style-name="T3"> <text:s text:c="2"/></text:span><text:span text:style-name="T4"><text:s/>Alexander der Große </text:span><text:span text:style-name="T5">(König von Makedonien </text:span><text:span text:style-name="T6">356-323 v. Chr.</text:span><text:span text:style-name="T5">)</text:span><text:span text:style-name="T7">38</text:span></text:p>
   <text:p text:style-name="P2"><text:span text:style-name="T3">Aristotel</text:span><text:span text:style-name="T8">ē</text:span><text:span text:style-name="T3">s, Aristotelis</text:span><text:span text:style-name="T4"> </text:span><text:span text:style-name="T5">m <text:s text:c="3"/></text:span><text:span text:style-name="T4">Aristoteles </text:span><text:span text:style-name="T5">(griech. Philosoph 384-322 v. Chr.)</text:span><text:span text:style-name="T7">39</text:span></text:p>
   <text:p text:style-name="P2"><text:span text:style-name="T9">bene</text:span><text:span text:style-name="T4"> </text:span><text:span text:style-name="T5">Adv. <text:s text:c="3"/></text:span><text:span text:style-name="T4">gut</text:span><text:span text:style-name="T7">4</text:span></text:p>
   <text:p text:style-name="P2"><text:span text:style-name="T9">#capere, cap</text:span><text:span text:style-name="T10">i</text:span><text:span text:style-name="T9">ō, </text:span><text:span text:style-name="T10">c</text:span><text:span text:style-name="T9">ē</text:span><text:span text:style-name="T10">p</text:span><text:span text:style-name="T4">ī <text:s text:c="3"/>fassen, nehmen, fangen; erobern</text:span><text:span text:style-name="T7">17. 27</text:span></text:p>
   <text:p text:style-name="P2"><text:span text:style-name="T9">c</text:span><text:span text:style-name="T10">ō</text:span><text:span text:style-name="T9">nsilium</text:span><text:span text:style-name="T4"> <text:s text:c="3"/>die Beratung, der </text:span><text:span text:style-name="T11">Beschluss</text:span><text:span text:style-name="T4">, der Plan, der Rat</text:span><text:span text:style-name="T7">11</text:span></text:p>
   <text:p text:style-name="P2"><text:span text:style-name="T9">dare, d</text:span><text:span text:style-name="T10">ō</text:span><text:span text:style-name="T9">, ded</text:span><text:span text:style-name="T10">ī</text:span><text:span text:style-name="T9">, datum</text:span><text:span text:style-name="T4"> <text:s text:c="3"/>geben</text:span><text:span text:style-name="T7">20. 28</text:span></text:p>
   <text:p text:style-name="P2"><text:span text:style-name="T3">d</text:span><text:span text:style-name="T8">ē</text:span><text:span text:style-name="T3">ligere, d</text:span><text:span text:style-name="T8">ē</text:span><text:span text:style-name="T3">lig</text:span><text:span text:style-name="T8">ō</text:span><text:span text:style-name="T3">, d</text:span><text:span text:style-name="T8">ē</text:span><text:span text:style-name="T3">l</text:span><text:span text:style-name="T8">ē</text:span><text:span text:style-name="T3">g</text:span><text:span text:style-name="T8">ī</text:span><text:span text:style-name="T4"> <text:s text:c="3"/>(aus)wählen</text:span><text:span text:style-name="T7">34</text:span></text:p>
   <text:p text:style-name="P2"><text:span text:style-name="T1">d</text:span><text:span text:style-name="T2">ī</text:span><text:span text:style-name="T1">ves, d</text:span><text:span text:style-name="T2">ī</text:span><text:span text:style-name="T1">vitis</text:span><text:span text:style-name="T4"> <text:s text:c="3"/>reich</text:span><text:span text:style-name="T7">38</text:span></text:p>
   <text:p text:style-name="P2"><text:span text:style-name="T3">doc</text:span><text:span text:style-name="T8">ē</text:span><text:span text:style-name="T3">re, doce</text:span><text:span text:style-name="T8">ō</text:span><text:span text:style-name="T3">, docu</text:span><text:span text:style-name="T8">ī</text:span><text:span text:style-name="T4"> <text:s text:c="3"/>lehren, unterrichten</text:span><text:span text:style-name="T7">3</text:span></text:p>
   <text:p text:style-name="P2"><text:span text:style-name="T9">esse, sum, fu</text:span><text:span text:style-name="T10">ī</text:span><text:span text:style-name="T4"> <text:s text:c="3"/>sein, sich befinden</text:span><text:span text:style-name="T7">2. 25</text:span></text:p>
   <text:p text:style-name="P2"><text:span text:style-name="T9">et</text:span><text:span text:style-name="T4"> <text:s text:c="3"/>und, auch</text:span><text:span text:style-name="T7">1</text:span></text:p>
   <text:p text:style-name="P2"><text:span text:style-name="T9">f</text:span><text:span text:style-name="T10">ī</text:span><text:span text:style-name="T9">lius</text:span><text:span text:style-name="T4"> <text:s text:c="3"/>der Sohn</text:span><text:span text:style-name="T7">9</text:span></text:p>
   <text:p text:style-name="P2"><text:span text:style-name="T9">fortis, e</text:span><text:span text:style-name="T4"> <text:s text:c="3"/>kräftig, tapfer</text:span><text:span text:style-name="T7">33</text:span><text:span text:style-name="T12"> </text:span></text:p>
   <text:p text:style-name="P2"><text:span text:style-name="T9">is, ea, id</text:span><text:span text:style-name="T4"> <text:s text:c="3"/>dieser, diese, dieses; er, sie, es</text:span><text:span text:style-name="T7">26</text:span></text:p>
   <text:p text:style-name="P2"><text:span text:style-name="T3">magister, magistr</text:span><text:span text:style-name="T8">ī</text:span><text:span text:style-name="T4"> </text:span><text:span text:style-name="T5">m <text:s text:c="3"/></text:span><text:span text:style-name="T4">der Lehrer, der Meister</text:span><text:span text:style-name="T7">15</text:span></text:p>
   <text:p text:style-name="P2"><text:span text:style-name="T9">meus, a, um</text:span><text:span text:style-name="T13"> </text:span><text:span text:style-name="T4"><text:s text:c="3"/>mein</text:span><text:span text:style-name="T7">14</text:span></text:p>
   <text:p text:style-name="P2"><text:span text:style-name="T1">multa, </text:span><text:span text:style-name="T2">ō</text:span><text:span text:style-name="T1">rum</text:span><text:span text:style-name="T4"> </text:span><text:span text:style-name="T5">n Pl. <text:s text:c="3"/></text:span><text:span text:style-name="T4">viel(es)</text:span><text:span text:style-name="T7">38</text:span></text:p>
   <text:p text:style-name="P2"><text:span text:style-name="T14">#</text:span><text:span text:style-name="T3">nam</text:span><text:span text:style-name="T4"> <text:s text:c="3"/>denn, nämlich</text:span><text:span text:style-name="T7">3</text:span></text:p>
   <text:p text:style-name="P2"><text:span text:style-name="T15">#</text:span><text:span text:style-name="T3">Olympia</text:span><text:span text:style-name="T4"> Olympia <text:s text:c="3"/></text:span><text:span text:style-name="T16">(eines der bedeutendsten griechischen Kulturzentren im Westen der Peloponnes; seit dem 8. Jh. V. Chr. Fanden dort alle vier Jahre Olympische Spiele statt.)</text:span><text:span text:style-name="T7">46</text:span></text:p>
   <text:p text:style-name="P2"><text:span text:style-name="T9">pater, patris</text:span><text:span text:style-name="T4"> </text:span><text:span text:style-name="T5">m <text:s text:c="3"/></text:span><text:span text:style-name="T17">der</text:span><text:span text:style-name="T5"> </text:span><text:span text:style-name="T4">Vater</text:span><text:span text:style-name="T7">20</text:span></text:p>
   <text:p text:style-name="P2"><text:span text:style-name="T1">Philippus</text:span><text:span text:style-name="T4"> <text:s text:c="3"/>Philipp II. </text:span><text:span text:style-name="T5">(König von Makedonien, Vater Alexanders des Großen, </text:span><text:span text:style-name="T6">um 382-336 v.Chr.</text:span><text:span text:style-name="T5">)</text:span><text:span text:style-name="T7">38</text:span></text:p>
   <text:p text:style-name="P2"><text:span text:style-name="T9">puer, puer</text:span><text:span text:style-name="T10">ī</text:span><text:span text:style-name="T13"> </text:span><text:span text:style-name="T5">m <text:s text:c="3"/></text:span><text:span text:style-name="T17">der </text:span><text:span text:style-name="T4">Junge, der Bub</text:span><text:span text:style-name="T7">15</text:span></text:p>
   <text:p text:style-name="P2"><text:span text:style-name="T9">pulcher, pulchra, pulchrum</text:span><text:span text:style-name="T4"> <text:s text:c="3"/>schön</text:span><text:span text:style-name="T7">15</text:span></text:p>
   <text:p text:style-name="P2"><text:span text:style-name="T9">r</text:span><text:span text:style-name="T10">ē</text:span><text:span text:style-name="T9">x, r</text:span><text:span text:style-name="T10">ē</text:span><text:span text:style-name="T9">gis</text:span><text:span text:style-name="T13"> </text:span><text:span text:style-name="T5">m <text:s text:c="3"/></text:span><text:span text:style-name="T17">der </text:span><text:span text:style-name="T4">König</text:span><text:span text:style-name="T7">27</text:span></text:p>
   <text:p text:style-name="P2"><text:span text:style-name="T1">sapi</text:span><text:span text:style-name="T2">ē</text:span><text:span text:style-name="T1">ns, sapientis</text:span><text:span text:style-name="T4"> <text:s text:c="3"/>klug, weise</text:span><text:span text:style-name="T7">38</text:span></text:p>
