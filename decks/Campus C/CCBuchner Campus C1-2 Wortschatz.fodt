   <text:section text:style-name="Sect3" text:name="Bereich122">
    <text:p text:style-name="P37" loext:marker-style-name="T18"><text:span text:style-name="T24">ā / ab</text:span><text:span text:style-name="T18"> </text:span><text:span text:style-name="T90">Präp. m. Abl.</text:span><text:span text:style-name="T18"> <text:s text:c="3"/></text:span><text:span text:style-name="T26">von, von ... her</text:span><text:span text:style-name="T21">16</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">accipere, accipiō, accēpī</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>erhalten, erfahren, annehmen</text:span><text:span text:style-name="T21">34</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">adesse, adsum, adfuī</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>da sein, helfen</text:span><text:span text:style-name="T21">18</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T18"><text:span text:style-name="T18">aedificāre, aedificō, aedificāvī, aedificātum <text:s text:c="3"/></text:span><text:span text:style-name="T26">bauen</text:span><text:span text:style-name="T21">11</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T18">aedificium, aedificiī</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">n</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>das Gebäude</text:span><text:span text:style-name="T21">11</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">agere, agō, ēgī, actum</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>handeln, treiben, verhandeln</text:span><text:span text:style-name="T21">27</text:span><text:span text:style-name="T26"> </text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">animus, animī </text:span><text:span text:style-name="T90">m</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>der Geist, der Mut, die Gesinnung</text:span><text:span text:style-name="T21">19</text:span><text:span text:style-name="T26"> </text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T18"><text:span text:style-name="T195">(Mārcus)</text:span><text:span text:style-name="T16"> Antōnius</text:span><text:span text:style-name="T18"> <text:s text:c="3"/></text:span><text:span text:style-name="T26">Antonius (römischer Politiker und Feldherr (um 85 v. Chr.-30 v. Chr.); machte Karriere unter Cäsar und wurde nach seiner Ermordung 44 v. Chr. einer der einflussreichsten Männer Roms)</text:span><text:span text:style-name="T21">62</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T180">atque / ac</text:span><text:span text:style-name="T24"> <text:s text:c="2"/></text:span><text:span text:style-name="T26"><text:s/>und, und auch</text:span><text:span text:style-name="T21">47</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T18">auctor, auctōris</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">m</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>der Anführer, der Gründer, der Schriftsteller, der Verfasser</text:span><text:span text:style-name="T21">39</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T174"><text:span text:style-name="T16">Augustus, Augustī</text:span><text:span text:style-name="T174"> </text:span><text:span text:style-name="T176">m</text:span><text:span text:style-name="T174"> <text:s text:c="3"/></text:span><text:span text:style-name="T173">Augustus (erster röm. Kaiser 27 v. Chr.– 14 n. Chr.)</text:span><text:span text:style-name="T181">63</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T18"><text:span text:style-name="T179">aureus, aurea, aureum</text:span><text:span text:style-name="T18"> <text:s text:c="3"/></text:span><text:span text:style-name="T26">golden, aus Gold</text:span><text:span text:style-name="T21">46</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T18"><text:span text:style-name="T24">bellum, belli</text:span><text:span text:style-name="T18"> </text:span><text:span text:style-name="T90">n</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>der Krieg</text:span><text:span text:style-name="T21">29</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">beneficium</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>die Wohltat</text:span><text:span text:style-name="T21">11</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T181"><text:span text:style-name="T174">bibliothēca, bibliothēcae </text:span><text:span text:style-name="T176">f</text:span><text:span text:style-name="T173"> <text:s text:c="3"/>vgl. Fw.</text:span><text:span text:style-name="T181">0</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">bonus, bona, bonum</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>gut, tüchtig</text:span><text:span text:style-name="T21">14</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T18">campus, campī</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">m <text:s text:c="3"/></text:span><text:span text:style-name="T26">das Feld, freier Platz</text:span><text:span text:style-name="T21">1</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T71"><text:span text:style-name="T93">civis, civis</text:span><text:span text:style-name="T71"> </text:span><text:span text:style-name="T74">m</text:span><text:span text:style-name="T71"> (</text:span><text:span text:style-name="T74">Gen. Pl</text:span><text:span text:style-name="T71">. </text:span><text:span text:style-name="T93">-ium</text:span><text:span text:style-name="T71">) <text:s text:c="3"/>der Bürger, die Bürgerin</text:span><text:span text:style-name="T79">30</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">clārus, clāra, clārum</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>klar, hell, berühmt</text:span><text:span text:style-name="T21">15</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T18"><text:span text:style-name="T24">cognōscere, cognōscō, cognōvī, </text:span><text:span text:style-name="T30">cognitum</text:span><text:span text:style-name="T18"> <text:s text:c="3"/></text:span><text:span text:style-name="T26">erkennen, kennenlernen; Perf. kennen, wissen</text:span><text:span text:style-name="T21">39.63</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">commūnis, commūne</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>gemeinsam, allgemein</text:span><text:span text:style-name="T21">35</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T18">condere, condō, condidī, </text:span><text:span text:style-name="T179">conditum</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>verwahren, verbergen; erbauen, gründen</text:span><text:span text:style-name="T21">34. 55</text:span><text:span text:style-name="T23"> </text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T174"><text:span text:style-name="T179">cōnficere, cōnficiō, cōnfēcī,</text:span><text:span text:style-name="T16"> cōnfectum</text:span><text:span text:style-name="T174"> <text:s text:c="3"/></text:span><text:span text:style-name="T173">fertig machen, beenden</text:span><text:span text:style-name="T181">44. 63</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T174"><text:span text:style-name="T174">crūdēlis, crūdēle <text:s text:c="3"/></text:span><text:span text:style-name="T173">grausam</text:span><text:span text:style-name="T181">33</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T174">dēdūcere, dēdūcō, dēdūxī, dēductum</text:span><text:span text:style-name="T173"> <text:s text:c="3"/>wegführen, hinführen</text:span><text:span text:style-name="T181">23. </text:span><text:span text:style-name="T21">54</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T18">dēlēre, dēleō, dēlēvī, dēlētum <text:s text:c="3"/></text:span><text:span text:style-name="T26">zerstören, vernichten</text:span><text:span text:style-name="T21">6. 25</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">diū</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">Adv.</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>lange (Zeit)</text:span><text:span text:style-name="T21">7</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T18">dīves, dīvitis</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>reich</text:span><text:span text:style-name="T21">38</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T18">dōnāre, dōnō, dōnāvī, dōnātum</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>schenken, beschenken</text:span><text:span text:style-name="T21">31</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T171"><text:span text:style-name="T24">ē / ex </text:span><text:span text:style-name="T168">Präp. m. Abl. <text:s text:c="2"/></text:span><text:span text:style-name="T171"><text:s/>aus, von ... her</text:span><text:span text:style-name="T170">12</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">esse, sum, fuī</text:span><text:span text:style-name="T18"> <text:s text:c="3"/></text:span><text:span text:style-name="T26">sein,</text:span><text:span text:style-name="T18"> </text:span><text:span text:style-name="T26">sich befinden</text:span><text:span text:style-name="T21">2. 25</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T18"><text:span text:style-name="T24">et</text:span><text:span text:style-name="T18"> <text:s text:c="3"/></text:span><text:span text:style-name="T26">und, auch</text:span><text:span text:style-name="T21">1</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T167"><text:span text:style-name="T24">etiam</text:span><text:span text:style-name="T18"> <text:s text:c="3"/></text:span><text:span text:style-name="T26">auch, sogar</text:span><text:span text:style-name="T21">5</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T18"><text:span text:style-name="T18">etsī <text:s text:c="3"/></text:span><text:span text:style-name="T26">auch wenn, obwohl</text:span><text:span text:style-name="T21">28</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T180">facere, faciō, fēcī, factum</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>machen, tun, handeln;</text:span><text:span text:style-name="T90"> </text:span><text:span text:style-name="T233">m. dopp. Akk</text:span><text:span text:style-name="T234">. jdn. zu etw. machen</text:span><text:span text:style-name="T21">17. 27. 48. 56</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T18">fēlix, fēlīcis <text:s text:c="3"/></text:span><text:span text:style-name="T26">erfolgreich, glückbringend, glücklich</text:span><text:span text:style-name="T21">38</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T18"><text:span text:style-name="T24">frūmentum, frūmentī</text:span><text:span text:style-name="T18"> </text:span><text:span text:style-name="T90">n</text:span><text:span text:style-name="T18"> <text:s text:c="3"/></text:span><text:span text:style-name="T26">das Getreide</text:span><text:span text:style-name="T21">11</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T18"><text:span text:style-name="T18">gaudēre, gaudeō <text:s text:c="3"/></text:span><text:span text:style-name="T26">sich freuen</text:span><text:span text:style-name="T21">4</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T71"><text:span text:style-name="T93">gerere, gerō, gessī, </text:span><text:span text:style-name="T235">gestum</text:span><text:span text:style-name="T71"> <text:s text:c="3"/>ausführen, führen, tragen</text:span><text:span text:style-name="T79">29. 61</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">hic, haec, hoc</text:span><text:span text:style-name="T18"> <text:s text:c="3"/></text:span><text:span text:style-name="T26">dieser, diese, dieses (hier); folgender</text:span><text:span text:style-name="T21">40</text:span></text:p>
