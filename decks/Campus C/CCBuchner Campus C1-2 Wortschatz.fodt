    <text:p text:style-name="P26" loext:marker-style-name="T43"><text:span text:style-name="T53">patria <text:s text:c="2"/></text:span><text:span text:style-name="T43"><text:s/>die Heimat</text:span><text:span text:style-name="T44">9</text:span><text:span text:style-name="T43"> </text:span></text:p>
