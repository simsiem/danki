    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T16">fēmina, fēminae</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">f <text:s text:c="3"/>die </text:span><text:span text:style-name="T26"><text:s/>Frau</text:span><text:span text:style-name="T21">62</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">fīnis, fīnis</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">m (Gen. Pl.</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T18">-ium</text:span><text:span text:style-name="T90">)</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>das Ende, die Grenze, das Ziel, der Zweck; Pl. das Gebiet</text:span><text:span text:style-name="T21">30</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T18"><text:span text:style-name="T16">fōrma, fōrmae</text:span><text:span text:style-name="T18"> </text:span><text:span text:style-name="T90">f <text:s text:c="3"/></text:span><text:span text:style-name="T26">die</text:span><text:span text:style-name="T18"> </text:span><text:span text:style-name="T26">Form, die Gestalt, die Schönheit</text:span><text:span text:style-name="T21">62</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">fortis, forte</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>kräftig, tapfer</text:span><text:span text:style-name="T21">33</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">habēre, habeō, habuī, habitum</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>haben, halten</text:span><text:span text:style-name="T21">6</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">hic, haec, hoc</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>dieser, diese, dieses (hier); folgender</text:span><text:span text:style-name="T21">40</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T18">honestus, honesta, honestum</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>ehrenhaft, angesehen</text:span><text:span text:style-name="T21">29</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">hostis, hostis</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">m</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">(Gen. Pl</text:span><text:span text:style-name="T26">. </text:span><text:span text:style-name="T24">-ium</text:span><text:span text:style-name="T90">)</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>der Feind (Landesfeind)</text:span><text:span text:style-name="T21">35</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T18"><text:span text:style-name="T18">idem, eadem, idem <text:s text:c="3"/></text:span><text:span text:style-name="T26">derselbe, der gleiche</text:span><text:span text:style-name="T21">42</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">ille, illa, illud</text:span><text:span text:style-name="T18"> <text:s text:c="3"/></text:span><text:span text:style-name="T26">jener, jene, jenes; der (dort); jener berühmte</text:span><text:span text:style-name="T21">40</text:span></text:p>
