    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">homō, hominis</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">m</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>der Mensch</text:span><text:span text:style-name="T21">23</text:span><text:span text:style-name="T26"> </text:span></text:p>
