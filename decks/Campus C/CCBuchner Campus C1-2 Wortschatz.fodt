   <text:section text:style-name="Sect3" text:name="Bereich128">
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">ā / ab</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">Präp. m. Abl</text:span><text:span text:style-name="T26">. <text:s text:c="3"/>von, von ... her</text:span><text:span text:style-name="T21">16</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T18"><text:span text:style-name="T18">Aegyptus, Aegyptī </text:span><text:span text:style-name="T90">f</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>Ägypten (röm. Provinz seit 30 v. Chr.)</text:span><text:span text:style-name="T21">XVIII.65</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T18">auctor, auctōris</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">m</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>der Anführer, der Gründer, der Schriftsteller, der Verfasser</text:span><text:span text:style-name="T21">39</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T174"><text:span text:style-name="T174">Augustus, Augustī </text:span><text:span text:style-name="T176">m</text:span><text:span text:style-name="T174"> <text:s text:c="3"/></text:span><text:span text:style-name="T173">Augustus (erster röm. Kaiser 27 v. Chr.– 14 n. Chr.)</text:span><text:span text:style-name="T181">63</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T180">capere, capiō, cēpī, captum</text:span><text:span text:style-name="T18"> </text:span><text:span text:style-name="T26"><text:s text:c="3"/>fassen, nehmen, fangen; erobern</text:span><text:span text:style-name="T21">17. 27. 48</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T18"><text:span text:style-name="T180">dux, ducis</text:span><text:span text:style-name="T18"> </text:span><text:span text:style-name="T90">m/f</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>der Anführer, die Anführerin</text:span><text:span text:style-name="T21">47</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T21"><text:span text:style-name="T24">dūcere, dūco, dūxī, </text:span><text:span text:style-name="T180">ductum</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>führen, ziehen</text:span><text:span text:style-name="T21">16. 27. 48</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T18"><text:span text:style-name="T18">ego </text:span><text:span text:style-name="T90">Nom</text:span><text:span text:style-name="T26">. <text:s text:c="3"/>ich (betont)13</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T18"><text:span text:style-name="T24">esse, sum, fuī</text:span><text:span text:style-name="T18"> <text:s text:c="3"/></text:span><text:span text:style-name="T26">sein, sich befinden</text:span><text:span text:style-name="T21">2. 25</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T180"><text:span text:style-name="T180">in </text:span><text:span text:style-name="T185">Präp. m. Abl</text:span><text:span text:style-name="T186">. <text:s text:c="3"/>in, an, auf, bei (wo?)</text:span><text:span text:style-name="T187">12</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T71"><text:span text:style-name="T93">in</text:span><text:span text:style-name="T71"> </text:span><text:span text:style-name="T74">Präp. m. Akk</text:span><text:span text:style-name="T71">. <text:s text:c="3"/>in (... hinein), nach (wohin?); gegen</text:span><text:span text:style-name="T79">12. 56</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">laudāre, laudō, laudāvī, laudātum</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>loben</text:span><text:span text:style-name="T21">8</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">mittere, mittō, mīsī, missum</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>(los)lassen, schicken, werfen</text:span><text:span text:style-name="T21">16. 27. 48</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T18">praesēns, praesentis <text:s text:c="3"/></text:span><text:span text:style-name="T26">anwesend, gegenwärtig</text:span><text:span text:style-name="T21">60</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">prōvincia, prōvinciae</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">f</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>die Provinz</text:span><text:span text:style-name="T21">9</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">pūgnāre, pūgnō, pūgnāvī, pūgnātum</text:span><text:span text:style-name="T18"> <text:s text:c="3"/></text:span><text:span text:style-name="T26">kämpfen</text:span><text:span text:style-name="T21">9</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T18">Rōmānus, Rōmāna, Rōmānum</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>römisch; Subst. Römer, Einwohner Roms</text:span><text:span text:style-name="T21">9. 14</text:span><text:span text:style-name="T26"> </text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">senātus, senātūs</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">m</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>der Senat, die Senatsversammlung</text:span><text:span text:style-name="T21">52</text:span></text:p>
   </text:section>
   <text:section text:style-name="Sect2" text:name="Bereich129">
    <text:p text:style-name="P39" loext:marker-style-name="T14"/>
