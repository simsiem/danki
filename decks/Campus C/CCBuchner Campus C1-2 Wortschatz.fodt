    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">ut</text:span><text:span text:style-name="T18"> </text:span><text:span text:style-name="T90">Adv</text:span><text:span text:style-name="T26">. <text:s text:c="3"/>wie</text:span><text:span text:style-name="T21">10</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T21"><text:soft-page-break/><text:span text:style-name="T24">ut</text:span><text:span text:style-name="T18"> </text:span><text:span text:style-name="T90">Subj. m. Konj</text:span><text:span text:style-name="T26">. <text:s text:c="3"/>dass, sodass; damit, um zu </text:span><text:span text:style-name="T90">m. Inf.</text:span><text:span text:style-name="T21">45. 59</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T18">Veianius, Veianiī </text:span><text:span text:style-name="T90">m</text:span><text:span text:style-name="T18"> <text:s text:c="3"/></text:span><text:span text:style-name="T26">Eigenname; früherer Gladiator</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T16">vēr, vēris</text:span><text:span text:style-name="T18"> </text:span><text:span text:style-name="T90">n</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>der Frühling</text:span><text:span text:style-name="T21">64</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T18"><text:span text:style-name="T16">vēre ineunte</text:span><text:span text:style-name="T18"> <text:s text:c="3"/></text:span><text:span text:style-name="T26">zu Beginn des Frühlings</text:span><text:span text:style-name="T21">64</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T21"><text:span text:style-name="T24">vidēre, videō, vīdī, vīsum <text:s text:c="2"/></text:span><text:span text:style-name="T26"><text:s/>sehen</text:span><text:span text:style-name="T21">7. 27. 48</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">vīs</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">f</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">(Akk.</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T24">vim</text:span><text:span text:style-name="T26">, </text:span><text:span text:style-name="T90">Abl.</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T24">vī</text:span><text:span text:style-name="T90">)</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>die Gewalt, die Kraft, die Menge</text:span><text:span text:style-name="T21">38</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T18">virtūs, virtūtis </text:span><text:span text:style-name="T90">f</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>die Tapferkeit, die Tüchtigkeit, die Leistung; die Tugend</text:span><text:span text:style-name="T21">22</text:span></text:p>
