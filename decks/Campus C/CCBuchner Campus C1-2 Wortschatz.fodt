    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">dēfendere, dēfendō, dēfendī, dēfēnsum</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">(</text:span><text:span text:style-name="T24">ā</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">m. Abl.)</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>abwehren, verteidigen (vor / gegen)</text:span><text:span text:style-name="T21">33</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">dīcere, dīcō, dīxī, dictum <text:s text:c="2"/></text:span><text:span text:style-name="T26"><text:s/>sagen, sprechen</text:span><text:span text:style-name="T21">16. 27</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T18"><text:span text:style-name="T24">ego</text:span><text:span text:style-name="T18"> </text:span><text:span text:style-name="T90">Nom.</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>ich </text:span><text:span text:style-name="T90">(betont)</text:span><text:span text:style-name="T21">13</text:span></text:p>
