    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T18">Rōmānus, Rōmāna, Rōmānum</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>römisch; </text:span><text:span text:style-name="T90">Subst</text:span><text:span text:style-name="T26">. der Römer, der Einwohner Roms</text:span><text:span text:style-name="T21">9. 14</text:span></text:p>
