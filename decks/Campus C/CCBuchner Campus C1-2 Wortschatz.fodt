    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">esse, sum, fuī</text:span><text:span text:style-name="T18"> <text:s text:c="3"/></text:span><text:span text:style-name="T26">sein,</text:span><text:span text:style-name="T18"> </text:span><text:span text:style-name="T26">sich befinden</text:span><text:span text:style-name="T21">2. 25</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">homō, hominis</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">m</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>der Mensch</text:span><text:span text:style-name="T21">23</text:span><text:span text:style-name="T26"> </text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T18">īgnōtus, īgnōta, īgnōtum</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>unbekannt</text:span><text:span text:style-name="T21">45</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T90"><text:span text:style-name="T24">nē</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">Subj. m. Konj</text:span><text:span text:style-name="T26">. <text:s text:c="3"/>dass nicht</text:span><text:span text:style-name="T21">45</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T21"><text:span text:style-name="T18">obscūrus, obscūra, obscūrum</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>dunkel</text:span><text:span text:style-name="T21">0</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T16">ōrāculum, ōrāculī</text:span><text:span text:style-name="T18"> </text:span><text:span text:style-name="T90">n </text:span><text:span text:style-name="T18"><text:s text:c="3"/></text:span><text:span text:style-name="T26">das Orakel, der Orakelspruch</text:span><text:span text:style-name="T21">59</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T18"><text:span text:style-name="T24">petere, petō, petīvī, petītum</text:span><text:span text:style-name="T18"> <text:s text:c="3"/></text:span><text:span text:style-name="T26">aufsuchen, (er)streben, bitten, verlangen</text:span><text:span text:style-name="T21">18. 29</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T18"><text:span text:style-name="T179">rēs futūrae, rērum futurārum</text:span><text:span text:style-name="T18"> </text:span><text:span text:style-name="T90">f Pl</text:span><text:span text:style-name="T26">. <text:s text:c="3"/>die Zukunft</text:span><text:span text:style-name="T21">53</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T179">sacerdōs, sacerdōtis</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">m/f</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>der/die Priester(in)</text:span><text:span text:style-name="T21">50</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T18"><text:span text:style-name="T24">sed</text:span><text:span text:style-name="T18"> <text:s text:c="3"/></text:span><text:span text:style-name="T26">aber, sondern</text:span><text:span text:style-name="T21">3</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T23"><text:span text:style-name="T24">tam</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>so</text:span><text:span text:style-name="T21">20</text:span><text:span text:style-name="T23"> </text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T173"><text:span text:style-name="T24">ut</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">Subj. m. Konj</text:span><text:span text:style-name="T26">. <text:s text:c="3"/>dass</text:span><text:span text:style-name="T21">45.</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T18">verbum, verbī </text:span><text:span text:style-name="T90">n</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>das Wort, die Äußerung</text:span><text:span text:style-name="T21">11</text:span></text:p>
