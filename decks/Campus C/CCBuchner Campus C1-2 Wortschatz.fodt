   <text:section text:style-name="Sect3" text:name="Bereich130">
    <text:p text:style-name="P37" loext:marker-style-name="T18"><text:span text:style-name="T24">ā / ab</text:span><text:span text:style-name="T18"> </text:span><text:span text:style-name="T90">Präp. m. Abl.</text:span><text:span text:style-name="T18"> <text:s text:c="3"/></text:span><text:span text:style-name="T26">von, von ... her</text:span><text:span text:style-name="T21">16</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T180">accidere, accidō, accidī</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>geschehen, sich ereignen</text:span><text:span text:style-name="T21">49</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T18">accūsāre, accūsō, accūsāvī, accūsātum</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>anklagen, beschuldigen</text:span><text:span text:style-name="T21">33</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T18"><text:span text:style-name="T18">Aegyptus, Aegyptī </text:span><text:span text:style-name="T90">f</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>Ägypten (röm. Provinz seit 30 v. Chr.)</text:span><text:span text:style-name="T21">XVIII.65</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">agere, agō, ēgī, actum</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>handeln, treiben, verhandeln</text:span><text:span text:style-name="T21">27</text:span><text:span text:style-name="T26"> </text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T18"><text:span text:style-name="T24">amīcitia, amīcitiae</text:span><text:span text:style-name="T18"> </text:span><text:span text:style-name="T90">f <text:s text:c="2"/></text:span><text:span text:style-name="T26">die</text:span><text:span text:style-name="T18"> </text:span><text:span text:style-name="T26">Freundschaft</text:span><text:span text:style-name="T21">43</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">amīcus, amicī</text:span><text:span text:style-name="T18"> </text:span><text:span text:style-name="T90">m</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>der Freund</text:span><text:span text:style-name="T21">4</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T180">atque / ac</text:span><text:span text:style-name="T24"> <text:s text:c="2"/></text:span><text:span text:style-name="T26"><text:s/>und, und auch</text:span><text:span text:style-name="T21">47</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T18">auctor, auctōris</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">m</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>der Anführer, der Gründer, der Schriftsteller, der Verfasser</text:span><text:span text:style-name="T21">39</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T18"><text:span text:style-name="T24">audīre, audiō, audīvī, audītum</text:span><text:span text:style-name="T18"> <text:s text:c="3"/></text:span><text:span text:style-name="T26">hören</text:span><text:span text:style-name="T21">10</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T174"><text:span text:style-name="T18">Augustus, Augustī </text:span><text:span text:style-name="T90">m</text:span><text:span text:style-name="T18"> <text:s text:c="3"/></text:span><text:span text:style-name="T26">Augustus (erster röm. </text:span><text:span text:style-name="T173">Kaiser 27 v. Chr.– 14 n. Chr.)</text:span><text:span text:style-name="T181">63</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T171"><text:span text:style-name="T177">Augustō absente</text:span><text:span text:style-name="T189"> <text:s text:c="3"/></text:span><text:span text:style-name="T171">in Abwesenheit von Augustus</text:span><text:span text:style-name="T170">65</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">bene</text:span><text:span text:style-name="T18"> </text:span><text:span text:style-name="T90">Adv.</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>gut</text:span><text:span text:style-name="T21">4</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T174">Caesar, Caesaris </text:span><text:span text:style-name="T176">m</text:span><text:span text:style-name="T173"> <text:s text:c="3"/>Gajus Julius Cäsar </text:span><text:span text:style-name="T176">(röm. </text:span><text:span text:style-name="T90">Politiker, Feldherr und Schriftsteller, 100-44 v. Chr.)</text:span><text:span text:style-name="T21">51</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T179"><text:span text:style-name="T177">Caesare invītō</text:span><text:span text:style-name="T179"> <text:s text:c="3"/></text:span><text:span text:style-name="T234">gegen den Willen Cäsars</text:span><text:span text:style-name="T236">65</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T179">carmen, carminis</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">n</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>das Gedicht, das Lied</text:span><text:span text:style-name="T21">50</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T173"><text:span text:style-name="T182">incipere, incipiō, coepī (incēpī), inceptum</text:span><text:span text:style-name="T174"> <text:s text:c="3"/></text:span><text:span text:style-name="T173">anfangen, beginnen</text:span><text:span text:style-name="T181">64</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T18"><text:span text:style-name="T24">colere, colō, coluī, cultum</text:span><text:span text:style-name="T18"> <text:s text:c="3"/></text:span><text:span text:style-name="T26">bewirtschaften, pflegen; verehren</text:span><text:span text:style-name="T21">64</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T18">concēdere, concēdō, concessī, concessum</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>erlauben, nachgeben, zugestehen</text:span><text:span text:style-name="T21">36</text:span><text:span text:style-name="T26"> </text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T18"><text:span text:style-name="T18">contrā </text:span><text:span text:style-name="T90">Präp. m. Akk</text:span><text:span text:style-name="T26">. <text:s text:c="3"/>gegen</text:span><text:span text:style-name="T21">38</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T71"><text:span text:style-name="T93">cum</text:span><text:span text:style-name="T71"> </text:span><text:span text:style-name="T74">Subj. m. Konj</text:span><text:span text:style-name="T71">. <text:s text:c="3"/>als, nachdem; weil; obwohl</text:span><text:span text:style-name="T79">61</text:span><text:span text:style-name="T71"> </text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T182">dē</text:span><text:span text:style-name="T173"> </text:span><text:span text:style-name="T176">Präp. m. Abl</text:span><text:span text:style-name="T173">. <text:s text:c="3"/></text:span><text:span text:style-name="T26">von, von ... her, von ... weg, von ... herab; über</text:span><text:span text:style-name="T21">14</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T197">deinde</text:span><text:span text:style-name="T18"> </text:span><text:span text:style-name="T90">Adv</text:span><text:span text:style-name="T26">. <text:s text:c="3"/>dann, hierauf</text:span><text:span text:style-name="T21">65</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T18"><text:span text:style-name="T177">dēnique</text:span><text:span text:style-name="T18"> </text:span><text:span text:style-name="T90">Adv</text:span><text:span text:style-name="T26">. <text:s text:c="3"/>schließlich, zuletzt</text:span><text:span text:style-name="T21">65</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">dīcere, dīcō, dīxī, dictum <text:s text:c="2"/></text:span><text:span text:style-name="T26"><text:s/>sagen, sprechen</text:span><text:span text:style-name="T21">16. 27</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T23"><text:span text:style-name="T180">dīgnus, dīgna, dīgnum</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">m. Abl</text:span><text:span text:style-name="T26">. <text:s text:c="3"/>wert, würdig (einer Sache)</text:span><text:span text:style-name="T21">56</text:span><text:span text:style-name="T23"> </text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">diū</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">Adv.</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>lange (Zeit)</text:span><text:span text:style-name="T21">7</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T18">dulcis, dulce</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>angenehm, süß</text:span><text:span text:style-name="T21">33</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">esse, sum, fuī</text:span><text:span text:style-name="T18"> <text:s text:c="3"/></text:span><text:span text:style-name="T26">sein,</text:span><text:span text:style-name="T18"> </text:span><text:span text:style-name="T26">sich befinden</text:span><text:span text:style-name="T21">2. 25</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T18"><text:span text:style-name="T24">et</text:span><text:span text:style-name="T18"> <text:s text:c="3"/></text:span><text:span text:style-name="T26">und, auch</text:span><text:span text:style-name="T21">1</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T167"><text:span text:style-name="T24">etiam</text:span><text:span text:style-name="T18"> <text:s text:c="3"/></text:span><text:span text:style-name="T26">auch, sogar</text:span><text:span text:style-name="T21">5</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T179">excitāre, excitō, excitāvī, excitātum</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>erregen, ermuntern, wecken</text:span><text:span text:style-name="T21">55</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T21"><text:span text:style-name="T177">fīdūcia, fīdūciae</text:span><text:span text:style-name="T18"> </text:span><text:span text:style-name="T90">f</text:span><text:span text:style-name="T18"> <text:s text:c="3"/></text:span><text:span text:style-name="T26">das</text:span><text:span text:style-name="T18"> </text:span><text:span text:style-name="T26">Vertrauen</text:span><text:span text:style-name="T21">65</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T177">flāgitium, flāgitiī</text:span><text:span text:style-name="T18"> </text:span><text:span text:style-name="T90">n</text:span><text:span text:style-name="T18"> <text:s text:c="3"/></text:span><text:span text:style-name="T26">die Schandtat, die Gemeinheit</text:span><text:span text:style-name="T21">65</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">fortūna, fortūnae</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">f</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>das Schicksal, das Glück</text:span><text:span text:style-name="T21">35</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T21"><text:span text:style-name="T18">Fulvius, fulviī </text:span><text:span text:style-name="T90">m <text:s text:c="3"/></text:span><text:span text:style-name="T26">Eigenname, Freund des Senators Plancus</text:span><text:span text:style-name="T21">0</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T174"><text:span text:style-name="T26">(C. Cornēlius)</text:span><text:span text:style-name="T18"> Gallus <text:s text:c="3"/></text:span><text:span text:style-name="T26">Gajus Cornelius Gallus (geb. ca. 70 v. Chr.; Gallus stammte aus niederen Verhältnissen und lernte nach Cäsars Ermordung den Dichter Vergil und Kaiser Augustus kennen. Gallus gilt als Begründer der römischen Elegie.)</text:span><text:span text:style-name="T21">65</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T23"><text:span text:style-name="T180">gravis, grave</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>schwer</text:span><text:span text:style-name="T21">54</text:span></text:p>
