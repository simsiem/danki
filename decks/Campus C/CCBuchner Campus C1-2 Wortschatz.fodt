    <text:p text:style-name="P37" loext:marker-style-name="T21"><text:span text:style-name="T24">in</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">Präp. m. Abl</text:span><text:span text:style-name="T26">. <text:s text:c="3"/>in, an, auf, bei (wo?)</text:span><text:span text:style-name="T21">12</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">in</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">Präp. m. Akk</text:span><text:span text:style-name="T26">. <text:s text:c="3"/>in (... hinein), nach (wohin?)</text:span><text:span text:style-name="T21">12</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">ingēns, ingentis</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>gewaltig, ungeheuer</text:span><text:span text:style-name="T21">45</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T18"><text:span text:style-name="T24">is, ea, id</text:span><text:span text:style-name="T18"> <text:s text:c="3"/></text:span><text:span text:style-name="T26">dieser, diese, dieses; er, sie, es</text:span><text:span text:style-name="T21">26</text:span><text:span text:style-name="T18"> </text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T181"><text:span text:style-name="T174">latus, lata, latum</text:span><text:span text:style-name="T173"> <text:s text:c="3"/>breit</text:span><text:span text:style-name="T181">0</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T30">legiō, legiōnis</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">f</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>die Legion </text:span><text:span text:style-name="T90">(ca. 5000-6000 Mann)</text:span><text:span text:style-name="T21">51</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">locus, loca</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">m</text:span><text:span text:style-name="T26"> <text:s text:c="2"/>der Ort, der Platz, die Stelle</text:span><text:span text:style-name="T21">33</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T21"><text:span text:style-name="T18">longē abesse (a) <text:s text:c="3"/></text:span><text:span text:style-name="T26">weit entfernt sein (von)</text:span><text:span text:style-name="T21">0</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T167"><text:span text:style-name="T24">magnus, magna, magnum</text:span><text:span text:style-name="T18"> <text:s text:c="3"/></text:span><text:span text:style-name="T26">groß, bedeutend</text:span><text:span text:style-name="T21">14</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T18">mālle, mālō, māluī</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>lieber wollen</text:span><text:span text:style-name="T21">19. 25</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T30">mare, maris</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">n</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">(Abl. Sg</text:span><text:span text:style-name="T26">. </text:span><text:span text:style-name="T24">-ī</text:span><text:span text:style-name="T90">,</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">Nom. / Akk. Pl.</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T24">-ia</text:span><text:span text:style-name="T26">, </text:span><text:span text:style-name="T90">Gen. Pl.</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T24">-ium</text:span><text:span text:style-name="T90">)</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>das Meer</text:span><text:span text:style-name="T21">51</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">mīles, mīlitis</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">m</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>der Soldat</text:span><text:span text:style-name="T21">32</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T30">mīlle</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">Sg. indekl</text:span><text:span text:style-name="T26">. <text:s text:c="3"/>tausend</text:span><text:span text:style-name="T21">51</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T18">mīrus, mīra, mīrum</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>erstaunlich, sonderbar</text:span><text:span text:style-name="T21">24</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T16">moenia, moenium</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">n Pl.</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>die Mauern, die Stadtmauern</text:span><text:span text:style-name="T21">51</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">movēre, moveō, mōvī, mōtum</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>bewegen, beeindrucken</text:span><text:span text:style-name="T21">7. 27</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T18"><text:span text:style-name="T24">multus, multa, multum</text:span><text:span text:style-name="T18"> <text:s text:c="3"/></text:span><text:span text:style-name="T26">viel</text:span><text:span text:style-name="T21">14</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T18">mūnīre, mūniō, mūnīvī, mūnītum</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>bauen, befestigen, schützen</text:span><text:span text:style-name="T21">31</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T18"><text:span text:style-name="T24">nam</text:span><text:span text:style-name="T18"> <text:s text:c="3"/></text:span><text:span text:style-name="T26">denn, nämlich</text:span><text:span text:style-name="T21">3</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T30">nāvis, nāvis</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">f</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">(Abl. Sg.</text:span><text:span text:style-name="T18"> </text:span><text:span text:style-name="T24">-ī</text:span><text:span text:style-name="T26">, </text:span><text:span text:style-name="T90">Gen. Pl</text:span><text:span text:style-name="T26">. </text:span><text:span text:style-name="T24">-ium</text:span><text:span text:style-name="T90">)</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>das Schiff</text:span><text:span text:style-name="T21">51</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">nōlle, nōlō, nōluī</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>nicht wollen</text:span><text:span text:style-name="T21">19. 25</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">nōn</text:span><text:span text:style-name="T18"> <text:s text:c="3"/></text:span><text:span text:style-name="T26">nicht</text:span><text:span text:style-name="T21">2</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T30">numerus, numerī</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">m</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>die Zahl, die Menge</text:span><text:span text:style-name="T21">51</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">pēs, pedis</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">m <text:s text:c="2"/></text:span><text:span text:style-name="T26"><text:s/>der </text:span><text:span text:style-name="T90">Fuß (als Längenmaß: ca. 30 cm)</text:span><text:span text:style-name="T21">50</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">per</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">Präp. m. Akk</text:span><text:span text:style-name="T26">. <text:s text:c="3"/>durch, hindurch</text:span><text:span text:style-name="T21">16</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">perīculum, perīculī</text:span><text:span text:style-name="T18"> </text:span><text:span text:style-name="T90">n</text:span><text:span text:style-name="T18"> <text:s text:c="3"/></text:span><text:span text:style-name="T26">die Gefahr</text:span><text:span text:style-name="T21">24</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T18">pōns, pontis</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">m (Gen. Pl.</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T18">-ium</text:span><text:span text:style-name="T90">)</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>die Brücke</text:span><text:span text:style-name="T21">40</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">populus, populī</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">m</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>das Volk</text:span><text:span text:style-name="T21">6</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">postquam</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">Subj. m. Perf</text:span><text:span text:style-name="T26">. <text:s text:c="3"/>nachdem, als</text:span><text:span text:style-name="T21">33</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T18">prīmō</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">Adv</text:span><text:span text:style-name="T26">. <text:s text:c="3"/>zuerst</text:span><text:span text:style-name="T21">4</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">quamquam</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">Subj</text:span><text:span text:style-name="T26">. <text:s text:c="3"/>obwohl</text:span><text:span text:style-name="T21">19</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T18">quārtus, quārta, quārtum</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>der (die, das) vierte</text:span><text:span text:style-name="T21">14</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:soft-page-break/><text:span text:style-name="T24">quī, quae, quod</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>der, die, das</text:span><text:span text:style-name="T21">34</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T16">quīndecim</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">indekl</text:span><text:span text:style-name="T26">. <text:s text:c="3"/>fünfzehn</text:span><text:span text:style-name="T21">51</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T16">quīngentī, quīngentae, quīngenta</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>fünfhundert</text:span><text:span text:style-name="T21">51</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T18">rapere, rapiō, rapuī, raptum</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>wegführen, rauben, wegreißen</text:span><text:span text:style-name="T21">49</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">relinquere, relinquō, relīquī, relictum</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>verlassen, zurücklassen</text:span><text:span text:style-name="T21">16. 27. 50</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">rēs, reī</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">f</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>die Angelegenheit, das Ding, die Sache</text:span><text:span text:style-name="T21">41</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T21"><text:span text:style-name="T18">Rhenus, Rhenī</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">m <text:s text:c="3"/></text:span><text:span text:style-name="T26">der Rhein</text:span><text:span text:style-name="T21">0</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T18">Rōmānus, Rōmāna, Rōmānum</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>römisch; </text:span><text:span text:style-name="T90">Subst</text:span><text:span text:style-name="T26">. der Römer, der Einwohner Roms</text:span><text:span text:style-name="T21">9. 14</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T18"><text:span text:style-name="T24">sed</text:span><text:span text:style-name="T18"> <text:s text:c="3"/></text:span><text:span text:style-name="T26">aber, sondern</text:span><text:span text:style-name="T21">3</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">sine</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">Präp. m. Abl</text:span><text:span text:style-name="T26">. <text:s text:c="3"/>ohne</text:span><text:span text:style-name="T21">12</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">socius, sociī</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">m</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>der Gefährte, Verbündeter</text:span><text:span text:style-name="T21">47</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T23"><text:span text:style-name="T24">sōlum</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">Adv</text:span><text:span text:style-name="T26">. <text:s text:c="3"/>nur</text:span><text:span text:style-name="T21">21</text:span><text:span text:style-name="T23"> </text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T23"><text:span text:style-name="T18">terrēre, terreō, terruī, territum <text:s text:c="3"/></text:span><text:span text:style-name="T26">erschrecken</text:span><text:span text:style-name="T21">5</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">trānsīre, trānseō, trānsiī</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>durchqueren, hinübergehen, überschreiten</text:span><text:span text:style-name="T21">44</text:span><text:span text:style-name="T26"> </text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">trēs, trēs, tria</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>drei</text:span><text:span text:style-name="T21">33</text:span><text:span text:style-name="T26"> </text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T16">trīgintā</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">indekl</text:span><text:span text:style-name="T26">. <text:s text:c="3"/>dreißig</text:span><text:span text:style-name="T21">51</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">tum</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">Adv</text:span><text:span text:style-name="T26">. <text:s text:c="3"/>da, dann, darauf, damals</text:span><text:span text:style-name="T21">4</text:span><text:span text:style-name="T26"> </text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T16">turris, turris</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">f</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">(Akk. Sg.</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T18">-im</text:span><text:span text:style-name="T26">, </text:span><text:span text:style-name="T90">Abl. Sg.</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T18">-ī</text:span><text:span text:style-name="T26">, </text:span><text:span text:style-name="T90">Gen. Pl.</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T18">-ium</text:span><text:span text:style-name="T90">)</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>der Turm</text:span><text:span text:style-name="T21">51</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">ūnus, ūna, ūnum</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>einer, ein einziger</text:span><text:span text:style-name="T21">33</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T18"><text:span text:style-name="T24">venīre, veniō, vēnī, ventum</text:span><text:span text:style-name="T18"> <text:s text:c="3"/></text:span><text:span text:style-name="T26">kommen</text:span><text:span text:style-name="T21">10. 27</text:span><text:span text:style-name="T167"> </text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T21"><text:span text:style-name="T24">vidēre, videō, vīdī, vīsum <text:s text:c="2"/></text:span><text:span text:style-name="T26"><text:s/>sehen</text:span><text:span text:style-name="T21">7. 27. 48</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T21"><text:span text:style-name="T24">vir, virī</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">m</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>der Mann</text:span><text:span text:style-name="T21">15</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T21"><text:span text:style-name="T24">velle, volō, voluī</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>wollen</text:span><text:span text:style-name="T21">19. </text:span></text:p>
   </text:section>
