   </text:section>
   <text:section text:style-name="Sect3" text:name="Bereich56">
    <text:p text:style-name="P37" loext:marker-style-name="T18"><text:span text:style-name="T24">ā / ab</text:span><text:span text:style-name="T18"> </text:span><text:span text:style-name="T90">Präp. m. Abl.</text:span><text:span text:style-name="T18"> <text:s text:c="3"/></text:span><text:span text:style-name="T26">von, von ... her</text:span><text:span text:style-name="T21">16</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T30">accidere, accidō, accidī</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>geschehen, sich ereignen</text:span><text:span text:style-name="T21">49</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">adhūc</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">Adv</text:span><text:span text:style-name="T26">. <text:s text:c="3"/>bis jetzt, noch</text:span><text:span text:style-name="T21">3</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">ager, agrī</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">m</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>der Acker, das Feld, das Gebiet</text:span><text:span text:style-name="T21">15</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T21"><text:span text:style-name="T24">annus, anni</text:span><text:span text:style-name="T18"> </text:span><text:span text:style-name="T90">n</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>das</text:span><text:span text:style-name="T18"> </text:span><text:span text:style-name="T26">Jahr</text:span><text:span text:style-name="T21">22</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T18">auctor, auctōris</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">m</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>der Anführer, der Gründer, der Schriftsteller, der Verfasser</text:span><text:span text:style-name="T21">39</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T18"><text:span text:style-name="T24">audīre, audiō, audīvī, audītum</text:span><text:span text:style-name="T18"> <text:s text:c="3"/></text:span><text:span text:style-name="T26">hören</text:span><text:span text:style-name="T21">10</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T18">augēre, augeō, auxī, auctum</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>vergrößern, vermehren</text:span><text:span text:style-name="T21">3. 28</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T30">certus, certa, certum</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>sicher, bestimmt</text:span><text:span text:style-name="T21">49</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T18">cōgitāre, cōgitō, cōgitāvī, cōgitātum <text:s text:c="2"/></text:span><text:span text:style-name="T26"><text:s/>denken, beabsichtigen</text:span><text:span text:style-name="T21">30</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">contendere, contendō, contendī</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>sich anstrengen, kämpfen; eilen; behaupten</text:span><text:span text:style-name="T21">34</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T193"><text:span text:style-name="T174">Cornelia, Corneliae </text:span><text:span text:style-name="T176">f</text:span><text:span text:style-name="T174"> <text:s text:c="3"/></text:span><text:span text:style-name="T173">Mutter des Gaius Sempronius Gracchus</text:span><text:span text:style-name="T181">0</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T30">corpus, corporis</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">n</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>der Körper, der Leichnam</text:span><text:span text:style-name="T21">49</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T18">creāre, creō, creāvī, creātum</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>erschaffen, wählen</text:span><text:span text:style-name="T21">18</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T18"><text:span text:style-name="T24">cūr?</text:span><text:span text:style-name="T18"> <text:s text:c="3"/></text:span><text:span text:style-name="T26">warum?</text:span><text:span text:style-name="T21">2</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T180">dare, dō, dedī, datum</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>geben</text:span><text:span text:style-name="T21">20. 28. 47</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T18">dēlēre, dēleō, dēlēvī, dēlētum <text:s text:c="3"/></text:span><text:span text:style-name="T26">zerstören, vernichten</text:span><text:span text:style-name="T21">6. 25</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T18">dīves, dīvitis</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>reich</text:span><text:span text:style-name="T21">38</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">dīcere, dīcō, dīxī, dictum <text:s text:c="2"/></text:span><text:span text:style-name="T26"><text:s/>sagen, sprechen</text:span><text:span text:style-name="T21">16. 27</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">dolor, dolōris</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">m</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>der Schmerz</text:span><text:span text:style-name="T21">22</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">ē / ex</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">Präp. m. Abl</text:span><text:span text:style-name="T26">. <text:s text:c="3"/>aus, von ... her</text:span><text:span text:style-name="T21">12</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T18"><text:span text:style-name="T24">esse, sum, fuī</text:span><text:span text:style-name="T18"> <text:s text:c="3"/></text:span><text:span text:style-name="T26">sein, sich befinden</text:span><text:span text:style-name="T21">2. 25</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T18"><text:span text:style-name="T24">et</text:span><text:span text:style-name="T18"> <text:s text:c="3"/></text:span><text:span text:style-name="T26">und, auch</text:span><text:span text:style-name="T21">1</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T167"><text:span text:style-name="T24">etiam</text:span><text:span text:style-name="T18"> <text:s text:c="3"/></text:span><text:span text:style-name="T26">auch, sogar</text:span><text:span text:style-name="T21">5</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T18">fluvius, fluviī</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">m</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>der Fluss</text:span><text:span text:style-name="T21">6</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">fortūna, fortūnae</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">f</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>das Schicksal, das Glück</text:span><text:span text:style-name="T21">35</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">frāter, frātris</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">m</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>der Bruder</text:span><text:span text:style-name="T21">20</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T18"><text:span text:style-name="T24">frūmentum, frūmentī</text:span><text:span text:style-name="T18"> </text:span><text:span text:style-name="T90">n</text:span><text:span text:style-name="T18"> <text:s text:c="3"/></text:span><text:span text:style-name="T26">das Getreide</text:span><text:span text:style-name="T21">11</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T181"><text:span text:style-name="T174">Gaius, Gaī </text:span><text:span text:style-name="T176">m</text:span><text:span text:style-name="T173"> <text:s text:c="3"/>Gaius Sempronius Gracchus</text:span><text:span text:style-name="T181">0</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T180">gēns, gentis</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">f</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">(Gen. Pl</text:span><text:span text:style-name="T26">. </text:span><text:span text:style-name="T18">-ium</text:span><text:span text:style-name="T90">) <text:s text:c="2"/></text:span><text:span text:style-name="T26"><text:s/>der Familienverband, der Stamm, das Volk</text:span><text:span text:style-name="T21">47</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">homō, hominis</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">m</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>der Mensch</text:span><text:span text:style-name="T21">23</text:span><text:span text:style-name="T26"> </text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T18"><text:span text:style-name="T24">iam</text:span><text:span text:style-name="T18"> </text:span><text:span text:style-name="T90">Adv.</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>schon, bereits; nun</text:span><text:span text:style-name="T21">4</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">in</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">Präp. m. Abl</text:span><text:span text:style-name="T26">. <text:s text:c="3"/>in, an, auf, bei </text:span><text:span text:style-name="T90">(wo?)</text:span><text:span text:style-name="T21">12</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T30">interficere, interficiō, interfēcī, interfectum</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>töten, vernichten</text:span><text:span text:style-name="T21">22. 27. 49</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T18"><text:span text:style-name="T24">is, ea, id</text:span><text:span text:style-name="T18"> <text:s text:c="3"/></text:span><text:span text:style-name="T26">dieser, diese, dieses; er, sie, es</text:span><text:span text:style-name="T21">26</text:span><text:span text:style-name="T18"> </text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">ita</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">Adv</text:span><text:span text:style-name="T26">. <text:s text:c="3"/>so</text:span><text:span text:style-name="T21">13</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T167"><text:span text:style-name="T182">itaque </text:span><text:span text:style-name="T192">Adv.</text:span><text:span text:style-name="T174"> <text:s text:c="3"/></text:span><text:span text:style-name="T26">deshalb</text:span><text:span text:style-name="T21">5</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T18">iterum </text:span><text:span text:style-name="T90">Adv.</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>wiederum, zum zweiten Mal</text:span><text:span text:style-name="T21">5</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T18"><text:span text:style-name="T24">lēx, lēgis</text:span><text:span text:style-name="T18"> </text:span><text:span text:style-name="T90">f</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>das Gesetz, die Bedingung</text:span><text:span text:style-name="T21">36</text:span><text:span text:style-name="T18"> </text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">licet</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>es ist erlaubt, es ist möglich</text:span><text:span text:style-name="T21">18</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T167"><text:span text:style-name="T24">magnus, magna, magnum</text:span><text:span text:style-name="T18"> <text:s text:c="3"/></text:span><text:span text:style-name="T26">groß, bedeutend</text:span><text:span text:style-name="T21">14</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">māter, mātris</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">f</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>die Mutter</text:span><text:span text:style-name="T21">20</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T18"><text:span text:style-name="T18">mē </text:span><text:span text:style-name="T90">Akk</text:span><text:span text:style-name="T26">. <text:s text:c="3"/>mich</text:span><text:span text:style-name="T21">13</text:span><text:span text:style-name="T18"> </text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T18"><text:span text:style-name="T24">meus, mea, meum</text:span><text:span text:style-name="T18"> <text:s text:c="3"/></text:span><text:span text:style-name="T26">mein</text:span><text:span text:style-name="T21">14</text:span><text:span text:style-name="T18"> </text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">miser, misera, miserum</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>arm, erbärmlich, unglücklich</text:span><text:span text:style-name="T21">15</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">negāre, negō, negāvī, negātum</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>leugnen, verneinen, verweigern</text:span><text:span text:style-name="T21">45</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">nisī</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">Subj</text:span><text:span text:style-name="T26">. <text:s text:c="3"/>wenn nicht</text:span><text:span text:style-name="T21">23</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T23"><text:span text:style-name="T30">nōmen, nōminis</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">n</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>der Name</text:span><text:span text:style-name="T21">49</text:span><text:span text:style-name="T23"> </text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">nōn</text:span><text:span text:style-name="T18"> <text:s text:c="3"/></text:span><text:span text:style-name="T26">nicht</text:span><text:span text:style-name="T21">2</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T18">nōnne?</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>(etwa) nicht?</text:span><text:span text:style-name="T21">17</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T18"><text:span text:style-name="T24">noster, nostra, nostrum</text:span><text:span text:style-name="T18"> <text:s text:c="3"/></text:span><text:span text:style-name="T26">unser</text:span><text:span text:style-name="T21">15</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T167"><text:span text:style-name="T24">novus, nova, novum</text:span><text:span text:style-name="T18"> <text:s text:c="3"/></text:span><text:span text:style-name="T26">neu, ungewöhnlich</text:span><text:span text:style-name="T21">14</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T30">nūllus, nūlla, nūllum</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">(Gen</text:span><text:span text:style-name="T26">. </text:span><text:span text:style-name="T24">nūllīus</text:span><text:span text:style-name="T26">, </text:span><text:span text:style-name="T90">Dat</text:span><text:span text:style-name="T26">. </text:span><text:span text:style-name="T24">nūllī</text:span><text:span text:style-name="T90">)</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>kein</text:span><text:span text:style-name="T21">49</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T18">occidere, occidō, occidī</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>(zu Boden) fallen, umkommen, untergehen</text:span><text:span text:style-name="T21">28</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">officium, officiī</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">n</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>der Dienst, die Pflicht, das Pflichtgefühl</text:span><text:span text:style-name="T21">28</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T18"><text:span text:style-name="T24">omnis, omne</text:span><text:span text:style-name="T18"> <text:s text:c="3"/></text:span><text:span text:style-name="T26">jeder, ganz; </text:span><text:span text:style-name="T90">Pl</text:span><text:span text:style-name="T26">. alle</text:span><text:span text:style-name="T21">33</text:span><text:span text:style-name="T18"> </text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">oportet</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>es gehört sich, es ist nötig</text:span><text:span text:style-name="T21">30</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T18">paene</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">Adv</text:span><text:span text:style-name="T26">. <text:s text:c="3"/>fast</text:span><text:span text:style-name="T21">46</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">pars, partis</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">f</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">(Gen. Pl.</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T24">-ium</text:span><text:span text:style-name="T90">)</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>der Teil, die Seite</text:span><text:span text:style-name="T21">22</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T16">pectus, pectoris</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">n</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>die Brust, das Herz</text:span><text:span text:style-name="T21">49</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">perīculum, perīculī</text:span><text:span text:style-name="T18"> </text:span><text:span text:style-name="T90">n</text:span><text:span text:style-name="T18"> <text:s text:c="3"/></text:span><text:span text:style-name="T26">die Gefahr</text:span><text:span text:style-name="T21">24</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T18">perniciēs, perniciēī</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">f</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>das Verderben, die Vernichtung</text:span><text:span text:style-name="T21">41</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T18"><text:soft-page-break/><text:span text:style-name="T24">petere, petō, petīvī, petītum</text:span><text:span text:style-name="T18"> <text:s text:c="3"/></text:span><text:span text:style-name="T26">aufsuchen, (er)streben, bitten, verlangen</text:span><text:span text:style-name="T21">18. 29</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T18">plēbs, plēbis</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">f</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>(nicht adeliges, einfaches) Volk</text:span><text:span text:style-name="T21">36</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T16">praeterīre, praetereō, praeteriī</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>vorbeigehen (an), übergehen</text:span><text:span text:style-name="T21">49</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T18">probāre, probō, probāvī, probātum</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>prüfen, beweisen, für gut befinden</text:span><text:span text:style-name="T21">12</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">quī, quae, quod</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>der, die, das</text:span><text:span text:style-name="T21">34</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T18">quid?</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>was?</text:span><text:span text:style-name="T21">2</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T16">quot?</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>wie viel(e)?</text:span><text:span text:style-name="T21">49</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T16">rapere, rapiō, rapuī, raptum</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>wegführen, rauben, wegreißen</text:span><text:span text:style-name="T21">49</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T21"><text:span text:style-name="T24">reddere, reddō, reddidī, redditum</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>zurückgeben, etw. zukommen lassen; </text:span><text:span text:style-name="T90">m. dopp. Akk.</text:span><text:span text:style-name="T26"> jdn. zu etw. machen</text:span><text:span text:style-name="T21">0</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T21"><text:span text:style-name="T18">rēgnum, rēgnī</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">n</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>die Königsherrschaft</text:span><text:span text:style-name="T21">0</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T18">scelerātus, scelerāta, scelerātum</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>verbrecherisch, schändlich; </text:span><text:span text:style-name="T90">Subst</text:span><text:span text:style-name="T26">. der Verbrecher</text:span><text:span text:style-name="T21">5</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T30">scelus, sceleris</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">n</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>das Verbrechen; der Schurke</text:span><text:span text:style-name="T21">49</text:span><text:span text:style-name="T26"> </text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T18"><text:span text:style-name="T24">scīre, sciō, scīvī, scītum</text:span><text:span text:style-name="T18"> <text:s text:c="3"/></text:span><text:span text:style-name="T26">wissen, kennen, verstehen</text:span><text:span text:style-name="T21">10</text:span><text:span text:style-name="T18"> </text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T18"><text:span text:style-name="T24">sed</text:span><text:span text:style-name="T18"> <text:s text:c="3"/></text:span><text:span text:style-name="T26">aber, sondern</text:span><text:span text:style-name="T21">3</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T18">senātor, senātōris</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">m</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>der Senator</text:span><text:span text:style-name="T21">18</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T18">tē</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">Akk</text:span><text:span text:style-name="T26">. <text:s text:c="3"/>dich</text:span><text:span text:style-name="T21">13</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T30">tempus, temporis</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">n</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>die (günstige) Zeit, die Umstände</text:span><text:span text:style-name="T21">49</text:span><text:span text:style-name="T26"> </text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T18"><text:span text:style-name="T18">terrēre, terreō, terruī, territum <text:s text:c="3"/></text:span><text:span text:style-name="T26">erschrecken</text:span><text:span text:style-name="T21">5</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T21"><text:span text:style-name="T18">Tiberius, Tiberiī </text:span><text:span text:style-name="T90">m</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>Tiberius Gracchus</text:span><text:span text:style-name="T21">0</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T18">tibi</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">Dat</text:span><text:span text:style-name="T26">. <text:s text:c="3"/>dir</text:span><text:span text:style-name="T21">13</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T18"><text:span text:style-name="T24">timēre, timeō, timuī</text:span><text:span text:style-name="T18"> <text:s text:c="3"/></text:span><text:span text:style-name="T26">fürchten, Angst haben</text:span><text:span text:style-name="T21">2</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T18">torquēre, torqueō, torsī, tortum</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>drehen; quälen</text:span><text:span text:style-name="T21">5. 27</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">tōtus, tōta, tōtum</text:span><text:span text:style-name="T18"> </text:span><text:span text:style-name="T90">(Gen.</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T24">tōtīus</text:span><text:span text:style-name="T26">, </text:span><text:span text:style-name="T90">Dat.</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T24">tōtī</text:span><text:span text:style-name="T90">)</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>ganz, gesamt</text:span><text:span text:style-name="T21">40</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">trahere, trahō, trāxī, tractum</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>schleppen, ziehen</text:span><text:span text:style-name="T21">16. 28</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">ūnus, ūna, ūnum</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>einer, ein einziger</text:span><text:span text:style-name="T21">33</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T21"><text:span text:style-name="T24">vidēre, videō, vīdī, vīsum <text:s text:c="2"/></text:span><text:span text:style-name="T26"><text:s/>sehen</text:span><text:span text:style-name="T21">7. 27. 48</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T21"><text:span text:style-name="T24">velle, volō, voluī</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>wollen</text:span><text:span text:style-name="T21">19. 25</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T30">vulnus, vulneris</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">n</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>die Wunde, der (milit.) Verlust</text:span><text:span text:style-name="T21">49</text:span></text:p>
   </text:section>
   <text:section text:style-name="Sect2" text:name="Bereich57">
