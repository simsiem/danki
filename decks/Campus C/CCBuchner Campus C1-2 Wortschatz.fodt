    <text:p text:style-name="P37" loext:marker-style-name="T71"><text:span text:style-name="T80">Creōn, Creontis</text:span><text:span text:style-name="T71"> </text:span><text:span text:style-name="T74">m</text:span><text:span text:style-name="T71"> <text:s text:c="3"/>Kreon (Bruder des Ödipus, Onkel der Antigone und der Ismene)</text:span><text:span text:style-name="T79">61. XXI</text:span></text:p>
