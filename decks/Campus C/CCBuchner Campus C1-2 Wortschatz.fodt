    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T18">Arminius, Arminiī <text:s text:c="3"/></text:span><text:span text:style-name="T26">Arminius (Feldherr der Cherusker, eines germanischen Stammes, der die Römer unter der Führung des Varus im Teutoburger Wald 9 n. Chr. besiegte.)</text:span><text:span text:style-name="T21">68</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T18"><text:span text:style-name="T16">ars, artis</text:span><text:span text:style-name="T18"> </text:span><text:span text:style-name="T90">f (Gen. Pl.</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T18">-ium</text:span><text:span text:style-name="T90">)</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>die Kunst, die Fertigkeit, die Eigenschaft</text:span><text:span text:style-name="T21">68</text:span></text:p>
