    <text:p text:style-name="P37" loext:marker-style-name="T18"><text:span text:style-name="T18">tacēre, taceō, tacuī, tacitum <text:s text:c="3"/></text:span><text:span text:style-name="T26">schweigen, verschweigen</text:span><text:span text:style-name="T21">2</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T18">tālis, tāle <text:s text:c="3"/></text:span><text:span text:style-name="T26">derartig, ein solcher, so (beschaffen)</text:span><text:span text:style-name="T21">52</text:span></text:p>
