    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T174">Diāna, Diānae </text:span><text:span text:style-name="T176">f <text:s text:c="2"/></text:span><text:span text:style-name="T173"><text:s/>Diana (griech. </text:span><text:span text:style-name="T26">Artemis; Göttin der Jagd, des Waldes und des Mondes, Schützerin der Frauen und der Jungfräulichkeit. Zwillingsschwester des Apollo)</text:span><text:span text:style-name="T21">21. 56</text:span></text:p>
