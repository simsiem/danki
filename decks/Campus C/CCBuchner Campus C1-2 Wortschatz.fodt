    <text:p text:style-name="P37" loext:marker-style-name="T18"><text:span text:style-name="T18">cūrāre, cūrō, cūrāvī, cūrātum <text:s text:c="3"/></text:span><text:span text:style-name="T26">pflegen, sorgen für</text:span><text:span text:style-name="T21">24</text:span></text:p>
