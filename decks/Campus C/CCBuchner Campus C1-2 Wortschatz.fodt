    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">facere, faciō, fēcī, </text:span><text:span text:style-name="T180">factum</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>machen, tun, handeln</text:span><text:span text:style-name="T21">17. 27. 48</text:span></text:p>
