    <text:p text:style-name="P37" loext:marker-style-name="T18"><text:span text:style-name="T18">nūntius, nūntiī <text:s text:c="3"/></text:span><text:span text:style-name="T26">der Bote, die Nachricht</text:span><text:span text:style-name="T21">16</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T18">occīdere, occīdō, occīdī, occīsum</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>niederschlagen, töten</text:span><text:span text:style-name="T21">31</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T16">Oedipūs</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>Ödipus (sagenhafter Herrscher von Theben)</text:span><text:span text:style-name="T21">59</text:span></text:p>
