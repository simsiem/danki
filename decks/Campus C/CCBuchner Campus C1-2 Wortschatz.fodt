    <text:p text:style-name="P37" loext:marker-style-name="T167"><text:span text:style-name="T24">itaque </text:span><text:span text:style-name="T168">Adv.</text:span><text:span text:style-name="T18"> <text:s text:c="3"/></text:span><text:span text:style-name="T26">deshalb</text:span><text:span text:style-name="T21">5</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T21"><text:span text:style-name="T18">laetitia, laetitiae </text:span><text:span text:style-name="T90">f</text:span><text:span text:style-name="T18"> <text:s text:c="3"/></text:span><text:span text:style-name="T26">die</text:span><text:span text:style-name="T18"> </text:span><text:span text:style-name="T26">Freude</text:span><text:span text:style-name="T21">7</text:span></text:p>
