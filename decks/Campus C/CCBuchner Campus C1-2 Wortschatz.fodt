    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T179">servīre, serviō</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>dienen, Sklave sein</text:span><text:span text:style-name="T21">47</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T18">servitūs, servitūtis</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">f</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>die Sklaverei</text:span><text:span text:style-name="T21">20</text:span></text:p>
