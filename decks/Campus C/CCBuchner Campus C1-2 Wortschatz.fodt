   <text:section text:style-name="Sect3" text:name="Bereich44">
    <text:p text:style-name="P37" loext:marker-style-name="T18"><text:span text:style-name="T24">ā / ab</text:span><text:span text:style-name="T18"> </text:span><text:span text:style-name="T90">Präp. m. Abl.</text:span><text:span text:style-name="T18"> <text:s text:c="3"/></text:span><text:span text:style-name="T26">von, von ... her</text:span><text:span text:style-name="T21">16</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">amīcus, amici</text:span><text:span text:style-name="T18"> </text:span><text:span text:style-name="T90">m</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>der Freund</text:span><text:span text:style-name="T21">4</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T179">arcessere, arcessō, arcessīvī, </text:span><text:span text:style-name="T16">arcessītum</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>herbeirufen, holen</text:span><text:span text:style-name="T21">35. 47</text:span></text:p>
