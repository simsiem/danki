    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T16">aestimāre, aestimō, aestimāvī, aestimātum</text:span><text:span text:style-name="T18"> <text:s text:c="2"/></text:span><text:span text:style-name="T26"><text:s/>einschätzen, beurteilen; </text:span><text:span text:style-name="T90">m. dopp. Akk</text:span><text:span text:style-name="T26">. halten für</text:span><text:span text:style-name="T21">56</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T175">Apollō, Apollinis</text:span><text:span text:style-name="T173"> </text:span><text:span text:style-name="T176">m</text:span><text:span text:style-name="T173"> <text:s text:c="3"/>Apollo (griech. </text:span><text:span text:style-name="T26">Apollon; Gott des Lichts, der Musik und Künste sowie der Heilkunst und Weissagung)</text:span><text:span text:style-name="T21">X. 56</text:span></text:p>
