   </text:section>
   <text:section text:style-name="Sect3" text:name="Bereich52">
    <text:p text:style-name="P37" loext:marker-style-name="T18"><text:span text:style-name="T24">ā / ab</text:span><text:span text:style-name="T18"> </text:span><text:span text:style-name="T90">Präp. m. Abl.</text:span><text:span text:style-name="T18"> <text:s text:c="3"/></text:span><text:span text:style-name="T26">von, von ... her</text:span><text:span text:style-name="T21">16</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">alius, alia, aliud</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>ein anderer</text:span><text:span text:style-name="T21">29</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">amāre, amō, amāvī, amātum</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>lieben</text:span><text:span text:style-name="T21">8</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T21"><text:span text:style-name="T24">annus, anni</text:span><text:span text:style-name="T18"> </text:span><text:span text:style-name="T90">n</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>das</text:span><text:span text:style-name="T18"> </text:span><text:span text:style-name="T26">Jahr</text:span><text:span text:style-name="T21">22</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">ante</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">Präp. m. Akk.</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>vor</text:span><text:span text:style-name="T21">12</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T18"><text:span text:style-name="T24">autem</text:span><text:span text:style-name="T18"> </text:span><text:span text:style-name="T90">(nachgestellt)</text:span><text:span text:style-name="T18"> <text:s text:c="3"/></text:span><text:span text:style-name="T26">aber, andererseits</text:span><text:span text:style-name="T21">15</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T173"><text:span text:style-name="T190">bēstia, bēstia</text:span><text:span text:style-name="T182"> </text:span><text:span text:style-name="T192">f</text:span><text:span text:style-name="T173"> <text:s text:c="3"/>(wildes) Tier</text:span><text:span text:style-name="T181">21</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T180">capere, capiō, cēpī, captum</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>fassen, nehmen, fangen; erobern</text:span><text:span text:style-name="T21">17. 27. 48</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">cīvis, cīvis</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">m</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">(Gen. Pl.</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T24">-ium</text:span><text:span text:style-name="T90">)</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>der Bürger</text:span><text:span text:style-name="T21">30</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T179">comprehendere, comprehendō, comprehendī, comprehēnsum</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>begreifen, ergreifen, festnehmen</text:span><text:span text:style-name="T21">24. 27. 48</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T174">Corinthus, Corinthī</text:span><text:span text:style-name="T173"> </text:span><text:span text:style-name="T176">f</text:span><text:span text:style-name="T173"> <text:s text:c="3"/>Korinth (reiche griech. </text:span><text:span text:style-name="T26">Handelsstadt am Isthmos)</text:span><text:span text:style-name="T21">39. XVII</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T18">creāre, creō, creāvī, creātum</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>erschaffen, wählen</text:span><text:span text:style-name="T21">18</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T18"><text:span text:style-name="T18">crūdēlis, crūdēle <text:s text:c="3"/></text:span><text:span text:style-name="T26">grausam</text:span><text:span text:style-name="T21">33</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T181"><text:span text:style-name="T182">dēbēre, dēbeō, dēbuī <text:s text:c="2"/></text:span><text:span text:style-name="T173"><text:s/>müssen, sollen</text:span><text:span text:style-name="T181">2</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T18">dēlēre, dēleō, dēlēvī, dēlētum <text:s text:c="3"/></text:span><text:span text:style-name="T26">zerstören, vernichten</text:span><text:span text:style-name="T21">6. 25</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T18">dīves, dīvitis</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>reich</text:span><text:span text:style-name="T21">38</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">dīcere, dīcō, dīxī, dictum <text:s text:c="2"/></text:span><text:span text:style-name="T26"><text:s/>sagen, sprechen</text:span><text:span text:style-name="T21">16. 27</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T21"><text:span text:style-name="T24">dūcere, dūco, dūxī, ductum</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>führen, ziehen</text:span><text:span text:style-name="T21">16. 27. 48</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T18"><text:span text:style-name="T24">esse, sum, fuī</text:span><text:span text:style-name="T18"> <text:s text:c="3"/></text:span><text:span text:style-name="T26">sein, sich befinden</text:span><text:span text:style-name="T21">2. 25</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T24"><text:span text:style-name="T24">et <text:s text:c="3"/></text:span><text:span text:style-name="T26">und, auch</text:span><text:span text:style-name="T21">1</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T21"><text:span text:style-name="T18">forma, formae</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">f</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>Versuche, dir die Bedeutung anhand des modernen Fremdwortes herzuleiten!</text:span><text:span text:style-name="T21">0</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">fortūna, fortūnae</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">f</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>das Schicksal, das Glück</text:span><text:span text:style-name="T21">35</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T18">Graecus, Graeca, Graecum</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>griechisch; </text:span><text:span text:style-name="T90">Subst</text:span><text:span text:style-name="T26">. der Grieche</text:span><text:span text:style-name="T21">18</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T23"><text:span text:style-name="T18">habitāre, habitō, habitāvī, habitātum</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>wohnen, bewohnen</text:span><text:span text:style-name="T21">10</text:span><text:span text:style-name="T23"> </text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">hic, haec, hoc</text:span><text:span text:style-name="T18"> <text:s text:c="3"/></text:span><text:span text:style-name="T26">dieser, diese, dieses (hier); folgender</text:span><text:span text:style-name="T21">40</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T18">honestus, honesta, honestum</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>ehrenhaft, angesehen</text:span><text:span text:style-name="T21">29</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T180">hūc</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">Adv</text:span><text:span text:style-name="T26">. <text:s text:c="3"/>hierher</text:span><text:span text:style-name="T21">47</text:span><text:span text:style-name="T26"> </text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T21"><text:span text:style-name="T18">hūmānitās, hūmānitātis</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">f</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>die Menschlichkeit, die Bildung</text:span><text:span text:style-name="T21">0</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T18"><text:span text:style-name="T24">iam</text:span><text:span text:style-name="T18"> </text:span><text:span text:style-name="T90">Adv.</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>schon, bereits; nun</text:span><text:span text:style-name="T21">4</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">ille, illa, illud</text:span><text:span text:style-name="T18"> <text:s text:c="3"/></text:span><text:span text:style-name="T26">jener, jene, jenes; der (dort); jener berühmte</text:span><text:span text:style-name="T21">40</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T180"><text:span text:style-name="T180">in </text:span><text:span text:style-name="T185">Präp. m. Abl</text:span><text:span text:style-name="T186">. <text:s text:c="3"/>in, an, auf, bei (wo?)</text:span><text:span text:style-name="T187">12</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T188"><text:span text:style-name="T180">in </text:span><text:span text:style-name="T185">Präp. m. Akk</text:span><text:span text:style-name="T186">. <text:s text:c="3"/>in (... hinein), nach (wohin?)</text:span><text:span text:style-name="T187">12</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T180">invenīre, inveniō, invēnī, inventum</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>finden, erfinden</text:span><text:span text:style-name="T21">13. 27. 48</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T18"><text:span text:style-name="T179">īra, īrae</text:span><text:span text:style-name="T18"> </text:span><text:span text:style-name="T90">f</text:span><text:span text:style-name="T18"> <text:s text:c="3"/></text:span><text:span text:style-name="T26">der Zorn, die Wut</text:span><text:span text:style-name="T21">46</text:span><text:span text:style-name="T18"> </text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T18"><text:span text:style-name="T24">is, ea, id</text:span><text:span text:style-name="T18"> <text:s text:c="3"/></text:span><text:span text:style-name="T26">dieser, diese, dieses; er, sie, es</text:span><text:span text:style-name="T21">26</text:span><text:span text:style-name="T18"> </text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T18"><text:span text:style-name="T24">itaque</text:span><text:span text:style-name="T18"> <text:s text:c="3"/></text:span><text:span text:style-name="T26">deshalb</text:span><text:span text:style-name="T21">5</text:span><text:span text:style-name="T18"> </text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T179">laedere, laedō, laesī, laesum</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>beschädigen, verletzen, beleidigen</text:span><text:span text:style-name="T21">48</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T18"><text:span text:style-name="T24">lēx, lēgis</text:span><text:span text:style-name="T18"> </text:span><text:span text:style-name="T90">f</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>das Gesetz, die Bedingung</text:span><text:span text:style-name="T21">36</text:span><text:span text:style-name="T18"> </text:span></text:p>
