    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">interficere, interficiō, interfēcī, interfectum</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>töten, vernichten</text:span><text:span text:style-name="T21">22. 27. 49</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T180">invenīre, inveniō, invēnī, inventum</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>finden, erfinden</text:span><text:span text:style-name="T21">13. 27. 48</text:span></text:p>
