    <text:p text:style-name="P26" loext:marker-style-name="T44"><text:span text:style-name="T53">nis</text:span><text:span text:style-name="T129">ī</text:span><text:span text:style-name="T53"> </text:span><text:span text:style-name="T55">Subj. <text:s text:c="3"/></text:span><text:span text:style-name="T43">wenn nicht</text:span><text:span text:style-name="T44">23</text:span><text:span text:style-name="T40"> </text:span><text:span text:style-name="T43"><text:s/></text:span></text:p>
    <text:p text:style-name="P25" loext:marker-style-name="T40"><text:span text:style-name="T32">n</text:span><text:span text:style-name="T38">ō</text:span><text:span text:style-name="T32">n <text:s text:c="3"/></text:span><text:span text:style-name="T40">nicht</text:span><text:span text:style-name="T37">2</text:span><text:span text:style-name="T40"> </text:span><text:span text:style-name="T43"><text:s/></text:span></text:p>
    <text:p text:style-name="P26" loext:marker-style-name="T43"><text:span text:style-name="T53">petere, pet</text:span><text:span text:style-name="T129">ō</text:span><text:span text:style-name="T53">, pet</text:span><text:span text:style-name="T129">ī</text:span><text:span text:style-name="T53">v</text:span><text:span text:style-name="T129">ī</text:span><text:span text:style-name="T119"> <text:s text:c="3"/></text:span><text:span text:style-name="T43">aufsuchen, (er)streben, bitten, verlangen</text:span><text:span text:style-name="T44">18. 29</text:span></text:p>
    <text:p text:style-name="P25" loext:marker-style-name="T37"><text:span text:style-name="T32">posse, possum, potu</text:span><text:span text:style-name="T38">ī</text:span><text:span text:style-name="T40"> <text:s text:c="3"/>können</text:span><text:span text:style-name="T37">17. 25</text:span><text:span text:style-name="T43"> </text:span></text:p>
    <text:p text:style-name="P25" loext:marker-style-name="T37"><text:span text:style-name="T32">-que</text:span><text:span text:style-name="T33"> </text:span><text:span text:style-name="T39">(angehängt) <text:s text:c="3"/></text:span><text:span text:style-name="T40">und</text:span><text:span text:style-name="T37">14</text:span><text:span text:style-name="T43"> </text:span></text:p>
    <text:p text:style-name="P25" loext:marker-style-name="T40"><text:span text:style-name="T46">R</text:span><text:span text:style-name="T47">ō</text:span><text:span text:style-name="T46">m</text:span><text:span text:style-name="T47">ā</text:span><text:span text:style-name="T46">nus, a, um</text:span><text:span text:style-name="T40"> <text:s text:c="3"/>römisch; </text:span><text:span text:style-name="T39">Subst. </text:span><text:span text:style-name="T40">der Römer, der Einwohner Roms</text:span><text:span text:style-name="T37">9. 14</text:span><text:span text:style-name="T40"> <text:s/></text:span><text:span text:style-name="T43"><text:s/></text:span></text:p>
    <text:p text:style-name="P26" loext:marker-style-name="T43"><text:span text:style-name="T53">s</text:span><text:span text:style-name="T129">ī</text:span><text:span text:style-name="T53"> </text:span><text:span text:style-name="T55">Subj. <text:s text:c="3"/></text:span><text:span text:style-name="T43">wenn, falls</text:span><text:span text:style-name="T44">19</text:span><text:span text:style-name="T43"> </text:span></text:p>
    <text:p text:style-name="P25" loext:marker-style-name="T40"><text:span text:style-name="T46">statim </text:span><text:span text:style-name="T39">Adv. <text:s text:c="3"/></text:span><text:span text:style-name="T40">sofort</text:span><text:span text:style-name="T37">5</text:span><text:span text:style-name="T40"> </text:span></text:p>
    <text:p text:style-name="P26" loext:marker-style-name="T43"><text:span text:style-name="T53">vincere, vinc</text:span><text:span text:style-name="T129">ō</text:span><text:span text:style-name="T53">, v</text:span><text:span text:style-name="T129">ī</text:span><text:span text:style-name="T53">c</text:span><text:span text:style-name="T129">ī</text:span><text:span text:style-name="T119"> <text:s text:c="3"/></text:span><text:span text:style-name="T43">(be)siegen, übertreffen</text:span><text:span text:style-name="T44">27</text:span><text:span text:style-name="T43"> </text:span></text:p>
