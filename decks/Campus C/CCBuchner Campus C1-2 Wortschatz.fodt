    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">pōstulāre, pōstulō, pōstulāvī, pōstulātum</text:span><text:span text:style-name="T18"> <text:s text:c="3"/></text:span><text:span text:style-name="T26">fordern</text:span><text:span text:style-name="T21">45</text:span></text:p>
