    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T180">ipse, ipsa, ipsum</text:span><text:span text:style-name="T26"> (</text:span><text:span text:style-name="T90">Gen</text:span><text:span text:style-name="T26">. </text:span><text:span text:style-name="T180">ipsīus</text:span><text:span text:style-name="T26">, </text:span><text:span text:style-name="T90">Dat</text:span><text:span text:style-name="T26">. </text:span><text:span text:style-name="T180">ipsī</text:span><text:span text:style-name="T26">) <text:s text:c="3"/>(er, sie, es) selbst; persönlich; gerade; sogar </text:span><text:span text:style-name="T90">(hervorhebend)</text:span><text:span text:style-name="T21">56</text:span></text:p>
