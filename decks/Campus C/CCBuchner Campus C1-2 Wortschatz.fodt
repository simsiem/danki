    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">rēs pūblica, reī pūblicae</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">f</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>der Staat</text:span><text:span text:style-name="T21">41</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T171"><text:span text:style-name="T189">rēctē </text:span><text:span text:style-name="T168">Adv</text:span><text:span text:style-name="T171">. <text:s text:c="3"/>richtig, zu Recht</text:span><text:span text:style-name="T170">4</text:span></text:p>
