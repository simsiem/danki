    <text:p text:style-name="P33" loext:marker-style-name="T71"><text:span text:style-name="T84">c</text:span><text:span text:style-name="T85">ō</text:span><text:span text:style-name="T84">nscr</text:span><text:span text:style-name="T85">ī</text:span><text:span text:style-name="T84">bere, c</text:span><text:span text:style-name="T85">ō</text:span><text:span text:style-name="T84">nscr</text:span><text:span text:style-name="T85">ī</text:span><text:span text:style-name="T84">b</text:span><text:span text:style-name="T85">ō</text:span><text:span text:style-name="T84">, c</text:span><text:span text:style-name="T85">ō</text:span><text:span text:style-name="T84">nscr</text:span><text:span text:style-name="T85">ī</text:span><text:span text:style-name="T84">ps</text:span><text:span text:style-name="T85">ī</text:span><text:span text:style-name="T71"> <text:s text:c="3"/>aufschreiben, verfassen</text:span><text:span text:style-name="T75">39</text:span></text:p>
    <text:p text:style-name="P33" loext:marker-style-name="T80"><text:span text:style-name="T73">contendere, contend</text:span><text:span text:style-name="T72">ō</text:span><text:span text:style-name="T73">, contend</text:span><text:span text:style-name="T72">ī</text:span><text:span text:style-name="T71"> <text:s text:c="3"/>sich anstrengen, kämpfen; eilen; behaupten</text:span><text:span text:style-name="T75">34</text:span></text:p>
