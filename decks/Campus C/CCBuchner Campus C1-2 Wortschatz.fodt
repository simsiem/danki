    <text:p text:style-name="P33" loext:marker-style-name="T80"><text:span text:style-name="T73">c</text:span><text:span text:style-name="T72">ū</text:span><text:span text:style-name="T73">r?</text:span><text:span text:style-name="T71"> <text:s text:c="3"/>warum?</text:span><text:span text:style-name="T75">2</text:span></text:p>
