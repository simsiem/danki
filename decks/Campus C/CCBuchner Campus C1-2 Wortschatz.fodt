    <text:p text:style-name="P25" loext:marker-style-name="T43"><text:span text:style-name="T56">campus</text:span><text:span text:style-name="T43"> <text:s text:c="3"/>das Feld, der freie Platz</text:span><text:span text:style-name="T44">1</text:span><text:span text:style-name="T43"> </text:span></text:p>
    <text:p text:style-name="P25" loext:marker-style-name="T43"><text:span text:style-name="T56">certē / certō</text:span><text:span text:style-name="T43"> </text:span><text:span text:style-name="T55">Adv. <text:s text:c="3"/></text:span><text:span text:style-name="T43">gewiss, sicherlich</text:span><text:span text:style-name="T44">29</text:span><text:span text:style-name="T43"> </text:span></text:p>
    <text:p text:style-name="P25" loext:marker-style-name="T44"><text:span text:style-name="T42">cōnficere, cōnficiō, cōnfēcī</text:span><text:span text:style-name="T43"> <text:s text:c="3"/>fertig machen, beenden</text:span><text:span text:style-name="T44">44</text:span></text:p>
    <text:p text:style-name="P25" loext:marker-style-name="T43"><text:span text:style-name="T56">cōnfirmāre, cōnfirmō</text:span><text:span text:style-name="T43"> <text:s text:c="3"/>bekräftigen, ermutigen, stärken</text:span><text:span text:style-name="T44">37</text:span></text:p>
    <text:p text:style-name="P25" loext:marker-style-name="T44"><text:span text:style-name="T53">cōnsistere, cōnsistō, cōnstitī</text:span><text:span text:style-name="T119"> <text:s text:c="3"/></text:span><text:span text:style-name="T43">stehenbleiben, haltmachen, sich aufstellen</text:span><text:span text:style-name="T44">17. 29</text:span></text:p>
    <text:p text:style-name="P25" loext:marker-style-name="T43"><text:span text:style-name="T56">cōnspicere, cōnspiciō, cōnspexī <text:s text:c="3"/></text:span><text:span text:style-name="T43">erblicken</text:span><text:span text:style-name="T44">38</text:span><text:span text:style-name="T43"> </text:span></text:p>
    <text:p text:style-name="P25" loext:marker-style-name="T43"><text:span text:style-name="T53">cum </text:span><text:span text:style-name="T55">Präp. m. Abl. <text:s text:c="3"/></text:span><text:span text:style-name="T43">mit, zusammen mit</text:span><text:span text:style-name="T44">12</text:span><text:span text:style-name="T43"> </text:span></text:p>
    <text:p text:style-name="P25" loext:marker-style-name="T43"><text:span text:style-name="T53">cūra </text:span><text:span text:style-name="T43"><text:s text:c="3"/>die Pflege, die Sorge</text:span><text:span text:style-name="T44">36</text:span><text:span text:style-name="T43"> <text:s/></text:span></text:p>
    <text:p text:style-name="P25" loext:marker-style-name="T44"><text:span text:style-name="T42">currere, currō, cucurrī</text:span><text:span text:style-name="T43"> <text:s text:c="3"/>laufen, eilen</text:span><text:span text:style-name="T44">44</text:span></text:p>
    <text:p text:style-name="P26" loext:marker-style-name="T43"><text:span text:style-name="T53">deus</text:span><text:span text:style-name="T43"> <text:s text:c="3"/>der Gott, die Gottheit</text:span><text:span text:style-name="T44">6</text:span><text:span text:style-name="T43"> <text:s/></text:span></text:p>
    <text:p text:style-name="P25" loext:marker-style-name="T44"><text:span text:style-name="T53">duo, duae, duo</text:span><text:span text:style-name="T119"> <text:s text:c="3"/></text:span><text:span text:style-name="T43">zwei, beide</text:span><text:span text:style-name="T44">16</text:span></text:p>
    <text:p text:style-name="P25" loext:marker-style-name="T43"><text:span text:style-name="T53">ē / ex</text:span><text:span text:style-name="T119"> </text:span><text:span text:style-name="T55">Präp. m. Abl. <text:s text:c="3"/></text:span><text:span text:style-name="T43">aus, von ... her</text:span><text:span text:style-name="T44">12</text:span><text:span text:style-name="T43"> </text:span></text:p>
