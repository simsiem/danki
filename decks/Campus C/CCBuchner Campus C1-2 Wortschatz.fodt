   </text:section>
   <text:section text:style-name="Sect3" text:name="Bereich78">
    <text:p text:style-name="P37" loext:marker-style-name="T173"><text:span text:style-name="T24">ā / ab</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">Präp. m. Abl</text:span><text:span text:style-name="T26">. <text:s text:c="3"/></text:span><text:span text:style-name="T173">von, von ... her</text:span><text:span text:style-name="T181">16</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">accipere, accipiō, accēpī</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>erhalten, erfahren, annehmen</text:span><text:span text:style-name="T21">34</text:span></text:p>
