    <text:p text:style-name="P37" loext:marker-style-name="T18"><text:span text:style-name="T24">audīre, audiō, audīvī, audītum</text:span><text:span text:style-name="T18"> <text:s text:c="3"/></text:span><text:span text:style-name="T26">hören</text:span><text:span text:style-name="T21">10</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T71"><text:span text:style-name="T96">auris, auris</text:span><text:span text:style-name="T71"> </text:span><text:span text:style-name="T74">f</text:span><text:span text:style-name="T71"> (</text:span><text:span text:style-name="T74">Gen. Pl.</text:span><text:span text:style-name="T71"> -</text:span><text:span text:style-name="T80">ium</text:span><text:span text:style-name="T71">) <text:s text:c="3"/>das Ohr</text:span><text:span text:style-name="T79">60</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">bene</text:span><text:span text:style-name="T18"> </text:span><text:span text:style-name="T90">Adv.</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>gut</text:span><text:span text:style-name="T21">4</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T71"><text:span text:style-name="T80">calamitās, calamitātis</text:span><text:span text:style-name="T71"> </text:span><text:span text:style-name="T74">f</text:span><text:span text:style-name="T71"> <text:s text:c="3"/>der Schaden, das Unglück</text:span><text:span text:style-name="T79">54</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T180">causa, causae</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">f</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>die Sache, die Ursache, der Grund; der Prozess</text:span><text:span text:style-name="T21">53</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T71"><text:span text:style-name="T93">civis, civis</text:span><text:span text:style-name="T71"> </text:span><text:span text:style-name="T74">m</text:span><text:span text:style-name="T71"> (</text:span><text:span text:style-name="T74">Gen. Pl</text:span><text:span text:style-name="T71">. </text:span><text:span text:style-name="T93">-ium</text:span><text:span text:style-name="T71">) <text:s text:c="3"/>der Bürger, die Bürgerin</text:span><text:span text:style-name="T79">30</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T71"><text:span text:style-name="T96">comperīre, comperiō, comperī, compertum</text:span><text:span text:style-name="T71"> <text:s text:c="3"/>(genau) erfahren</text:span><text:span text:style-name="T79">60</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T179">condiciō, condiciōnis</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">f</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>die Bedingung, die Lage</text:span><text:span text:style-name="T21">57</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">dēbēre, dēbeō, dēbuī</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>müssen, sollen, schulden</text:span><text:span text:style-name="T21">2</text:span></text:p>
