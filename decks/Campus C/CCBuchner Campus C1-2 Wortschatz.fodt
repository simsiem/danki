    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T30">orbis, orbis</text:span><text:span text:style-name="T18"> </text:span><text:span text:style-name="T90">m</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>der Kreis(lauf); der Erdkreis, die Welt</text:span><text:span text:style-name="T21">66</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T16">orbis terrārum</text:span><text:span text:style-name="T18"> <text:s text:c="3"/></text:span><text:span text:style-name="T26">die Welt, der Erdkreis</text:span><text:span text:style-name="T21">66</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">pāx, pācis</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">f</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>der Frieden</text:span><text:span text:style-name="T21">40</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">per</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">Präp. m. Akk</text:span><text:span text:style-name="T26">. <text:s text:c="3"/>durch, hindurch</text:span><text:span text:style-name="T21">16</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T71"><text:span text:style-name="T232">pervenīre, perveniō, perv</text:span><text:span text:style-name="T208">ē</text:span><text:span text:style-name="T232">nī, perventum</text:span><text:span text:style-name="T215"> ad / in </text:span><text:span text:style-name="T217">m. Akk</text:span><text:span text:style-name="T215">. <text:s text:c="3"/></text:span><text:span text:style-name="T71">kommen zu / nach</text:span><text:span text:style-name="T79">60</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T18"><text:span text:style-name="T18">placet </text:span><text:span text:style-name="T90">m. Dat. <text:s text:c="2"/></text:span><text:span text:style-name="T26"><text:s/>es gefällt jdm., jd. beschließt</text:span><text:span text:style-name="T21">63</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T18">portāre, portō, portāvī, portātum</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>bringen, tragen</text:span><text:span text:style-name="T21">8</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T179">prōvidēre, prōvideō, prōvīdī, prōvīsum</text:span><text:span text:style-name="T26"> <text:s text:c="3"/></text:span><text:span text:style-name="T90">m. Akk</text:span><text:span text:style-name="T26">. vorhersehen; </text:span><text:span text:style-name="T90">m. Dat.</text:span><text:span text:style-name="T26"> sorgen für</text:span><text:span text:style-name="T21">53</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T173"><text:span text:style-name="T182">prōvincia, prōvinciae</text:span><text:span text:style-name="T173"> </text:span><text:span text:style-name="T176">f</text:span><text:span text:style-name="T173"> <text:s text:c="3"/>die Provinz</text:span><text:span text:style-name="T181">9</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T16">quārē?</text:span><text:span text:style-name="T18"> <text:s text:c="3"/></text:span><text:span text:style-name="T26">weshalb? wodurch?</text:span><text:span text:style-name="T21">66</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">quī, quae, quod</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>der, die, das</text:span><text:span text:style-name="T21">34</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T16">quidnam?</text:span><text:span text:style-name="T18"> <text:s text:c="3"/></text:span><text:span text:style-name="T26">was denn?</text:span><text:span text:style-name="T21">66</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T18">rapere, rapiō, rapuī, raptum</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>wegführen, rauben, wegreißen</text:span><text:span text:style-name="T21">49</text:span><text:span text:style-name="T26"> </text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">rēs, reī</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">f</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>die Angelegenheit, das Ding, die Sache</text:span><text:span text:style-name="T21">41</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T18">Rōmānus, Rōmāna, Rōmānum</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>römisch; Subst. Römer, Einwohner Roms</text:span><text:span text:style-name="T21">9. 14</text:span><text:span text:style-name="T26"> </text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T18"><text:span text:style-name="T16">saeculum, saeculī</text:span><text:span text:style-name="T18"> </text:span><text:span text:style-name="T90">n</text:span><text:span text:style-name="T18"> <text:s text:c="3"/></text:span><text:span text:style-name="T26">das Jahrhundert, das Menschenalter, die Zeit, das Zeitalter</text:span><text:span text:style-name="T21">66</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">salūs, salūtis</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">f</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>die Gesundheit, die Rettung, der Gruß, das Glück</text:span><text:span text:style-name="T21">25</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T18">s</text:span><text:span text:style-name="T179">ē</text:span><text:span text:style-name="T18"> </text:span><text:span text:style-name="T90">Akk. / Abl.</text:span><text:span text:style-name="T18"> <text:s text:c="3"/></text:span><text:span text:style-name="T26">sich</text:span><text:span text:style-name="T21">19</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">sine</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">Präp. m. Abl</text:span><text:span text:style-name="T26">. <text:s text:c="3"/>ohne</text:span><text:span text:style-name="T21">12</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T18">singulus, singula, singulum <text:s text:c="3"/></text:span><text:span text:style-name="T26">je ein, jeder einzelne</text:span><text:span text:style-name="T21">45</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">suus, sua, suum</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>sein, ihr</text:span><text:span text:style-name="T21">30</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T180">superī, superōrum</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">m Pl</text:span><text:span text:style-name="T26">. <text:s text:c="3"/>die Götter</text:span><text:span text:style-name="T21">56</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">tantum</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">Adv. (nachgestellt)</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>nur</text:span><text:span text:style-name="T21">5</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T18"><text:span text:style-name="T24">terra, terrae</text:span><text:span text:style-name="T18"> </text:span><text:span text:style-name="T90">f</text:span><text:span text:style-name="T18"> <text:s text:c="3"/></text:span><text:span text:style-name="T26">die Erde, das Land</text:span><text:span text:style-name="T21">21</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">tōtus, tōta, tōtum</text:span><text:span text:style-name="T18"> </text:span><text:span text:style-name="T90">(Gen.</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T24">tōtīus</text:span><text:span text:style-name="T26">, </text:span><text:span text:style-name="T90">Dat.</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T24">tōtī</text:span><text:span text:style-name="T90">)</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>ganz, gesamt</text:span><text:span text:style-name="T21">40</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">tuus,tua, tuum</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>dein</text:span><text:span text:style-name="T21">14</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">unde?</text:span><text:span text:style-name="T18"> <text:s text:c="3"/></text:span><text:span text:style-name="T26">woher?</text:span><text:span text:style-name="T21">10</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T21"><text:span text:style-name="T16">usque </text:span><text:span text:style-name="T206">Adv</text:span><text:span text:style-name="T195">. <text:s text:c="3"/>ohne Unterbrechung</text:span><text:span text:style-name="T26">; </text:span><text:span text:style-name="T18">ad</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">m. Akk</text:span><text:span text:style-name="T26">. bis (zu)</text:span><text:span text:style-name="T21">44. 66</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">ut</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">Adv</text:span><text:span text:style-name="T26">. <text:s text:c="3"/>wie</text:span><text:span text:style-name="T21">10</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T180">ut</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">Subj. m. Konj</text:span><text:span text:style-name="T26">. <text:s text:c="3"/>dass, sodass; </text:span><text:span text:style-name="T234">damit, um zu </text:span><text:span text:style-name="T233">m. Inf</text:span><text:span text:style-name="T234">.</text:span><text:span text:style-name="T21">45. 59</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T16">utrum ... an</text:span><text:span text:style-name="T18"> </text:span><text:span text:style-name="T90">(Wahlfrage im Hauptsatz)</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>...oder</text:span><text:span text:style-name="T21">66</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T18"><text:span text:style-name="T24">venīre, veniō, vēnī, ventum</text:span><text:span text:style-name="T18"> <text:s text:c="3"/></text:span><text:span text:style-name="T26">kommen</text:span><text:span text:style-name="T21">10. 27</text:span><text:span text:style-name="T167"> </text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T18"><text:span text:style-name="T24">vērus, vēra, vērum</text:span><text:span text:style-name="T18"> <text:s text:c="3"/></text:span><text:span text:style-name="T26">echt, richtig, wahr</text:span><text:span text:style-name="T21">59</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">verbum, verbī</text:span><text:span text:style-name="T18"> </text:span><text:span text:style-name="T90">n</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>das Wort, die Äußerung</text:span><text:span text:style-name="T21">11</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T18">vester, vestra, vestrum <text:s text:c="3"/></text:span><text:span text:style-name="T26">euer</text:span><text:span text:style-name="T21">15</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T71"><text:span text:style-name="T24">vīvere, vīvō, vīxī</text:span><text:span text:style-name="T71"> <text:s text:c="3"/>leben</text:span><text:span text:style-name="T79">30</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T18"><text:span text:style-name="T24">vōs</text:span><text:span text:style-name="T18"> </text:span><text:span text:style-name="T90">Nom. / Akk.</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>ihr / euch</text:span><text:span text:style-name="T21">13</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T21"><text:span text:style-name="T24">velle, volō, voluī</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>wollen</text:span><text:span text:style-name="T21">19. 25</text:span></text:p>
   </text:section>
   <text:section text:style-name="Sect2" text:name="Bereich137">
