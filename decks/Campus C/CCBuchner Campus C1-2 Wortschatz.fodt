    <text:p text:style-name="P25" loext:marker-style-name="T44"><text:span text:style-name="T53">autem </text:span><text:span text:style-name="T55">(nachgestellt) <text:s text:c="3"/></text:span><text:span text:style-name="T43">aber, andererseits</text:span><text:span text:style-name="T44">15</text:span><text:span text:style-name="T43"> </text:span></text:p>
