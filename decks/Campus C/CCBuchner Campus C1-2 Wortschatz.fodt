    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">nox, noctis</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">f</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">(Gen. Pl.</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T24">-ium</text:span><text:span text:style-name="T90">)</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>die Nacht</text:span><text:span text:style-name="T21">25</text:span></text:p>
