    <text:p text:style-name="P37" loext:marker-style-name="T18"><text:span text:style-name="T24">autem</text:span><text:span text:style-name="T18"> </text:span><text:span text:style-name="T90">(nachgestellt)</text:span><text:span text:style-name="T18"> <text:s text:c="3"/></text:span><text:span text:style-name="T26">aber, andererseits</text:span><text:span text:style-name="T21">15</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T79"><text:span text:style-name="T80">caecus, caeca, caecum</text:span><text:span text:style-name="T71"> <text:s text:c="3"/>blind</text:span><text:span text:style-name="T79">0</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T180">capere, capiō, cēpī, captum</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>fassen, nehmen, fangen; erobern</text:span><text:span text:style-name="T21">17. 27. 48</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T71"><text:span text:style-name="T222">comperīre, comperiō, comperī, compertum</text:span><text:span text:style-name="T71"> <text:s text:c="3"/>(genau) erfahren</text:span><text:span text:style-name="T79">60</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T179">convertere, convertō, convertī, conversum</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>verändern, (um)wenden</text:span><text:span text:style-name="T21">59</text:span></text:p>
