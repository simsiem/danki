    <text:p text:style-name="P37" loext:marker-style-name="T26"><text:span text:style-name="T24">verbum, verbī</text:span><text:span text:style-name="T18"> </text:span><text:span text:style-name="T90">n</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>das Wort, die Äußerung</text:span><text:span text:style-name="T21">11</text:span></text:p>
    <text:p text:style-name="P37" loext:marker-style-name="T21"><text:span text:style-name="T26">(G. Cornēlius) </text:span><text:span text:style-name="T18">Verrēs, Verris</text:span><text:span text:style-name="T26"> </text:span><text:span text:style-name="T90">m</text:span><text:span text:style-name="T26"> <text:s text:c="3"/>Verres (römischer Politiker und Statthalter der Provinz Sizilien (um 115 v. Chr. – 43 v. Chr.); erlangte Berühmtheit durch die Anklage der Sizilianer, vertreten durch den jungen Cicero, gegen ihn wegen Erpressung 70 v. Chr.)</text:span><text:span text:style-name="T21">50</text:span></text:p>
