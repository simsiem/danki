    <text:sequence-decl text:display-outline-level="0" text:name="Figure"/>
   </text:sequence-decls>
   <text:p text:style-name="P1" loext:marker-style-name="T1"><text:span text:style-name="T1">LEKTION 38. E, Seite 14 <text:s text:c="2"/></text:span></text:p>
   <text:p text:style-name="P2" loext:marker-style-name="T2"><text:span text:style-name="T3">Alexander, Alexandr</text:span><text:span text:style-name="T4">ī</text:span><text:span text:style-name="T5"> <text:s text:c="2"/></text:span><text:span text:style-name="T6"><text:s/>Alexander der Große </text:span><text:span text:style-name="T7">(König von Makedonien)</text:span><text:span text:style-name="T8">38</text:span></text:p>
