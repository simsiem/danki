{
    "chat.tools.terminal.autoApprove": {
        "/^hatch test(?:\\s+tests\\/(?:[A-Za-z0-9_-]+\\/)*[A-Za-z0-9_-]+\\.py)*$/": {
            "approve": true,
            "matchCommandLine": true
        },
        "/^hatch check(?: --fix)?$/": {
            "approve": true,
            "matchCommandLine": true
        },
        "/^hatch fmt$/": {
            "approve": true,
            "matchCommandLine": true
        },
        "git rev-parse": true,
        "/^hatch run dev:check$/": {
            "approve": true,
            "matchCommandLine": true
        }
    }
}